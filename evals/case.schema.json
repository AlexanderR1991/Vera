{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexanderR1991/Vera/blob/main/evals/case.schema.json",
  "title": "P-02 synthetic case input, excluding reference answers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "split", "status", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "split": {"enum": ["dev", "holdout"]},
    "status": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domain", "synthetic", "task", "sources", "followup_type", "followup"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,39}$"},
          "domain": {"enum": ["accessibility_notices", "technical_drawing_revisions"]},
          "synthetic": {"const": true},
          "task": {"type": "string", "minLength": 1, "maxLength": 4000},
          "sources": {
            "type": "array", "minItems": 1, "maxItems": 12,
            "items": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"type": "string", "pattern": "^S[1-9][0-9]?$"}, "text": {"type": "string", "minLength": 1, "maxLength": 6000}}}
          },
          "followup_type": {"enum": ["correction", "unsupported_objection", "refusal", "continued_support"]},
          "followup": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
