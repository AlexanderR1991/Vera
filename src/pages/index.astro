---
import Layout from "../layouts/SiteLayout.astro";
import {pathFor} from "../lib/paths.mjs";
import project from "../../public/project.json" with {type: "json"};
---
<Layout lang="de" root={true}>
  <section class="locale-landing" aria-labelledby="welcome-title">
    <div class="narrow">
      <p class="section-kicker">{project.subtitle.de} · <span lang="en">{project.subtitle.en}</span></p>
      <h1 id="welcome-title">{project.name} <span aria-hidden="true">/</span> <em lang="en">{project.english_name}</em></h1>
      <p>Welche Frage beschäftigt dich? Untersuche sie selbst oder bring sie in die Werkstatt.</p>
      <p lang="en">What’s on your mind? Work through a question on your own or bring it to the workshop.</p>
      <nav class="locale-landing__links" aria-label="Sprache wählen / Choose a language">
        <a href={pathFor("de")} lang="de" hreflang="de">Deutsch <span>Zur Werkstatt · Originalfassung →</span></a>
        <a href={pathFor("en")} lang="en" hreflang="en">English <span>Enter the workshop · Translation draft →</span></a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .locale-landing h1 { font-size: clamp(2.65rem, 7vw, 5.5rem); }
  .locale-landing h1 span { color: var(--gold); font-size: .65em; }
  .locale-landing__links { margin-bottom: 0; }
</style>
