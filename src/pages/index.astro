---
import Layout from "../layouts/SiteLayout.astro";
import {pathFor} from "../lib/paths.mjs";
import copy from "../lib/mission-copy.json";
import project from "../../public/project.json" with {type: "json"};
---
<Layout lang="de" root={true} pageTitle="Vera kennenlernen / Meet Vera" description={copy.de.metaDescription}>
  <section class="locale-landing" aria-labelledby="welcome-title">
    <div class="narrow">
      <p class="section-kicker">{project.subtitle.de} · <span lang="en">{project.subtitle.en}</span></p>
      <h1 id="welcome-title">{copy.de.headline} <em>{copy.de.headlineAccent}</em><span lang="en">{copy.en.headline} {copy.en.headlineAccent}</span></h1>
      <p class="locale-landing__invitation">{copy.de.lead}<span lang="en">{copy.en.lead}</span></p>
      <nav class="locale-landing__links" aria-label="Sprache wählen / Choose a language">
        <a href={pathFor("de")} lang="de" hreflang="de">Deutsch <span>{copy.de.howTitle} →</span></a>
        <a href={pathFor("en")} lang="en" hreflang="en">English <span>{copy.en.howTitle} →</span></a>
      </nav>
      <nav class="locale-landing__questions" aria-label="Alltagsfragen / Everyday questions">
        <a href={pathFor("de", "forum", "alltagsfragen")} lang="de" hreflang="de">Alltagsfragen auf Deutsch <span aria-hidden="true">→</span></a>
        <a href={pathFor("en", "forum", "alltagsfragen")} lang="en" hreflang="en">Everyday questions in English <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .locale-landing h1 { font-size: clamp(3rem, 7vw, 5.5rem); line-height: 1.12; }
  .locale-landing h1 em { color: var(--gold-bright); font-weight: 400; }
  .locale-landing h1 span { display: block; margin-top: .6rem; color: var(--gold); font: clamp(1.45rem, 3vw, 2.2rem)/1.3 var(--serif); letter-spacing: -.02em; }
  .locale-landing__invitation { margin: 0 0 1.7rem; color: var(--gold-bright); font: clamp(1.25rem, 2.5vw, 1.7rem)/1.4 var(--serif); }
  .locale-landing__invitation span { display: block; margin-top: .25rem; color: var(--text-soft); font-size: .7em; }
  .locale-landing__links { margin-bottom: 0; }
  .locale-landing__questions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.4rem; margin-top: 1rem; }
  .locale-landing__questions a { display: inline-flex; align-items: center; gap: .4em; min-height: 44px; color: var(--gold-bright); text-decoration: underline; text-underline-offset: .2em; }
</style>
