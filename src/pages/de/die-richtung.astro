---
import Layout from "../../layouts/SiteLayout.astro";
import {base} from "../../lib/paths.mjs";
import {readFile} from "node:fs/promises";
const book = await readFile(new URL("../../../public/books/die-richtung-2.0-lesefassung.txt", import.meta.url), "utf8");
const pages = book.split(/(?=^======== BUCHSEITE \d+ \/ 196 ========)/m);
---
<Layout lang="de" slug="die-richtung">
  <section class="book-intro"><div class="container">
    <p class="section-kicker">UNSER URSPRUNG · OFFENE LESEFASSUNG</p>
    <h1>Die <em>Richtung.</em></h1>
    <p class="book-subtitle">Ein korrigierbarer Weg zu Wahrheit, Freiheit und gelebtem Sein</p>
    <p>Von Alexander Radke · Ausgabe 2.0 (September 2026) · entstanden im Dialog mit ChatGPT.</p>
    <p>Aus der Arbeit an diesem Buch entstand WIRKLICH. Das Buch ist ein philosophischer Ausgangspunkt, kein Nachweis für die Richtigkeit der Projektthesen. Es darf kritisiert, korrigiert und durch bessere Erkenntnis überholt werden.</p>
    <div class="book-actions"><a class="button button--gold" href={base+"books/die-richtung-2.0-lesefassung.txt"} download>Vollständige Textfassung herunterladen ↗</a><a class="button button--ghost" href="#lesen">Online lesen ↓</a></div>
    <p class="book-notice"><strong>Hinweis zur Ausgabe:</strong> Diese frei zugängliche Lesefassung ist eine Textextraktion aus der vom Autor bereitgestellten 196-seitigen PDF. Sie enthält die Kapitel, Kunstinterpretationen, Modellbeschreibungen und Bildnachweise als Text, <strong>nicht</strong> jedoch die reproduzierten Gemälde und grafischen Modelltafeln. Die original gestaltete Kunst- und Modell-PDF ist hier noch nicht bereitgestellt. Umbrüche und Seitennummern können von der Druckausgabe abweichen.</p>
    <p class="book-license">Eigene Buchtexte: <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener noreferrer">CC BY-SA 4.0</a>, soweit die jeweiligen Rechte vorliegen. Fremde Kunstwerke und Drittmaterial bleiben unter ihren eigenen Nutzungsbedingungen. <a href="https://github.com/AlexanderR1991/Wirklich/blob/main/LICENSING.md">Lizenzdetails ↗</a></p>
  </div></section>
  <article class="book-body container" id="lesen" aria-label="Buchtext Die Richtung">
    {pages.map((page,i)=><section class="book-page" aria-label={`Buchabschnitt ${i+1}`}><pre>{page.trim()}</pre></section>)}
  </article>
</Layout>
<style>
.book-intro{padding:clamp(40px,7vw,96px) 0 42px;background:var(--surface,#101214)}
.book-intro .container{max-width:1000px}
.book-intro h1{font-size:clamp(45px,8vw,96px);margin:14px 0}
.book-intro p{max-width:820px;line-height:1.75}
.book-subtitle{font-size:clamp(18px,2.4vw,26px)}
.book-actions{display:flex;flex-wrap:wrap;gap:14px;margin:26px 0}
.book-notice,.book-license{font-size:14px;border-left:2px solid var(--gold);padding-left:18px}
.book-body{max-width:900px;padding-block:35px 90px}
.book-page{padding:25px 24px;border-bottom:1px solid var(--line)}
.book-page pre{font-family:Georgia,"Times New Roman",serif;font-size:clamp(15px,1.5vw,19px);line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}
.book-license a{color:var(--gold-bright)}
@media(max-width:680px){.book-page{padding:22px 0}}
</style>
