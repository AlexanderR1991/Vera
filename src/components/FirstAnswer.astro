---
import everyday from "../../public/knowledge/everyday-questions.json";
import { pathFor } from "../lib/paths.mjs";

const { lang = "de" } = Astro.props;
const t = (de, en) => lang === "en" ? en : de;
const example = everyday.questions.find(entry => entry.id === "entscheidung")!;
---
<div class="first-answer" id={t("frag-mich", "ask-me")} data-first-answer data-lang={lang}
  data-choices={t("Welche dieser Fragen kommt deiner näher?", "Which question is closer to yours?")}
  data-unknown={t("Dazu habe ich noch keine passende Antwort.", "I don’t have a matching answer for that yet.")}
  data-retry={t("Du kannst deine Frage anders formulieren oder sie hier stehenlassen.", "You can rephrase your question or leave it here.")}
  data-empty={t("Schreib zuerst deine Frage ins Feld.", "Type your question first.")}>
  <form hidden autocomplete="off">
    <label for="first-question">{t("Frag mich etwas", "Ask me something")}</label>
    <div class="first-answer__row">
      <input id="first-question" type="text" maxlength="500" required spellcheck="false"
        aria-describedby="first-question-hint"
        placeholder={t("Die hört mir sowieso nie zu.", "She never listens to me anyway.")} />
      <button type="submit">{t("Fragen", "Ask")}</button>
    </div>
    <p id="first-question-hint">{t("Ich suche in meinen veröffentlichten Antworten. Deine Frage bleibt in deinem Browser.", "I search my published answers. Your question stays in your browser.")}</p>
  </form>
  <div class="first-answer__result" data-first-result hidden>
    <h2 tabindex="-1"></h2>
    <p data-answer></p>
    <p class="first-answer__follow" data-follow></p>
    <a data-source><span data-source-label>{t("Fundstelle lesen", "Read the source")}</span> <span aria-hidden="true">↗</span></a>
    <ul data-choices-list></ul>
  </div>
  <a class="first-answer__example" href={pathFor(lang, "schnittmengen", "zuhoeren")}>
    {t("Ich fühle mich überhört. Wie fange ich an?", "I feel unheard. How could I start?")} <span aria-hidden="true">→</span>
  </a>
  <a class="first-answer__example" data-first-example={example.question[lang]}
    href={pathFor(lang, "forum", "alltag-" + example.id)}>
    {t("Zum Beispiel", "Try this")} · {example.question[lang]} <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  import { firstAnswer } from "../lib/first-answer.mjs";

  for (const box of document.querySelectorAll<HTMLElement>("[data-first-answer]")) {
    const form = box.querySelector("form")!;
    const input = form.querySelector("input")!;
    const example = box.querySelector<HTMLAnchorElement>("[data-first-example]")!;
    const result = box.querySelector<HTMLElement>("[data-first-result]")!;
    const heading = result.querySelector("h2")!;
    const answer = result.querySelector<HTMLElement>("[data-answer]")!;
    const follow = result.querySelector<HTMLElement>("[data-follow]")!;
    const source = result.querySelector<HTMLAnchorElement>("[data-source]")!;
    const sourceLabel = source.querySelector("[data-source-label]")!;
    const defaultLabel = sourceLabel.textContent;
    const choices = result.querySelector<HTMLElement>("[data-choices-list]")!;

    function show(question: string) {
      const reply = firstAnswer(question, box.dataset.lang);
      if (reply.kind === "empty") {
        input.setCustomValidity(box.dataset.empty ?? "");
        input.reportValidity();
        return;
      }
      const matched = reply.kind === "answer";
      heading.textContent = matched ? reply.question : reply.kind === "choices" ? box.dataset.choices! : box.dataset.unknown!;
      answer.textContent = matched ? reply.answer : reply.kind === "unknown" ? box.dataset.retry! : "";
      answer.hidden = !answer.textContent;
      follow.textContent = matched ? reply.followUp : "";
      follow.hidden = !follow.textContent;
      source.hidden = !matched;
      if (matched) {
        source.href = reply.href;
        sourceLabel.textContent = reply.action ?? defaultLabel;
      }
      choices.replaceChildren();
      choices.hidden = reply.kind !== "choices";
      if (reply.kind === "choices") {
        for (const choice of reply.choices) {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = choice.href;
          link.textContent = choice.question;
          askHere(link, choice.question);
          item.append(link);
          choices.append(item);
        }
      }
      result.hidden = false;
      heading.focus();
    }

    function askHere(link: HTMLAnchorElement, question: string) {
      link.addEventListener("click", event => {
        if (event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
        event.preventDefault();
        input.setCustomValidity("");
        input.value = question;
        show(question);
      });
    }

    input.addEventListener("input", () => {
      input.setCustomValidity("");
      result.hidden = true;
    });
    form.addEventListener("submit", event => {
      event.preventDefault();
      show(input.value);
    });
    askHere(example, example.dataset.firstExample!);
    form.hidden = false;
  }
</script>

<style>
  .first-answer { max-width: 35rem; margin: 1.5rem auto 0; text-align: left; }
  .first-answer [hidden] { display: none; }
  label { display: block; margin-bottom: .35rem; font-size: 1.05rem; font-weight: 700; }
  .first-answer__row { display: flex; gap: .45rem; }
  input, button { min-height: 48px; padding: .6rem .85rem; border: 1px solid var(--muted); border-radius: 0; font: inherit; }
  input { flex: 1; min-width: 0; background: var(--vera-panel); color: var(--text); }
  input::placeholder { color: var(--text-soft); }
  button { font-weight: 700; cursor: pointer; background: var(--vera-paper); color: var(--vera-ink); }
  button:hover { background: #fff; }
  #first-question-hint { margin: .45rem 0 0; font-size: .875rem; line-height: 1.45; }
  .first-answer__example, .first-answer__result :global(a) { color: var(--text); text-decoration: underline; text-underline-offset: .2em; }
  .first-answer__example { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; font-size: .875rem; }
  .first-answer__result { margin-top: 1rem; padding: 1rem 1.15rem; border-inline-start: 2px solid var(--signal); background: var(--vera-panel); overflow-wrap: anywhere; }
  .first-answer__result h2 { margin: 0; font-size: 1.25rem; line-height: 1.3; }
  .first-answer__result p { margin: .5rem 0; color: var(--text); }
  .first-answer__follow { font-weight: 600; }
  .first-answer__result ul { margin: .5rem 0 0; padding-inline-start: 1.1rem; }
</style>
