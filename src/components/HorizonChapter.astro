---
import Layout from "../layouts/SiteLayout.astro";
import Diagram from "./HorizonDiagram.astro";
import copy from "../lib/horizon-copy.json";
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const t=copy[lang];
const discussion="https://github.com/AlexanderR1991/Wirklich/discussions";
---
<Layout lang={lang} slug="erkenntnishorizont">
<section class="horizon-hero">
<div class="container horizon-hero__grid">
<div>
<p class="section-kicker">{t.eyebrow}</p>
<h1>{t.h1a}<br/><em>{t.h1b}</em></h1>
<p class="horizon-lead">{t.lead}</p>
<div class="horizon-badges"><span>{t.badge0}</span><span>{t.badge1}</span><span>{t.badge2}</span></div>
</div><div class="horizon-hero__sigil" aria-hidden="true"><span>M</span><i></i></div>
</div></section>
<section class="section section--paper horizon-model" aria-labelledby="horizon-model-title">
<div class="container">
<div class="section-heading"><div><p class="section-kicker">{t.model}</p><h2 id="horizon-model-title">{t.thesisTitle}</h2></div><p>{t.thesisIntro}</p></div>
<Diagram lang={lang}>{t.figCaption}</Diagram>
<p class="horizon-figure__alt">{t.figureLabel}</p>
<div class="horizon-legend">
{t.legend.map(([symbol,name,meaning])=><article><div class="horizon-legend__symbol">{symbol}</div><div><h3>{name}</h3><p>{meaning}</p></div></article>)}
</div>
<div class="horizon-thesis"><span>{t.strongest}</span><blockquote>{t.strongestText}</blockquote></div>
</div></section>
<section class="section horizon-child"><div class="narrow">
<p class="section-kicker">{t.questionEyebrow}</p><h2>{t.questionTitle}</h2><p>{t.questionBody}</p><blockquote>{t.questionAside}</blockquote>
</div></section>
<section class="section section--paper" aria-label={t.division}>
<div class="container"><p class="section-kicker">{t.division}</p>
<div class="horizon-distinction-grid">
{t.distinctions.map(([n,title,description])=><article><span>{n} / 04</span><h3>{title}</h3><p>{description}</p></article>)}
</div></div></section>
<section class="section horizon-process"><div class="container horizon-process__grid">
<div><p class="section-kicker">{t.methodEyebrow}</p><h2>{t.methodTitle}</h2><div class="horizon-process__quote">{t.principle}</div></div>
<ol>{t.path.map(([n,title,text])=><li><b>{n}</b><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol>
</div></section>
<section class="section section--paper"><div class="container horizon-collaboration">
<div><p class="section-kicker">PHILOSOPHIA · MATHEMATICA · INTELLIGENTIA ARTIFICIALIS</p><h2>{t.aiTitle}</h2><p>{t.aiBody}</p><blockquote>{t.aiWarning}</blockquote></div>
<div><p class="section-kicker">{lang==="de"?"UNSER AUFTRAG":"OUR TASK"}</p><h2>{t.roleTitle}</h2><p>{t.roleBody}</p><p>{lang==="de"?"In der Werkstatt übersetzen wir Symbole in Modelle, erkunden die 64 binären Linienmuster des I Ging und prüfen präzise Vorhersagen gegen ein Zufallsmodell.":"In the workshop, we translate symbols into models, explore the 64 binary line patterns of the I Ching and examine precise predictions against a chance model."}</p><div class="button-row"><a class="button button--gold" href={pathFor(lang,"esoterik-und-mathematik")}>{lang==="de"?"Zur Werkstatt ↗":"Open the workshop ↗"}</a><a class="button button--ghost" href={discussion} target="_blank" rel="noopener noreferrer">{t.forum}</a><a class="button button--ghost" href={pathFor(lang,"methode")}>{t.methods}</a></div></div>
</div></section>
<section class="section horizon-sources"><div class="narrow"><p class="section-kicker">{t.sources}</p><p>{t.sourceIntro}</p>
<ul>{t.refs.map(([name,url,description])=><li><a href={url} target="_blank" rel="noopener noreferrer">{name} ↗</a><small>{description}</small></li>)}</ul>
<div class="horizon-return"><a href={pathFor(lang,"atlas")} class="subtle-link">{t.atlas}</a></div>
</div></section>
</Layout>
