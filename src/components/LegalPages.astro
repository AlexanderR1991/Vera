---
import Layout from "../layouts/SiteLayout.astro";
import {pathFor} from "../lib/paths.mjs";
const {lang="de",kind="impressum"}=Astro.props;
const de=lang==="de";
const imprint=kind==="impressum";
const t=(g,e)=>de?g:e;
const operator="Alexander Radke";
const email="radke.a91@gmail.com";
---
<Layout lang={lang} slug={kind} pageTitle={t(imprint?"Impressum":"Datenschutz",imprint?"Legal notice":"Privacy notice")} description={t("Rechtliche Angaben und Datenschutz bei WIRKLICH – dokumentierter Ist-Stand mit offenen Pflichtangaben.","Legal and privacy information for WIRKLICH, including outstanding required details.")}>
  <section class="section legal-heading"><div class="container">
    <p class="section-kicker">{t("RECHTLICHE INFORMATIONEN · STAND 06.11.2026","LEGAL INFORMATION · 6 NOVEMBER 2026")}</p>
    <h1>{t(imprint?"Impressum":"Datenschutz",imprint?"Legal notice":"Privacy notice")}</h1>
    <p class="legal-lead">{imprint?t("Wer hinter WIRKLICH steht – und welche Angaben noch fehlen.","Who operates WIRKLICH — and which details are still missing."):t("Wie diese statische Website derzeit mit Daten umgeht.","How this static website currently handles data.")}</p>
  </div></section>
  <section class="section section--paper"><article class="narrow legal-copy">
    {imprint ? <>
      <p class="legal-status" role="note">{t("Die ladungsfähige Anschrift des Betreibers fehlt. Das Impressum ist deshalb unvollständig.","The operator’s postal address for service is missing. This legal notice is therefore incomplete.")}</p>
      <h2>{t("Angaben zum Anbieter","Operator details")}</h2>
      <dl>
        <div><dt>{t("Angebot","Service")}</dt><dd>WIRKLICH — {t("Die offene Erkenntniswerkstatt","The open inquiry workshop")}</dd></div>
        <div><dt>{t("Anbieter und redaktionell Verantwortlicher","Operator and person responsible for editorial content")}</dt><dd>{operator}</dd></div>
        <div><dt>{t("Kontakt für Rechts- und Datenschutzanfragen","Contact for legal and privacy enquiries")}</dt><dd><a href={"mailto:"+email}>{email}</a></dd></div>
        <div><dt>{t("Trägerschaft","Current status")}</dt><dd>{t("WIRKLICH ist ein privat getragenes Projekt. Es besteht keine Zugehörigkeit zu Wikimedia. Das Projekt hat keine anerkannte Gemeinnützigkeit.","WIRKLICH is a privately run project. It is unaffiliated with Wikimedia and has no recognised charitable status.")} <a href="https://github.com/AlexanderR1991/Wirklich">{t("Projekt auf GitHub","Project on GitHub")}</a></dd></div>
      </dl>
      <h2>{t("Inhalte und Rechte","Content and rights")}</h2>
      <p>{t("WIRKLICH ist eine offene, korrigierbare Denk- und Erkenntniswerkstatt. Hypothesen, KI-Entwürfe und redaktionell ungeprüfte Aussagen sind als solche zu verstehen. Sie ersetzen keine persönliche Rechts-, Medizin- oder Finanzberatung.","WIRKLICH is an open, revisable inquiry workshop. Hypotheses, AI drafts and editorially unreviewed claims are not verified findings and do not replace individual legal, medical or financial advice.")}</p>
      <p>{t("Urheber- und Lizenzangaben richten sich nach der jeweiligen Veröffentlichung und den dokumentierten Ausnahmen.","Copyright and licensing depend on the relevant publication and documented exceptions.")} <a href="https://github.com/AlexanderR1991/Wirklich/blob/main/LICENSING.md">{t("Lizenzdetails und Ausnahmen","Licences and exceptions")} ↗</a></p>
      <p>{t("Gesetzliche Grundlagen:","Relevant legal provisions:")} <a href="https://www.gesetze-im-internet.de/ddg/__5.html">§ 5 DDG</a> · <a href="https://www.die-medienanstalten.de/aufgaben/aufsicht/impressumspflicht/">§ 18 MStV / {t("Medienanstalten","media authorities")}</a>.</p>
      <p><a href={pathFor(lang,"datenschutz")}>{t("Zur Datenschutzerklärung","Read the privacy notice")} →</a></p>
    </> : <>
      <h2>{t("Verantwortliche Stelle und Kontakt","Controller and contact")}</h2>
      <p>{operator} {t("ist für die Verarbeitung personenbezogener Daten durch das Projekt verantwortlich. Für Datenschutzanfragen schreib an","is the controller for personal data processed by the project. For privacy enquiries, email")} <a href={"mailto:"+email}>{email}</a>.</p>
      <p><a href={pathFor(lang,"impressum")}>{t("Zum Impressum","Legal notice")}</a> · {t("Die ladungsfähige Anschrift fehlt derzeit.","The postal address for service is currently missing.")}</p>
      <h2>{t("Hosting und Zugriffsprotokolle","Hosting and access logs")}</h2>
      <p>{t("Die statische Website wird über GitHub Pages (GitHub) ausgeliefert. GitHub gibt an, beim Aufruf einer Pages-Seite IP-Adressen aus Sicherheitsgründen zu protokollieren und zu speichern; außerdem können technische Zugriffsdaten verarbeitet werden. Die konkreten Speicherfristen liegen beim Anbieter.","This static site is served through GitHub Pages. GitHub states that it logs and stores visitors' IP addresses for security purposes; technical access data may also be processed. Specific retention periods are determined by the provider.")}</p>
      <p>{t("Soweit der Projektbetreiber für diese Verarbeitung verantwortlich ist, erfolgt sie zur sicheren, funktionsfähigen Bereitstellung des Angebots auf Grundlage berechtigter Interessen (Art. 6 Abs. 1 Buchst. f DSGVO). GitHub beschreibt eigene Verarbeitungen und mögliche Drittlandübermittlungen in seiner Datenschutzerklärung.","To the extent that the operator controls this processing, the legal basis is the legitimate interest in a secure and functioning website (GDPR Art. 6(1)(f)). GitHub describes its own processing and possible international transfers in its privacy statement.")} <a href="https://docs.github.com/de/pages/getting-started-with-github-pages/what-is-github-pages">{t("GitHub-Pages-Datenerfassung","GitHub Pages data collection")} ↗</a> · <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t("GitHub-Datenschutzerklärung","GitHub privacy statement")} ↗</a></p>
      <h2>{t("Eigene Skripte und lokale Notizen","Site scripts and locally stored notes")}</h2>
      <p>{t("Nach dem derzeitigen Quelltext binden wir keine eigene Werbeanalytik, Tracking-Pixel oder Marketing-Cookies ein. Im optionalen Prüfblatt werden Entwürfe nur nach deinem ausdrücklichen Klick auf „Im Browser speichern“ im localStorage deines Browsers abgelegt (Schlüssel: wirklich.inquiry.v1). Sie bleiben dort bis zur manuellen Löschung oder zum Löschen der Browserdaten und werden von diesem Speichervorgang nicht an uns gesendet. Datei-Import und -Export erfolgen lokal im Browser.","Under the current source code, the site does not embed its own advertising analytics, tracking pixels or marketing cookies. In the optional inquiry worksheet, notes are stored in your browser's localStorage only after you explicitly click “Save in browser” (key: wirklich.inquiry.v1). They stay there until you delete them or clear browser data; this save action does not send them to us. File import and export happen locally in your browser.")}</p>
      <p>{t("Soweit die Speicherung für die ausdrücklich gewünschte Funktion unbedingt erforderlich ist, kommt § 25 Abs. 2 TDDDG in Betracht. Bei künftigen Analyse- oder Trackingfunktionen wird die Einwilligungsfrage erneut geprüft.","Where storage is strictly necessary for the feature explicitly requested, the exception in section 25(2) TDDDG may apply. Any future analytics or tracking features require a renewed consent review.")}</p>
      <h2>{t("Forschungsdaten und externe Plattformen","Research data and external platforms")}</h2>
      <p>{t("Die Seiten „Forschungsstrom“ und „Angriffsschwarm“ laden beim Öffnen öffentliche JSON-Daten von raw.githubusercontent.com. Dadurch wird eine Verbindung zu GitHub hergestellt. Wenn du freiwillig einen GitHub-Link öffnest oder ein Issue absendest, gelten zusätzlich die Bedingungen und Datenschutzregeln von GitHub. Öffentliche Issues und Kommentare können für andere sichtbar und dauerhaft archiviert werden; bitte keine privaten Daten Dritter einreichen.","The Research Stream and Adversarial Swarm pages load public JSON from raw.githubusercontent.com when opened, establishing a connection with GitHub. If you voluntarily open a GitHub link or submit an issue, GitHub's terms and privacy rules also apply. Public issues and comments may be visible to others and preserved in archives; do not disclose other people's private information.")}</p>
      <h2>{t("Zahlungen und Kontaktaufnahme","Payments and contact")}</h2>
      <p>{t("Im Unterstützungsbereich findest du die PayPal-Adresse des Betreibers. Erst wenn du den Link zu PayPal öffnest, verbindet sich dein Browser mit PayPal. Wenn du Geld sendest, sieht der Betreiber den Betrag und je nach Kontoeinstellungen auch deinen Namen und deine E-Mail-Adresse. Diese Angaben dienen der Zuordnung und Dokumentation des Zahlungseingangs.","The support section lists the operator’s PayPal address. Your browser connects to PayPal when you follow the link. If you send money, the operator sees the amount and, depending on your account settings, may also see your name and email address. These details are used to identify and record the payment.")} <a href={de ? "https://www.paypal.com/de/legalhub/paypal/privacy-full" : "https://www.paypal.com/de/legalhub/paypal/privacy-full?locale.x=en_GB"}>{t("Datenschutzerklärung von PayPal","PayPal Privacy Statement")} ↗</a></p>
      <p>{t("Wenn du eine E-Mail schreibst, verarbeiten wir die mitgeteilten Kontaktdaten und Inhalte zur Bearbeitung der Anfrage (je nach Anlass Art. 6 Abs. 1 Buchst. b, c oder f DSGVO).","If you send an email, the contact information and message you provide are processed to handle your enquiry (depending on the context, GDPR Art. 6(1)(b), (c) or (f)).")}</p>
      <p>{t("Das Projekt nutzt Gmail für die veröffentlichte Kontaktadresse. Wenn du dorthin schreibst, verarbeitet Google deine E-Mail-Adresse und den Inhalt der Nachricht zur Zustellung.","The project uses Gmail for its public contact address. When you write to it, Google processes your email address and message content for delivery.")} <a href={de ? "https://policies.google.com/privacy?hl=de" : "https://policies.google.com/privacy?hl=en"}>{t("Datenschutzerklärung von Google","Google Privacy Policy")}</a></p>
      <p>{t("Korrespondenz wird nur so lange aufbewahrt, wie sie für die Bearbeitung oder gesetzliche Aufbewahrungspflichten erforderlich ist. Wir behaupten keine feste Löschfrist für Protokolle, die allein GitHub verwaltet.","Correspondence is retained only as long as necessary to handle the matter or satisfy legal retention duties. We do not claim a fixed deletion period for logs controlled exclusively by GitHub.")}</p>
      <h2>{t("Deine Rechte","Your rights")}</h2>
      <p>{t("Unter den gesetzlichen Voraussetzungen hast du das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Datenübertragbarkeit und Widerspruch. Eine erteilte Einwilligung kannst du jederzeit mit Wirkung für die Zukunft widerrufen. Für diese Anfragen kannst du die oben genannte E-Mail-Adresse nutzen.","Subject to the applicable legal conditions, you have the right to access, correct or erase your data, restrict processing, request data portability and object to processing. You can withdraw consent at any time with effect for the future. You can use the email address above to exercise these rights.")}</p>
      <p>{t("Du kannst dich auch bei einer Datenschutzaufsichtsbehörde beschweren, zum Beispiel bei der","You can also lodge a complaint with a data protection authority, such as the")} <a href="https://www.datenschutz.sachsen.de/beschwerde-einreichen.html">{t("Sächsischen Datenschutz- und Transparenzbeauftragten","Saxon Data Protection and Transparency Commissioner")}</a>.</p>
      <p>{t("Rechtsgrundlagen und Informationen:","Legal references and information:")} <a href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32016R0679">{t("Datenschutz-Grundverordnung","GDPR")}</a> · <a href="https://www.gesetze-im-internet.de/ttdsg/__25.html">§ 25 TDDDG</a>.</p>
    </>}
    <p class="legal-updated">{t("Stand der Angaben: 6. November 2026. Bei Änderungen der Technik, Rechtsform oder Zahlungsabwicklung wird dieser Text angepasst.","Information last updated: 6 November 2026. This notice will be updated if the technology, legal structure or payment processing changes.")}</p>
  </article></section>
</Layout>
<style>
.legal-heading{padding-block:clamp(3.5rem,7vw,6rem) clamp(2.25rem,4vw,3.5rem)}
.legal-heading h1{font-size:clamp(3rem,7vw,5rem);line-height:1.05;margin:.5rem 0 1rem}
.legal-lead{max-width:49rem;font-size:clamp(1.1rem,2vw,1.35rem)}
.legal-copy{max-width:52rem;font-size:1.02rem;line-height:1.75;overflow-wrap:anywhere}
.legal-copy h2{font-size:clamp(1.6rem,3vw,2.15rem);margin:2.4rem 0 .85rem}
.legal-copy p{margin:1rem 0}
.legal-copy a{text-decoration:underline;text-underline-offset:.2em}
.legal-status{border-inline-start:3px solid var(--gold);padding:1.2rem 1.4rem;background:rgba(107,91,61,.1)}
.legal-copy dl{margin:1rem 0}
.legal-copy dl>div{border-bottom:1px solid var(--line);padding:1rem 0}
.legal-copy dt{font-weight:700}
.legal-copy dd{margin:.3rem 0 0}
.legal-updated{font-size:.9rem;opacity:.75;border-top:1px solid var(--line);padding-top:1rem;margin-top:3rem}
</style>
