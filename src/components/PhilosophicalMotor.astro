---
import Layout from "../layouts/SiteLayout.astro";
import ForumSectionLink from "./ForumSectionLink.astro";
import {base,pathFor} from "../lib/paths.mjs";
import project from "../../public/project.json";
import fixtures from "../../public/research/philosophical-motor-examples.v0.json";
import claimsData from "../../public/knowledge/claims.json";
import {maturityLabels,consensusLabels} from "../lib/maturity.mjs";
import {examineDirection,describePublishedClaim} from "../lib/philosophical-motor.mjs";

const {lang="de"}=Astro.props;
const en=lang==="en";
const t=(de,english)=>en?english:de;
const examples=fixtures.cases.map(scenario=>({scenario,result:examineDirection(scenario)}));
const publishedClaims=claimsData.claims.map(claim=>({claim,snapshot:describePublishedClaim(claim)}));
const signed=value=>typeof value==="number"?(value>0?"+":"")+value.toFixed(3):"—";
const labels={
 profile_sensitive:t("Profilabhängig: kein allgemeiner Einzelwert","Profile-sensitive: no universal score"),
 positive_across_profiles:t("Im Modell durchgehend positiv","Positive across chosen profiles in this model"),
 negative_across_profiles:t("Im Modell durchgehend negativ","Negative across chosen profiles in this model"),
 undetermined:t("Offen / nicht entscheidbar","Open / indeterminate")
};
const safeguards={
 blocked:t("Schutzgrenze verletzt – keine Handlungsempfehlung","Hard safeguard failed – no recommendation"),
 pending:t("Schutzlage unklar","Safeguard status uncertain"),
 declared_pass:t("Schutzlage nur im fiktiven Beispiel als erfüllt gesetzt","Safeguards assumed to pass in this fictional example"),
 not_assessed:t("Nicht geprüft","Not assessed")
};
const innerPaths = [
 {title:t("Stille hat einen Horizont","Silence has a horizon"),
  case:t("Im Meeting kostet dich ein Einwand im Modell 8. Unter vier Augen kostet der erste Schritt 2 und der von dir freigegebene Beitrag 4. Bei einer Grenze von 5 ist der Umweg gangbar, wenn die größte Hürde zählt (4). Wenn sich die Hürden addieren, kostet er 6.","In the model, raising an objection in the meeting costs 8. A private conversation costs 2 and a contribution you approve costs 4. With a limit of 5, the route is feasible if the largest hurdle counts (4). If hurdles add up, it costs 6."),
  question:t("Könnten hinter fünf geäußerten Einwänden fünf Zweifelnde stehen oder fünfzig? Welche Wege fehlen im Protokoll?","Could five voiced objections come from five dissenters or from fifty? Which routes are missing from the minutes?")},
 {title:t("Atmosphäre hat eine Reihenfolge","Atmosphere depends on order"),
  case:t("„Ich sehe, dass dich das getroffen hat.“ „Ich möchte erklären, wie ich es gemeint habe.“ Im Rechenbeispiel ergibt diese Reihenfolge 0,32 für die Bereitschaft zum Weiterreden. Umgekehrt ergibt sie 0,52. Die Werte folgen aus den erfundenen Regeln.","“I see that hurt you.” “I'd like to explain what I meant.” In the worked example, this order gives 0.32 for willingness to continue. Reversing it gives 0.52. The numbers follow from the invented rules."),
  question:t("Dreh die Sätze um. Was könnte „Ist schon gut“ danach jeweils bedeuten? Lass die Person selbst antworten.","Swap the lines. What could “It's okay” mean after each version? Let the person answer for themselves.")},
 {title:t("Fürsorge nach einem Nein","Care after a no"),
  case:t("Du möchtest drei Dinge tun. Nach einem Nein zu einer sachfremden Bitte bleiben zwei möglich. Der Anteil ist 2 von 3. Gewünschte Assistenz, die verfügbar bleibt, zählt mit.","You want to do three things. After declining an unrelated request, two remain possible. The share is 2 out of 3. Any support you want and can still access counts."),
  question:t("Welches Ziel fällt weg, und hängt der Zugang zu ihm vom Wohlwollen einer einzigen Person ab?","Which goal becomes unreachable, and does access depend on a single person's goodwill?")},
 {title:t("Heimweh nach einer Zukunft","Homesick for a future"),
  case:t("Ein Leben am Meer fühlt sich weniger erreichbar an. Bei einer angenommenen Bedeutung von 4 und einem Rückgang von 0,75 auf 0,25 ergibt das Modell 4 × 0,50 = 2.","A life by the sea feels less attainable. With a stipulated value of 4 and a drop from 0.75 to 0.25, the model gives 4 × 0.50 = 2."),
  question:t("Könnte eine andere Zukunft denselben Wunsch erfüllen?","Could a different future fulfil the same wish?")},
 {title:t("Ein Einwand schließt den Kreis","An objection closes the loop"),
  case:t("Ehrlichkeit und Respekt verlangen hier dasselbe. Respekt und Schweigen auch. Schweigen und Ehrlichkeit verlangen Gegensätzliches. Der Kreis hat das Produkt (+1) × (+1) × (−1) = −1. Unter diesen Annahmen lässt sich keine widerspruchsfreie Wahl treffen.","Honesty and respect call for the same choice here. So do respect and silence. Silence and honesty call for opposites. The product around the loop is (+1) × (+1) × (−1) = −1. The assumptions admit no consistent choice."),
  question:t("Meint „Respekt“ an beiden Stellen dasselbe? Welche Verbindung müsste genauer formuliert werden?","Does “respect” mean the same thing in both places? Which link needs a clearer definition?")}
];
---
<Layout lang={lang} slug="philosophischer-motor" pageTitle={t("Mathematik des philosophischen Motors","Mathematics of the Philosophical Engine")} description={t("M-03: Der mathematische Forschungsentwurf von WIRKLICH mit nachvollziehbaren fiktiven Rechenbeispielen.","M-03: The mathematical research design behind WIRKLICH, with auditable fictional worked examples.")}>
 <article class="motor-page">
  <header class="motor-hero">
   <div class="container">
    <p class="section-kicker">{t("WIRKLICH · M-01 + M-02 + M-03","WIRKLICH · M-01 + M-02 + M-03")}</p>
    <h1>{t("Die Mathematik","The mathematics")}<br /><em>{t("des philosophischen Motors.","of the philosophical engine.")}</em></h1>
    <p class="motor-lead">{t("Nicht jede Frage hat eine Zahl als Antwort. Unser Motor soll nachvollziehbar erklären, was wir wissen, worüber wir streiten und wann eine Richtung begründbar ist.","Not every question has a numerical answer. Our engine aims to show what we know, where we disagree, and when a direction could be justified.")}</p>
    <p class="motor-status">{t("FORMALER FORSCHUNGSENTWURF · NICHT EMPIRISCH VALIDIERT · KEIN LIVE-KI-SYSTEM","FORMAL RESEARCH DRAFT · NOT EMPIRICALLY VALIDATED · NO LIVE AI SYSTEM")}</p>
    <div class="button-row">
     <a class="button button--gold" href="#rechenbeispiele">{t("Fiktive Rechenbeispiele ansehen","Explore fictional examples")} ↓</a>
     <a class="button button--ghost" href="#innere-wege">{t("Fünf Gedankenexperimente","Five thought experiments")} ↓</a>
     <a class="button button--ghost" href={pathFor(lang,"die-bruecke")}>{t("M-02: Die Brücke","M-02: The Bridge")} ↗</a>
    </div>
   </div>
  </header>

  <section class="section motor-section">
   <div class="container">
    <p class="section-kicker">{t("TATSÄCHLICHE AUSSAGEN · NUR LESEN","EXISTING CLAIMS · READ ONLY")}</p>
    <h2>{t("Was der Motor heute wirklich weiß.","What the engine actually knows today.")}</h2>
    <p>{t("Die Einträge stammen aus dem öffentlichen Aussagenregister. Ihr Prüfstatus wird unverändert gelesen: keine automatische Aufstufung, keine gesellschaftliche Konsensbehauptung, keine moralische Punktzahl.","These entries come from the public claim register. Their review status is read unchanged: no automatic promotion, no claim of social consensus, and no moral score.")}</p>
    <div class="motor-claims">
      {publishedClaims.map(({claim,snapshot})=><article class="motor-claim">
        <small>{snapshot.id} · v{snapshot.version} · {snapshot.claim_type}</small>
        <h3>{claim.statement[lang]}</h3>
        <p>{maturityLabels[lang][snapshot.maturity_level]} · {consensusLabels[lang][snapshot.consensus_status]}</p>
        <span>{t("Richtungsindex: nicht berechnet","Directional index: not computed")}</span>
      </article>)}
    </div>
    <p><a href={pathFor(lang,"aussagen")}>{t("Zum vollständigen Aussagenregister","Explore the full claim register")} →</a></p>
   </div>
  </section>

  <section class="section motor-section" id="motor-ebenen">
   <div class="container">
    <p class="section-kicker">{t("DIE GRUNDIDEE","THE CENTRAL DESIGN")}</p>
    <h2>{t("Sechs getrennte Ebenen. Eine nachvollziehbare Antwort.","Six distinct layers. One auditable response.")}</h2>
    <ForumSectionLink lang={lang} place="philosophischer-motor" section="motor-ebenen" />
    <div class="motor-grid">
     {[
       {id:"01",de:"Wissen",en:"Evidence",detailDe:"Empirische Befunde, Quellabhängigkeit, Unsicherheit.",detailEn:"Empirical findings, source dependence, uncertainty."},
       {id:"02",de:"Logik",en:"Logic",detailDe:"Definitionen, Beweise, Gegenmodelle.",detailEn:"Definitions, proofs and countermodels."},
       {id:"03",de:"Werte",en:"Values",detailDe:"Offengelegte Ziele, Rechte und Wertprofile.",detailEn:"Explicit goals, rights and value profiles."},
       {id:"04",de:"Verstehen",en:"Understanding",detailDe:"M-02 trennt präzise Wiedergabe und Zustimmung.",detailEn:"M-02 separates accurate restatement and agreement."},
       {id:"05",de:"Dissens",en:"Dissent",detailDe:"Der stärkste Einwand darf sichtbar bleiben.",detailEn:"The strongest objection must remain visible."},
       {id:"06",de:"Korrektur",en:"Revision",detailDe:"Versionen, Abhängigkeiten, neue Gegenprüfungen.",detailEn:"Versions, dependencies and renewed challenges."}
     ].map(item=><article class="motor-card">
      <small>{item.id}</small><h3>{en?item.en:item.de}</h3><p>{en?item.detailEn:item.detailDe}</p>
     </article>)}
    </div>
    <div class="motor-formula">
      <p>{t("M-03 · BEDINGTE RICHTUNG", "M-03 · CONDITIONAL DIRECTION")}</p>
      <div class="motor-formula__main" aria-label={t("Richtung ist die gewichtete Summe angenommener Wirkungen","Direction is the weighted sum of assumed effects")}>
       <span>I<sub>z</sub> = Σ w<sub>j</sub>(z) · d<sub>j</sub></span>
      </div>
      <p>{t("Wirkungen und Gewichte sind Modellannahmen. Ohne Kontext, Vergleich, überprüfte Evidenz und offengelegte Werte ist das kein moralisches Urteil.","Effects and weights are model assumptions. Without context, a baseline, examined evidence and declared values, this is not a moral verdict.")}</p>
    </div>
   </div>
  </section>

  <section class="section motor-section" id="befund-zustimmung-entscheidung" aria-labelledby="separation-title">
   <div class="container">
    <p class="section-kicker">{t("BELEG, ZUSTIMMUNG, ENTSCHEIDUNG", "EVIDENCE, AGREEMENT, DECISION")}</p>
    <h2 id="separation-title">{t("Drei Fragen. Drei getrennte Antworten.", "Three questions. Three separate answers.")}</h2>
    <p class="motor-caption">{t("Ob eine Maßnahme wirkt, wer ihr zustimmt und ob sie eingeführt werden soll, sind verschiedene Fragen. Die folgende Regel präzisiert unseren Entwurf; sie ist keine automatische wissenschaftliche Prüfung.", "Whether a measure works, who agrees to it and whether to introduce it are different questions. This rule clarifies our design; it is not an automatic scientific assessment.")}</p>
    <div class="motor-grid separation-grid">
     <article class="motor-card">
      <h3>{t("1 · Den Befund begründen", "1 · Justify the finding")}</h3>
      <p class="separation-formula">B = F(q, c, E, M)</p>
      <p>{t("B ist der begründete Befund mit Unsicherheit. Er hängt von der Frage q, ihrem Geltungsbereich c, der Evidenz E und den Prüfannahmen M ab. Daten müssen zur Frage passen und nachvollziehbar ausgewertet werden.", "B is the reasoned finding with uncertainty. It depends on the question q, its scope c, evidence E and examination assumptions M. Data must fit the question and be analysed transparently.")}</p>
     </article>
     <article class="motor-card">
      <h3>{t("2 · Zustimmung festhalten", "2 · Record agreement")}</h3>
      <p class="separation-formula">C(x, v, P)</p>
      <p>{t("C hält fest, wer aus dem benannten Kreis P genau die Fassung v einer Aussage oder eines Vorschlags x mitträgt: Ja, Nein oder offen. Fehlende und veraltete Antworten gelten nicht als Zustimmung.", "C records who in the named group P supports the exact version v of a claim or proposal x: yes, no or open. Missing and outdated responses do not count as agreement.")}</p>
     </article>
     <article class="motor-card">
      <h3>{t("3 · Verantwortlich entscheiden", "3 · Decide accountably")}</h3>
      <p class="separation-formula">D = G<sub>R</sub>(A, B, Z, C)</p>
      <p>{t("D berücksichtigt Optionen A, Befunde B, Wertannahmen Z und Zustimmung C nach einem benannten Verfahren R mit Zuständigkeit, Rechten und Korrekturweg. Die Formel bezeichnet das Verfahren; sie berechnet keine richtige Politik.", "D considers options A, findings B, value premises Z and agreement C under a named procedure R with authority, rights and a route to correction. The formula names the procedure; it does not calculate correct policy.")}</p>
     </article>
    </div>
    <div class="motor-formula separation-rule">
     <p>{t("DIE TRENNUNGSREGEL", "THE SEPARATION RULE")}</p>
     <p><strong>{t("Gleiche Gründe → gleicher Befund, auch bei anderer Zustimmung.", "Same grounds → same finding, even when agreement changes.")}</strong></p>
     <p>{t("Bei unveränderter Frage, Evidenz und Methode ändert bloßes Umzählen von Stimmen den Befund nicht. Liefert ein Gespräch neue Beobachtungen oder zeigt einen methodischen Fehler, ändern sich E oder M: Dann wird neu geprüft. Auch fachliche Zeugnisse brauchen eine Prüfung ihrer Gründe und Abhängigkeiten.", "With the question, evidence and method unchanged, recounting votes does not change the finding. If discussion supplies new observations or exposes a methodological error, E or M changes and examination starts again. Expert testimony also requires scrutiny of its grounds and dependencies.")}</p>
    </div>
    <div class="motor-paths">
     <details>
      <summary>{t("Drei Gegenproben", "Three counterchecks")}</summary>
      <p>{t("Eine Million Ja-Stimmen ohne tragfähigen Wirkungsbeleg: Zustimmung dokumentiert, Wirkung offen. Ein Einzelner kann dagegen einen tragfähigen Befund vorlegen oder ein bereits geprüftes Ergebnis vermitteln.", "A million yes votes without adequate evidence: agreement recorded, effect unresolved. One person can nevertheless present a sound finding or communicate an already examined result.")}</p>
      <p>{t("Derselbe Befund, unterschiedliche Ziele: Menschen können die gleiche Wirkung anerkennen und verschiedene Handlungen bevorzugen. Der Befund allein legt weder Zustimmung noch eine Pflicht fest.", "Same finding, different goals: people can acknowledge the same effect and prefer different actions. The finding alone determines neither consent nor an obligation.")}</p>
      <p>{t("Ein belegter Auswertungsfehler: Befund und davon abhängige Entscheidungen werden neu geprüft. Eine geänderte freiwillige Vereinbarung braucht neue Antworten. Eine politische Entscheidung kann unter ausdrücklich benannter Unsicherheit getroffen werden, ohne diese zu beseitigen.", "A demonstrated analysis error: re-examine the finding and decisions that depend on it. A changed voluntary agreement needs new responses. A political decision can be made under explicitly stated uncertainty without eliminating it.")}</p>
     </details>
    </div>
    <p><a href={project.repository+"/blob/main/docs/"+(en?"en/philosophical-motor-mathematics.md#findings-agreement-and-decisions":"philosophischer-motor-mathematik.md#befund-zustimmung-und-entscheidung")}>{t("Definitionen, Ableitung und Revisionsgrenzen", "Definitions, derivation and revision boundaries")} ↗</a> · <a href={pathFor(lang,"methode","beleglage-und-entscheidung")}>{t("Zur Anwendung in Veras Methode", "Apply this in Vera's method")} →</a></p>
   </div>
  </section>

  <section class="section section--paper motor-section" id="rechenbeispiele">
   <div class="container">
    <p class="section-kicker">{t("AUSFÜHRBARER PROTOTYP · NUR ERFUNDENE DATEN","EXECUTABLE PROTOTYPE · INVENTED DATA ONLY")}</p>
    <h2>{t("Drei Fälle, die einem Zahlensystem Grenzen setzen.","Three cases that expose the limits of a scoring system.")}</h2>
    <ForumSectionLink lang={lang} place="philosophischer-motor" section="rechenbeispiele" />
    <p class="motor-caption">{t("Die Zahlen entstehen durch einen offenen JavaScript-Kern aus künstlichen Wirkungsannahmen. Sie beschreiben keine Menschen, keine realen Folgen und keine statistischen Konfidenzintervalle. Die Software erlaubt keine Freigabe realer Richtungswerte.","These numbers come from a transparent JavaScript core applied to invented effect assumptions. They describe no real people or outcomes and are not statistical confidence intervals. The software cannot publish real direction scores.")}</p>
    <div class="motor-examples">
     {examples.map(({scenario,result})=><article class="motor-example">
      <div class="motor-example__heading">
       <span>{scenario.id} · {t("SYNTHETISCH","SYNTHETIC")}</span>
       <h3>{scenario.title[lang]}</h3>
      </div>
      {result.profile_results.length>0?
       <div class="motor-table-wrap" tabindex="0" role="region" aria-label={t("Intervallwerte","Interval values")}>
        <table>
         <caption>{t("Erfundene Intervallwerte nach Wertprofil","Invented interval outcomes by value profile")}</caption>
         <thead><tr><th scope="col">{t("Wertprofil","Value profile")}</th><th scope="col">{t("Untere Grenze","Lower bound")}</th><th scope="col">{t("Mitte","Centre")}</th><th scope="col">{t("Obere Grenze","Upper bound")}</th></tr></thead>
         <tbody>{result.profile_results.map(profile=>{
          const source=scenario.value_profiles.find(item=>item.id===profile.id);
          return <tr><th scope="row">{source?.label[lang]||profile.id}</th><td>{signed(profile.lower)}</td><td><strong>{signed(profile.estimate)}</strong></td><td>{signed(profile.upper)}</td></tr>;
         })}</tbody>
        </table>
       </div>
       :<p class="motor-empty">{t("Keine Berechnung: Die Wirkung einer relevanten Dimension ist unbekannt.","No calculation: an important effect dimension is missing.")}</p>}
      <p class="motor-interpret"><strong>{labels[result.direction]||t("Keine Auswertung","No evaluation")}.</strong> {safeguards[result.safeguard_status]}</p>
      <p class="motor-no-publish">{t("Keine reale Bewertung oder Veröffentlichung zulässig.","Real-world scoring and publication are disabled.")}</p>
     </article>)}
    </div>
   </div>
  </section>

  <section class="section motor-section" id="innere-wege" aria-labelledby="innere-wege-title">
   <div class="container">
    <p class="section-kicker">{t("FÜNF GEDANKENEXPERIMENTE","FIVE THOUGHT EXPERIMENTS")}</p>
    <h2 id="innere-wege-title">{t("Die Mathematik der inneren Wege","The mathematics of the paths we see")}</h2>
    <ForumSectionLink lang={lang} place="philosophischer-motor" section="innere-wege" />
    <p class="motor-caption">{t("Dieselbe Situation kann für zwei Menschen ganz verschiedene Wege offenlassen. Wähle einen erfundenen Fall und prüfe, welche Annahme sein Ergebnis ändern würde.","The same situation can leave two people with very different options. Pick a fictional case and examine which assumption would change its result.")}</p>
    <div class="motor-paths">
     {innerPaths.map(path=><details>
      <summary>{path.title}</summary>
      <p>{path.case}</p>
      <p><strong>{path.question}</strong></p>
     </details>)}
    </div>
    <p><a href={project.repository+"/blob/main/docs/mathematik-innerer-wege.md"+(en?"#english":"")}>{t("Formeln, Grenzen und Einsatz im Streit","Formulas, limits and use in a disagreement")} ↗</a></p>
   </div>
  </section>

  <section class="section motor-section">
   <div class="container">
    <p class="section-kicker">{t("NICHTVERRECHENBARE REGELN","NON-COMPENSATORY SAFEGUARDS")}</p>
    <h2>{t("Ein hoher Wert kann Unrecht nicht wegaddieren.","A positive number cannot cancel a rights violation.")}</h2>
    <div class="motor-principles">
     <div><strong>∅</strong><p>{t("Keine Daten heißt nicht null. Fehlende Wirkungen müssen offenbleiben.","Missing data does not mean zero. Unknown effects stay unknown.")}</p></div>
     <div><strong>≠</strong><p>{t("Verstehen ist nicht Einigkeit; Zustimmung ist kein Wahrheitsbeweis.","Understanding is not agreement; agreement does not prove truth.")}</p></div>
     <div><strong>↺</strong><p>{t("Eine Korrektur markiert Folgeprüfungen. Sie verbessert nicht automatisch die Wahrheit.","A correction triggers dependent reviews. Improvement is never automatic.")}</p></div>
    </div>
   </div>
  </section>

  <section class="section motor-section motor-end">
   <div class="container">
    <p class="section-kicker">{t("OPEN SOURCE · PRÜFBAR · ANFECHTBAR","OPEN SOURCE · INSPECTABLE · CHALLENGEABLE")}</p>
    <h2>{t("Widerlege die Voraussetzungen – nicht nur das Ergebnis.","Challenge the assumptions, not just the result.")}</h2>
    <p>{t("Diese Mathematik ist ein Forschungsrahmen, keine neue bewiesene Gesellschaftstheorie. Auch Kriterien, Skalen, Gewichtungen und Regeln dürfen begründet geändert oder verworfen werden. Die aktuellen KI-Fachagenten und der Richtungsindex sind separate, noch ungeprüfte Vorhaben.","This mathematics is a research framework, not a proven new theory of society. Criteria, scales, weights and rules are all open to challenge or withdrawal. Expert AI roles and a public direction index remain separate unreviewed proposals.")}</p>
    <div class="motor-links">
     <a href={project.repository+"/blob/main/docs/"+(en?"en/philosophical-motor-mathematics.md":"philosophischer-motor-mathematik.md")}>{t("Vollständige mathematische Spezifikation","Complete mathematical specification")} ↗</a>
     <a href={pathFor(lang,"forum","forum-mathematik")}>{t("Mathematik der Diskussionsplätze","Mathematics of the discussion squares")} <span aria-hidden="true">→</span></a>
     <a href={base+"research/philosophical-motor-examples.v0.json"}>{t("Fiktive Fälle als JSON","Fictional cases as JSON")} ↗</a>
     <a href={project.repository+"/blob/main/src/lib/philosophical-motor.mjs"}>{t("Berechnung und Schutzregeln als Quellcode","Calculation and safeguards in source code")} ↗</a>
     <a href={project.repository+"/issues/new?template=angriff.yml"}>{t("Einen formalen Gegenfall einreichen","Submit a countermodel")} ↗</a>
    </div>
    <p class="motor-last">{t("Es ist ein Fortschritt, wenn eine Maschine sagen kann: „Unter diesen Voraussetzungen weiß ich es nicht.“","It is progress when a machine can say: 'Under these assumptions, I do not know.'")}</p>
   </div>
  </section>
 </article>
</Layout>
<style>
.motor-page{--motor-accent:#cfab79}
.motor-hero{padding:clamp(4rem,9vw,8rem) 0 4.5rem;background:radial-gradient(ellipse at 82% 0%,rgba(207,171,121,.12),transparent 52%)}
.motor-hero .container{max-width:80rem}
.motor-hero h1{max-width:62rem;font-size:clamp(2.5rem,6vw,5.6rem);line-height:1.08;letter-spacing:-.045em;margin:.75rem 0 1.5rem}
.motor-hero em{color:var(--motor-accent);font-weight:400}
.motor-lead{font-size:clamp(1.1rem,2.2vw,1.55rem);max-width:57rem;line-height:1.6}
.motor-status{font-size:.76rem;letter-spacing:.09em;opacity:.7;margin-top:1.6rem;margin-bottom:1.6rem}
.motor-section{padding-block:clamp(3rem,6vw,5rem)}
.motor-section h2{max-width:54rem;font-size:clamp(1.65rem,3vw,2.65rem);line-height:1.2;margin:.7rem 0 1.7rem}
.motor-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.motor-claims{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:2rem 0}
.motor-claim{border:1px solid var(--line);border-radius:12px;padding:1.2rem}
.motor-claim small{font-size:.72rem;color:var(--motor-accent)}
.motor-claim h3{font-size:1rem;line-height:1.4;margin:.55rem 0 .8rem}
.motor-claim p{font-size:.85rem;opacity:.72}
.motor-claim span{display:inline-block;font-size:.78rem;border:1px solid var(--line);border-radius:30px;padding:.3rem .7rem}
@media(max-width:760px){.motor-claims{grid-template-columns:1fr}}
.motor-card{padding:1.4rem;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.025)}
.motor-card small{color:var(--motor-accent)}
.motor-card h3{margin:.7rem 0 .4rem;font-size:1.25rem}
.motor-card p{margin:0;color:var(--muted,#b5b7bb)}
.separation-grid .separation-formula{font:clamp(1.15rem,2.1vw,1.6rem)/1.5 ui-serif,Georgia,serif;color:var(--text);margin:.7rem 0;overflow-wrap:anywhere}
.separation-rule>p:last-child{max-width:72ch}
