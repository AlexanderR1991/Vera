---
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const en=lang==="en";
---
<section class="section art-teaser" aria-label={en?"Art and inquiry":"Kunst und Erkenntnis"}>
  <div class="container"><p class="section-kicker">LIBER ARTIS</p>
    <h2>{en?"ART MAY":"KUNST DARF UNS"}<br/><em>{en?"CHALLENGE US.":"WIDERSPRECHEN."}</em></h2>
    <p>{en?"Bring us the work that makes our favourite idea uncomfortable. Images, music, literature and performance have room here for their own questions.":"Bringt uns das Werk, das unsere Lieblingsidee unbequem macht. Bilder, Musik, Literatur und Performance bekommen hier Raum für eigene Fragen."}</p>
    <a class="button button--ghost" href={pathFor(lang,"kunst-und-erkenntnis")}>{en?"Explore art & inquiry →":"Kunst & Erkenntnis entdecken →"}</a>
  </div>
</section>
<style>
.art-teaser{background:radial-gradient(ellipse at 70% 30%,#694f6340,transparent 65%),#121c20;text-align:center}
.art-teaser h2{font:clamp(2.2rem,5.4vw,4.8rem)/1.1 var(--serif);margin:1.5rem auto;letter-spacing:-.04em}
.art-teaser h2 em{color:var(--gold-bright);font-weight:400}
.art-teaser p:not(.section-kicker){max-width:47rem;margin:0 auto 2rem;font:clamp(1.1rem,2vw,1.4rem)/1.65 var(--serif)}
</style>
