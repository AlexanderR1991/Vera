---
import Layout from "../layouts/SiteLayout.astro";
import project from "../../public/project.json" with {type: "json"};
import registry from "../../public/knowledge/claims.json";
import discovery from "../../public/research/stream.json";
import criticism from "../../public/research/angriffe.json";
import {topics} from "../lib/tree.mjs";
import {summarizeProject} from "../lib/project-status.mjs";
import {pathFor, base} from "../lib/paths.mjs";
import "../styles/mission.css";
import "../styles/workbench.css";
const {lang="de"}=Astro.props;
const en=lang==="en", t=(de,english)=>en?english:de;
const s=summarizeProject(registry,topics,discovery,criticism);
const repo=project.repository;
const next=[
  ["P-00",t("Den Einstieg mit Menschen erproben","Try the entry with real people"),t("Kleine freiwillige Runden mit unterschiedlichen Lese- und Gerätebedürfnissen. Bedienung, eigene Gründe und neue Fälle ohne Hilfe getrennt beobachten. Vertrauliche Beschwerden vor breiter Community-Einladung ermöglichen.","Small voluntary sessions with different reading and device needs. Observe usability, participants’ reasons and new cases without help separately. Establish private reporting before broad community recruitment."),"/blob/main/docs/spielpilot.md"],
  ["P-01",t("Zehn begrenzte Aussagen prüfen","Examine ten bounded claims"),t("Quellen im Volltext, fachkundige menschliche Prüfung, Gegenbelege, Grenzen und begründete Revisionsentscheidungen dokumentieren. Eine Quote ersetzt keine Prüfung.","Document full-text source review, qualified human examination, counterevidence, limits and reasoned revisions. A quota cannot replace review."),"/blob/main/docs/roadmap.md"],
  ["P-02",t("Die Methode mit einer Alternative vergleichen","Compare the method with an alternative"),t("Aufgaben, Vergleichsbedingungen und Auswertung vorab festlegen. Fehler, Fehlalarme, Verständnis, Zeit und Kosten getrennt berichten. Ein negatives Ergebnis wird veröffentlicht.","Define tasks, comparison conditions and analysis beforehand. Report errors, false alarms, understanding, time and costs separately. Publish a negative result too."),"/blob/main/docs/evaluation-v1.md"],
  ["P-03",t("Verantwortung belastbar machen","Make accountability work"),t("Unabhängige Prüfung und Einspruch, Übersetzungsreview, zugängliche Nutzung und ein transparentes Budget mit real zugesagten Verantwortlichen aufbauen.","Establish independent review and appeals, translation review, accessible use and a transparent budget with people who have actually agreed to take responsibility."),"/blob/main/docs/community-governance.md"]
];
---
<Layout lang={lang} slug="projektstatus">
<article class="container mission-document" data-project-status>
  <header><p class="section-kicker">{t(project.name,project.english_name)} {project.version} · {project.release_date}</p><h1>{t("Was du von 1.0 erwarten kannst.","What you can expect from 1.0.")}</h1><p class="mission-lead">{project.release_scope[lang]}</p><p>{t("WIRKLICH verbindet Fragen, Prüfwerkzeuge, Forschungsfelder und dokumentierte Korrektur. Der bisherige Name „Grundtext des Wirklichen“ bleibt der Titel unseres philosophischen Fundaments.","The workshop connects questions, tools for inquiry, research fields and documented correction. The former name, “Grundtext des Wirklichen”, remains the title of our philosophical foundation.")}</p><div class="button-row"><a class="button button--gold" href={pathFor(lang,"werkstatt")}>{t("Mit einer Frage beginnen","Start with a question")} ↗</a><a class="button button--ghost" href={base+"project.json"}>{t("Projektprofil als JSON","Project profile as JSON")} ↗</a></div></header>
  <section id="bestand"><h2>{t("Der Bestand, offen gezählt.","An open count of what exists.")}</h2><p>{t("Diese Zahlen werden beim Website-Build aus dem veröffentlichten Register und der Themenkarte abgeleitet. Sie sind keine laufenden Besucherzahlen und keine Bewertung wissenschaftlicher Qualität.","These counts are derived from the published register and topic map when the site is built. They are neither live visitor counts nor scores of scientific quality.")}</p>
    <dl class="status-stats"><div><dt>{t("Registereinträge","Claim records")}</dt><dd data-stat="claims">{s.claims}</dd></div><div><dt>{t("Mit dokumentiertem menschlichem Review","With documented human review")}</dt><dd data-stat="reviewed">{s.reviewed}</dd></div><div><dt>{t("Lesbare Themenentwürfe","Readable topic drafts")}</dt><dd data-stat="drafts">{s.drafts}</dd></div><div><dt>{t("Offene Themenfelder","Undeveloped topics")}</dt><dd data-stat="open">{s.open}</dd></div></dl>
    <p>{t(`Die Themenkarte enthält ${s.topics} Themen, darunter ${s.proposals} verlinkte offene Änderungsvorschläge. Mehrfachzuordnungen sind möglich. Ein Themenentwurf ist keine fachliche Freigabe.`, `The map contains ${s.topics} topics, including ${s.proposals} linked open change proposals. Topics may belong to several fields. A readable draft is not expert approval.`)}</p><a class="subtle-link" href={pathFor(lang,"aussagen")}>{t("Aussagen und Prüfstatus ansehen","Inspect claims and review status")} ↗</a>
  </section>
  <section id="werkzeuge"><h2>{t("Was heute benutzbar ist.","What you can use today.")}</h2><div class="mission-grid"><article><h3>{t("Dein eigenes Prüfblatt","Your own inquiry worksheet")}</h3><p>{t("Eine Frage, eine vorläufige Aussage, Gründe, Gegenargumente und Revisionsbedingungen ordnen. Als Text oder JSON exportieren, wieder öffnen und auf Wunsch im Browser speichern. Eingaben werden nicht gesendet.","Organize a question, provisional claim, reasons, objections and revision conditions. Export text or JSON, reopen it and optionally save it in your browser. Entries are not sent.")}</p><a class="subtle-link" href={pathFor(lang,"werkstatt")}>{t("Prüfblatt öffnen","Open worksheet")} ↗</a></article><article><h3>{t("Symbol, Modell und Zufall","Symbols, models and chance")}</h3><p>{t("Die bestehende Mathematikwerkstatt verbindet ein Modellblatt, 64 binäre Linienmuster und einen Rechner für ein begrenztes Zufallsmodell. Die Werkzeuge beweisen keine esoterische Erklärung.","The existing mathematics workshop combines a model worksheet, 64 binary line patterns and a calculator for a bounded chance model. These tools do not establish an esoteric explanation.")}</p><a class="subtle-link" href={pathFor(lang,"esoterik-und-mathematik")}>{t("Mathematikwerkstatt öffnen","Open mathematics workshop")} ↗</a></article><article><h3>{t("Felder und Perspektiven verbinden","Connect fields and perspectives")}</h3><p>{t("Themenbaum, Atlas, Kapitel und Kunst bleiben mit ihrem jeweiligen Entwurfsstatus zugänglich. Unterschiede zwischen Werten, Befunden und Deutungen bleiben sichtbar.","The topic tree, atlas, chapters and art remain accessible with their draft status. Values, findings and interpretations remain distinguishable.")}</p><a class="subtle-link" href={pathFor(lang,"baum-des-wissens")}>{t("Den Baum erkunden","Explore the tree")} ↗</a></article><article><h3>{t("Kritik und Korrektur einreichen","Submit criticism and corrections")}</h3><p>{t("Fragen, Quellen, Gegenbeispiele und Änderungsentwürfe können über die bestehenden Beitragswege eingereicht werden. Es gibt keine automatische fachliche Freigabe durch KI oder Mehrheitszustimmung.","Questions, sources, counterexamples and proposed revisions can be submitted through the contribution routes. AI or majority agreement cannot automatically grant expert approval.")}</p><a class="subtle-link" href={pathFor(lang,"mitwirken")}>{t("Einen Beitrag beginnen","Start a contribution")} ↗</a></article></div></section>
  <section id="automatik"><h2>{t("Automatik braucht ein sichtbares Ergebnis.","Automation needs a visible result.")}</h2><p>{t("Ein konfigurierter Zeitplan belegt keinen erfolgreichen Lauf. Hier steht ausschließlich der Zustand der eingebundenen öffentlichen Daten. Metadaten und KI-Kritik bleiben ungeprüft.","A configured schedule does not establish a successful run. This section shows only the state of the included public data. Metadata and AI criticism remain unverified.")}</p><div class="mission-grid">{[["forschungsstrom",t("Forschungsstrom","Research stream"),s.discovery],["angriffsschwarm",t("Angriffsschwarm","Adversarial stream"),s.criticism]].map(([slug,label,data])=><article><h3>{label}</h3><p>{t("Einträge im aktuellen Datenstand: ","Items in the current data: ")}{data.items}</p><p>{data.updated_at?t("Dokumentierter Datenzeitpunkt: ","Recorded data timestamp: ")+data.updated_at:t("Noch kein Lauf in diesem Datenstand dokumentiert.","No run is documented in this data snapshot yet.")}</p><a class="subtle-link" href={pathFor(lang,slug)}>{t("Daten und Grenzen ansehen","View data and limitations")} ↗</a></article>)}</div></section>
  <section id="verantwortung"><h2>{t("Wer entscheidet — und wer widersprechen darf.","Who decides, and who may object.")}</h2><p>{t("Der Repository-Eigentümer trägt derzeit die redaktionelle Verantwortung. Unabhängige Fachprüfung und institutionell unabhängige Einspruchsprüfung sind noch nicht eingerichtet. Widerspruch ist über öffentliche Issues möglich; die Bewertung der eigenen Entscheidung wird dadurch nicht unabhängig.","The repository owner currently holds editorial responsibility. Independent expert review and institutionally independent appeals are not yet established. Public issues allow objections; reviewing one's own decision does not make it independent.")}</p><p>{t("Unterstützung darf kein Ergebnis kaufen. Würde, Freiheit und Fürsorge sind offengelegte Werte. Sie geben niemandem das Recht, Zustimmung, Versöhnung oder eine gemeinsame Überzeugung zu erzwingen. Ein begründeter Dissens ist ein zulässiges Ergebnis.","Support must not buy an outcome. Dignity, freedom and care are explicit values. They do not entitle anyone to force agreement, reconciliation or a shared belief. Reasoned disagreement is an acceptable outcome.")}</p><p><a href={repo+"/blob/main/docs/community-governance.md"}>{t("Redaktion und Einspruch","Editorial process and appeals")}</a> · <a href={repo+"/blob/main/docs/finanzierung.md"}>{t("Finanzierung und Verantwortung","Funding and accountability")}</a></p></section>
  <section id="naechste-schritte"><h2>{t("Woran wir den nächsten Fortschritt messen.","How we will judge the next progress.")}</h2><ol class="status-tasks">{next.map(([id,title,detail,href])=><li><strong>{id} · {title}</strong><p>{detail}</p><a href={repo+href}>{t("Aufgabe und Kriterien lesen","Read the task and criteria")} ↗</a></li>)}</ol><p class="mission-callout">{t("1.0 bezeichnet eine benutzbare Werkzeugfassung. Erfolg bedeutet für uns nachvollziehbaren Nutzen, sichtbare Fehlerkorrektur und verantwortbare Folgen. Ob wir das erreichen, bleibt überprüfbar.","1.0 denotes a usable tool release. For us, success means demonstrable usefulness, visible error correction and accountable consequences. Whether we achieve this remains open to examination.")}</p></section>
  <section id="versionen"><h2>{t("Versionen und Weiterverwendung.","Versions and reuse.")}</h2><p>{t("Website, Paket und öffentliches Projektprofil tragen dieselbe Projektversion. Ältere Kapitelnummern bezeichnen ihre ursprüngliche Entwurfsfassung. Inhalte und Software bleiben unter ihren bestehenden offenen Lizenzen und dokumentierten Ausnahmen nutzbar.","The website, package and public project profile share one project version. Older chapter numbers identify their original draft editions. Content and software remain reusable under their existing open licenses and documented exceptions.")}</p><p><a href={repo+"/blob/main/docs/versionsgeschichte.md"}>{t("Versionsgeschichte","Version history")} ↗</a> · <a href={repo+"/blob/main/LICENSING.md"}>{t("Lizenzen und Ausnahmen","Licenses and exceptions")} ↗</a> · <a href={base+"knowledge/claims.json"}>{t("Register als JSON","Register as JSON")} ↗</a></p></section>
</article>
</Layout>
