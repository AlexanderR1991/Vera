---
import {pathFor} from '../lib/paths.mjs';
const {lang='de'}=Astro.props;
const en=lang==='en';
---
<section class="section section--paper"><div class="narrow">
<p class="section-kicker">{en?'INTERACTIVE WORKSHOP':'INTERAKTIVE WERKSTATT'}</p>
<h2>{en?'Can a symbol become a testable question?':'Kann aus einem Symbol eine prüfbare Frage werden?'}</h2>
<p style="margin-top:24px">{en?'Build a model worksheet, explore 64 I Ching line patterns and compare predictions with a chance model. Analogies, formal statements and empirical hypotheses remain distinguishable.':'Erstelle ein Modell-Prüfblatt, erkunde 64 I-Ging-Linienmuster und vergleiche Vorhersagen mit einem Zufallsmodell. Analogien, formale Aussagen und empirische Hypothesen bleiben unterscheidbar.'}</p>
<a class="button button--gold" href={pathFor(lang,'esoterik-und-mathematik')}>{en?'Open the tools ↗':'Werkzeuge öffnen ↗'}</a>
</div></section>
