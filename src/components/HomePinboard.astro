---
import { pathFor } from "../lib/paths.mjs";

const { lang = "de" } = Astro.props;
const de = lang === "de";
const t = (german: string, english: string) => de ? german : english;
const ownQuestion = t("#frag-mich", "#ask-me");

const pins = [
  {
    id: "family",
    question: t("Wir wollen beide das Beste für unser Kind. Warum streiten wir dann?", "We both want what’s best for our child. Why are we arguing?"),
    kind: t("Gesprächsfrage", "Conversation starter"),
    action: t(
      "Wenn ihr beide reden möchtet, nehmt einen konkreten Vorschlag. Frag „Was befürchtest du, wenn wir es so machen, wie ich es vorschlage?“ Sag anschließend, was du bei der anderen Lösung befürchtest. Vielleicht braucht ihr erst einmal eine Antwort auf diese Sorgen.",
      "If you both want to talk, pick one specific proposal. Ask, “What are you worried might happen if we do it my way?” Then share what worries you about their proposal. Those concerns might be the first thing you need to address."
    ),
    link: t("Ein Gespräch zu zweit ausprobieren", "Try a two-person conversation"),
    href: pathFor(lang, "schnittmengen", "vermittlung"),
  },
  {
    id: "numbers",
    question: t("Die Zahlen überzeugen mich. Warum habe ich trotzdem Angst?", "The numbers convince me. Why am I still afraid?"),
    kind: t("Fragen zum Nachdenken", "Reflection exercise"),
    action: t(
      "Ergänze schriftlich zwei Sätze. „Die Zahlen beziehen sich auf …“ und „Ich fürchte, dass mir … passiert.“ Prüfe, ob die Zahlen genau dieses Ereignis, Menschen in deiner Lage und einen passenden Zeitraum erfassen. Welche konkrete Frage bleibt für dich offen?",
      "Complete these two sentences in writing. “These numbers are about …” and “I’m afraid that … will happen to me.” Check whether the figures cover that specific outcome, people in your situation and a relevant time span. What specific question is still open for you?"
    ),
    link: t("Eine Aussage im Prüfblatt untersuchen", "Examine a claim in the worksheet"),
    href: pathFor(lang, "werkstatt"),
  },
  {
    id: "sign",
    question: t("Dieses Zeichen hat mir Mut gemacht. Was bedeutet es für mich?", "This sign gave me courage. What does it mean to me?"),
    kind: t("Fragen zur eigenen Erfahrung", "Reflection on your experience"),
    action: t(
      "Was hast du wahrgenommen? Was hat dir daran Mut gemacht? Und was würdest du jetzt gern tun? Schreib die drei Antworten getrennt auf. Deine persönliche Deutung darf dir etwas bedeuten. Wenn du daraus eine Vorhersage ableitest, frag dich zusätzlich, woran du erkennen würdest, dass sie sich nicht erfüllt.",
      "What did you notice? What about it gave you courage? What would you like to do now? Write down the three answers separately. Your interpretation can matter to you. If you draw a prediction from it, also ask what would show you that the prediction hadn’t come true."
    ),
    link: t("Erfahrung und Vorhersage getrennt prüfen", "Examine experience and predictions separately"),
    href: pathFor(lang, "esoterik-katalog", "pruefwege"),
  },
  {
    id: "rent",
    question: t("Wir teilen die Miete durch zwei. Fühlt sich das für uns beide fair an?", "We split the rent down the middle. Does that feel fair to both of us?"),
    kind: t("Rechenbeispiel", "Worked example"),
    action: t(
      "Bei 900 € Miete zahlt ihr halbiert je 450 €. Verdient eine Person doppelt so viel wie die andere, wären es bei gleichem Anteil am Einkommen 600 € und 300 €. Rechnet beide Varianten mit euren Zahlen durch. Welche Lösung könntest du mittragen, wenn ihr die Einkommen tauschen würdet?",
      "Split €900 in half and you pay €450 each. If one person earns twice as much, paying the same share of your incomes works out to €600 and €300. Try both with your own figures. Which split could you live with if your incomes were the other way round?"
    ),
    link: t("Besprechen, was für euch fair heißt", "Talk through what fair means to you"),
    href: pathFor(lang, "schnittmengen", "sprachprobe"),
  },
  {
    id: "food",
    question: t("Darf ich genießen, was ich esse, wenn mir Tierwohl wichtig ist?", "Can I enjoy what I eat if I care about animal welfare?"),
    kind: t("Frage zu deinen Werten", "Values exercise"),
    action: t(
      "Nimm eine Mahlzeit, auf die du dich freust. Frag dich, was du daran genießt und welche Folge für Tiere dir dabei Sorgen macht. Welche Information über die Herkunft oder Haltung würde deine Wahl ändern? Such für diese eine Mahlzeit danach.",
      "Pick a meal you look forward to. Ask what you enjoy about it and what consequence for animals worries you. What could you learn about where the food came from or how the animals were raised that would change your choice? Look for that information for this one meal."
    ),
    link: t("Zielkonflikte beim Essen genauer ansehen", "Explore the trade-offs behind food choices"),
    href: pathFor(lang, "ernaehrung-und-verantwortung", "konflikte"),
  },
  {
    id: "vaccination",
    question: t("Wie rede ich übers Impfen mit jemandem, dem ich längst nicht mehr zuhöre?", "How do I talk about vaccination with someone I’ve stopped listening to?"),
    kind: t("Gesprächsfrage mit Quellen", "Conversation starter with sources"),
    action: t(
      "Wenn ihr beide darüber sprechen wollt, frag „Welche konkrete Sorge sollen wir uns zusammen ansehen?“ Wiederhole sie in deinen Worten und frag, ob du sie richtig verstanden hast. Geht es um eine überprüfbare Aussage, haltet fest, um welche Impfung, welche Personengruppe und welche Folge es geht.",
      "If you both want to talk, ask, “Which specific concern should we look at together?” Repeat it in your own words and check that you understood. For a claim you can verify, write down which vaccine, group of people and outcome it concerns."
    ),
    link: t("Eine medizinische Behauptung prüfen", "Examine a medical claim"),
    href: pathFor(lang, "medizin", "pruefen"),
    source: de
      ? { text: "Impfungen und Sicherheit bei gesund.bund.de", href: "https://gesund.bund.de/impfungen" }
      : { text: "Vaccine safety questions from the WHO", href: "https://www.who.int/news-room/questions-and-answers/item/vaccines-and-immunization-vaccine-safety" },
  },
];
---
<section class="home-pinboard" id={de ? "leben" : "life"} aria-labelledby="pinboard-heading">
  <div class="container home-pinboard__inner">
    <header class="home-pinboard__heading">
      <div>
        <h2 id="pinboard-heading">{t("Pinnwand", "Pinboard")}</h2>
        <p>{t("Womit möchtest du anfangen?", "Where would you like to start?")}</p>
      </div>
      <a class="home-pinboard__own" href={ownQuestion}>
        {t("Mich beschäftigt etwas anderes", "Something else is on my mind")} <span aria-hidden="true">↓</span>
      </a>
    </header>
    <div class="home-pinboard__grid">
      {pins.map(pin => (
        <details class="home-pin" id={"pin-" + pin.id} data-home-card={pin.id}>
          <summary>
            <span class:list={["home-pin__art", "home-pin__art--" + pin.id]} aria-hidden="true">
              <svg viewBox="0 0 176 108" focusable="false" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                {pin.id === "family" && <>
                  <path d="M36 43a18 18 0 1 1 31 12c-9 8-15 16-15 27M140 43a18 18 0 1 0-31 12c9 8 15 16 15 27" />
                  <path d="M65 86c4-15 12-21 23-21s19 6 23 21" opacity=".75" />
                  <circle cx="88" cy="52" r="9" fill="currentColor" fill-opacity=".1" />
                  <path d="M28 89h120" opacity=".26" />
                  <circle cx="88" cy="89" r="1.4" fill="currentColor" />
                </>}
                {pin.id === "numbers" && <>
                  <path d="M35 23v63h108M35 69h106M35 52h106M35 35h106M58 23v63m24-63v63m24-63v63m24-63v63" opacity=".28" />
                  <path d="m42 72 23-7 18-14 20 4 16-16 18-8" />
                  <path d="M42 74c13 4 27 4 40-2 11-5 14-28 27-25 9 2 11 25 26 18" stroke-dasharray="2.5 3.5" opacity=".78" />
                  <circle cx="119" cy="39" r="3.2" fill="currentColor" />
                </>}
                {pin.id === "sign" && <>
                  <path d="M88 16 99 42l28 12-28 11-11 27-11-27-28-11 28-12Z" fill="currentColor" fill-opacity=".07" />
                  <circle cx="88" cy="54" r="32" opacity=".28" />
                  <path d="M88 38v32M72 54h32M42 34v10m-5-5h10m86 27v10m-5-5h10" opacity=".67" />
                  <circle cx="88" cy="54" r="2.6" fill="currentColor" />
                </>}
                {pin.id === "rent" && <>
                  <path d="m61 43 27-21 27 21v37H61V43Z" fill="currentColor" fill-opacity=".05" />
                  <path d="M49 80h78M88 44v36M70 54h9m18 0h9M70 61h9m18 0h9M70 68h9" />
                  <path d="M35 38v43m-4-43h8m-8 43h8m102-43v43m-4-43h8m-8 43h8" opacity=".38" />
                  <circle cx="88" cy="36" r="1.5" fill="currentColor" />
                </>}
                {pin.id === "food" && <>
                  <circle cx="84" cy="54" r="34" />
                  <circle cx="84" cy="54" r="26" opacity=".35" />
                  <path d="M75 70c3-13 11-25 22-33m-13 15c-2-11 4-18 19-21-1 12-7 19-19 21Zm-5 10c-1-9-7-13-16-13 3 10 8 14 16 13Z" fill="currentColor" fill-opacity=".09" />
                  <path d="M135 24v61m-5-61v18a5 5 0 0 0 10 0V24" opacity=".73" />
                </>}
                {pin.id === "vaccination" && <>
                  <path d="M35 30h64a7 7 0 0 1 7 7v20a7 7 0 0 1-7 7H57L43 76V64h-8a7 7 0 0 1-7-7V37a7 7 0 0 1 7-7Z" fill="currentColor" fill-opacity=".08" />
                  <path d="M115 44h25a7 7 0 0 1 7 7v20a7 7 0 0 1-7 7h-8v12l-14-12H83a7 7 0 0 1-7-7" opacity=".7" />
                  <path d="M67 39v16m-8-8h16" stroke-width="1.6" />
                  <path d="M114 60h16m-16 6h9" opacity=".58" />
                </>}
              </svg>
            </span>
            <span class="home-pin__question">{pin.question}</span>
            <span class="home-pin__toggle" aria-hidden="true"></span>
          </summary>
          <div class="home-pin__reply">
            <p class="home-pin__kind">{pin.kind}</p>
            <p class="home-pin__action">{pin.action}</p>
            <a href={pin.href}>{pin.link} <span aria-hidden="true">↗</span></a>
            {pin.source && <a href={pin.source.href}>{pin.source.text} <span aria-hidden="true">↗</span></a>}
            <a class="home-pin__correct" href={ownQuestion}>
              {t("Das trifft meinen Konflikt nicht", "This doesn’t fit my situation")} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .home-pinboard {
    --pin-ink: #292b26;
    --pin-muted: #575b50;
    --pin-border: #cfc8b9;
    --pin-link: #344e44;
    color: var(--pin-ink);
    padding-block: clamp(1.8rem, 5vw, 4.75rem) clamp(2.5rem, 6vw, 5rem);
    scroll-margin-top: 5rem;
  }

  .home-pinboard__inner { max-width: 72rem; }
  .home-pinboard__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: .5rem 1.25rem;
    margin-block-end: 1rem;
  }
  .home-pinboard__heading h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.35rem);
    font-weight: 590;
    letter-spacing: -.065em;
    line-height: 1.04;
  }
  .home-pinboard__heading p { margin: .35rem 0 0; color: var(--pin-muted); }
  .home-pinboard__own, .home-pin__reply a {
    display: inline-flex;
    align-items: center;
    gap: .45em;
    min-height: 44px;
    width: fit-content;
    color: var(--pin-link);
    text-decoration: underline;
    text-underline-offset: .25em;
  }
  .home-pinboard__own { font-weight: 650; }

  .home-pinboard__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(.6rem, 2vw, 1.25rem);
  }
  .home-pin {
    --pin-art-paper: #e9e9dd;
    --pin-art-ink: #53614f;
    --pin-art-height: 8.5rem;
    margin: 0;
    border: 1px solid var(--pin-border);
    background: #fdfbf5;
    color: var(--pin-ink);
    scroll-margin-top: 5rem;
  }
  .home-pin summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    align-items: start;
    gap: .8rem .55rem;
    padding: .65rem;
    cursor: pointer;
    list-style: none;
  }
  .home-pin summary::-webkit-details-marker { display: none; }
  .home-pin summary:hover, .home-pin[open] summary { background: #f4f0e5; }
  .home-pin summary:focus-visible, .home-pinboard a:focus-visible { outline: 2px solid var(--pin-link); outline-offset: 3px; }

  .home-pin__art {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    min-width: 0;
    height: var(--pin-art-height);
    overflow: hidden;
    background: var(--pin-art-paper);
    color: var(--pin-art-ink);
  }
  .home-pin__art svg { display: block; width: 100%; height: 100%; }
  .home-pin__art--family { --pin-art-height: 9.5rem; }
  .home-pin__art--numbers { --pin-art-paper: #e5e9e9; --pin-art-ink: #425a66; --pin-art-height: 7.2rem; }
  .home-pin__art--sign { --pin-art-paper: #eee4d6; --pin-art-ink: #765742; --pin-art-height: 8.5rem; }
  .home-pin__art--rent { --pin-art-paper: #ebe5da; --pin-art-ink: #665644; --pin-art-height: 7.2rem; }
  .home-pin__art--food { --pin-art-paper: #e6ebdf; --pin-art-ink: #4d6049; --pin-art-height: 8.5rem; }
  .home-pin__art--vaccination { --pin-art-paper: #e8e7ed; --pin-art-ink: #5a556e; --pin-art-height: 9.5rem; }

  .home-pin__question { font-size: clamp(1rem, 1.45vw, 1.15rem); font-weight: 620; line-height: 1.32; }
  .home-pin__toggle { display: grid; place-items: center; min-height: 1.35rem; color: var(--pin-link); }
  .home-pin__toggle::before, .home-pin__toggle::after {
    grid-area: 1 / 1;
    width: .75rem;
    height: 1px;
    background: currentColor;
    content: "";
  }
  .home-pin__toggle::after { transform: rotate(90deg); }
  .home-pin[open] .home-pin__toggle::after { display: none; }

  .home-pin__reply { padding: 1rem .9rem .6rem; border-top: 1px solid var(--pin-border); }
  .home-pin__kind { margin: 0 0 .4rem; color: var(--pin-muted); font-size: .85rem; font-weight: 650; }
  .home-pin__action { margin: 0 0 .5rem; color: var(--pin-ink); line-height: 1.55; }
  .home-pin__reply a { display: flex; font-size: .9rem; }
  .home-pin__reply a:hover, .home-pinboard__own:hover { color: var(--pin-ink); text-decoration-thickness: 2px; }
  .home-pin__correct { border-top: 1px solid var(--pin-border); }

  @media (max-width: 52rem) {
    .home-pinboard__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 33rem) {
    .home-pinboard__grid { grid-template-columns: minmax(0, 1fr); }
    .home-pin summary {
      grid-template-columns: clamp(4.8rem, 25vw, 7.5rem) minmax(0, 1fr) 1.25rem;
      align-items: center;
    }
    .home-pin__art { grid-column: 1; height: min(var(--pin-art-height), 5.15rem); }
    .home-pin__art--numbers, .home-pin__art--rent { height: 4.65rem; }
    .home-pin__art svg { width: 118%; max-width: none; }
  }
</style>
