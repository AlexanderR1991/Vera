---
import Layout from "../layouts/SiteLayout.astro";
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const de=lang==="de";
const repo="https://github.com/AlexanderR1991/Wirklich";
---
<Layout lang={lang} slug="angriffsschwarm">
  <section class="section attack-hero">
    <div class="container">
      <p class="section-kicker">EXAMEN / ADVERSARIA / EVOLUTIO</p>
      <h1>{de?"Der Angriffsschwarm":"The Adversarial Swarm"}</h1>
      <p class="attack-intro">{de
        ?"Wir laden Gegenargumente ein. Eine gute Widerlegung macht unser Werk besser — auch wenn eine liebgewonnene These fallen muss."
        :"We invite counterarguments. A sound refutation improves this work — even when a cherished claim must be abandoned."}</p>
      <p class="attack-motto">{de
        ?"NICHT DAS WERK MUSS GEWINNEN. DIE WAHRHEIT MUSS GEWINNEN."
        :"THE WORK NEED NOT WIN. TRUTH MUST WIN."}</p>
      <div class="attack-links">
        <a href={pathFor(lang,"gegenprobe-01")}>{de?"Gegenprobe 01 mit der eigenen KI starten →":"Try challenge 01 with your own AI →"}</a>
        <a href={repo+"/issues/new?template=angriff.yml"} target="_blank" rel="noopener noreferrer">{de?"These angreifen ↗":"Challenge a claim ↗"}</a>
        <a href={repo+"/blob/main/AGENTS.md"} target="_blank" rel="noopener noreferrer">{de?"Einladung an KI-Agenten ↗":"Invitation to AI agents ↗"}</a>
        <a href={repo+"/blob/main/docs/angriffsschwarm.md"} target="_blank" rel="noopener noreferrer">{de?"Prüfverfahren ↗":"Review protocol ↗"}</a>
      </div>
    </div>
  </section>
  <section class="section section--paper">
    <div class="container">
      <p class="section-kicker">{de?"ÖFFENTLICHES FEHLERPROTOKOLL":"PUBLIC CHALLENGE LOG"}</p>
      <h2>{de?"Die Einwände":"The objections"}</h2>
      <p>{de
        ?"Alle drei KI-Rollen arbeiten mit demselben Modell. Ihre Entwürfe geben Menschen einen konkreten Einwand zur Prüfung."
        :"All three AI roles use the same model. Their drafts give people a specific objection to examine."}</p>
      <details>
        <summary>{de?"Woran erkenne ich einen berechtigten Einwand?":"How can I tell whether an objection holds?"}</summary>
        <p>{de
          ?"Lies die angegriffene Stelle in ihrer ursprünglichen Fassung. Trifft der Einwand ihre Voraussetzungen? Prüfe einen behaupteten Fehler an der Quelle oder rechne den Schritt nach. Geht es um einen Wert oder eine Deutung, zeige, welche Perspektive fehlt oder wo zwei begründete Lesarten auseinandergehen."
          :"Read the challenged passage in its original version. Does the objection address its assumptions? Check a disputed finding against its source or work through the inference. For a value or interpretation, identify a missing perspective or show where two reasoned readings diverge."}</p>
        <p>{de
          ?"Halte im Issue oder Pull Request den Einwand, die Textfassung, deine Gründe und die Folge fest. Das Ergebnis kann „berechtigt“, „unbegründet“ oder „offen“ lauten. Ein behaupteter Fehler, der sich bei der Prüfung als Fehllesung erweist, zählt als Fehlalarm."
          :"In an issue or pull request, record the objection, text version, reasons and consequence. The outcome can be upheld, rejected or open. An alleged error that turns out to be a misreading counts as a false alarm."} <a href={repo+"/blob/main/docs/angriffsschwarm.md"}>{de?"Ein Beispiel durchgehen":"Work through an example"} ↗</a></p>
      </details>
      <div id="attack-live" data-lang={lang} aria-live="polite">
        <p id="attack-status">{de?"Prüfarchiv wird geladen …":"Loading challenge archive …"}</p>
        <p id="attack-meta"></p>
        <div id="attack-cards" class="attack-cards"></div>
      </div>
      <noscript><p>{de?"Das Prüfarchiv benötigt JavaScript. Die gespeicherten Entwürfe kannst du direkt öffnen:":"The challenge archive needs JavaScript. You can open the stored drafts directly:"} <a href="https://raw.githubusercontent.com/AlexanderR1991/Wirklich/main/public/research/angriffe.json">JSON ↗</a></p></noscript>
    </div>
  </section>
  <script is:inline>
    (() => {
      const root=document.getElementById("attack-live");
      if (!root) return;
      const de=root.dataset.lang==="de";
      const status=document.getElementById("attack-status");
      const meta=document.getElementById("attack-meta");
      const cards=document.getElementById("attack-cards");
      const endpoint="https://raw.githubusercontent.com/AlexanderR1991/Wirklich/main/public/research/angriffe.json";
      const text=(tag,value,css)=>{
        const e=document.createElement(tag);
        e.textContent=String(value??"");
        if(css)e.className=css;
        return e;
      };
      const sections=[
        ["adversary",de?"ANGRIFF":"ATTACK",[
          ["steelman",de?"Stärkste faire Lesart":"Charitable reading"],
          ["objection",de?"Einwand":"Objection"],
          ["counterexample",de?"Gegenbeispiel":"Counterexample"],
          ["test",de?"Entscheidender Test":"Discriminating test"],
          ["uncertainty",de?"Unsicherheit":"Uncertainty"]
        ]],
        ["defender",de?"VERTEIDIGUNG":"DEFENSE",[
          ["response",de?"Antwort":"Response"],
          ["concessions",de?"Zugeständnisse":"Concessions"],
          ["revision",de?"Mögliche Revision":"Potential revision"]
        ]],
        ["assessor",de?"KRITISCHE EINORDNUNG":"CRITICAL ASSESSMENT",[
          ["disposition",de?"Vorläufige Einordnung":"Provisional category"],
          ["reason",de?"Begründung":"Reasoning"],
          ["unresolved",de?"Offene Punkte":"Unresolved"],
          ["next_check",de?"Nächste unabhängige Prüfung":"Next independent check"]
        ]]
      ];
      const statusLabels={
        plausible_challenge:de?"Einwand plausibel":"Plausible challenge",
        insufficient_challenge:de?"Einwand bisher nicht ausreichend":"Insufficient challenge so far",
        needs_evidence:de?"Benötigt externe Belege":"Needs external evidence",
        conceptual_disagreement:de?"Begrifflicher oder normativer Dissens":"Conceptual / normative disagreement"
      };
      fetch(endpoint,{cache:"no-store"}).then(r=>{
        if(!r.ok)throw Error("HTTP "+r.status);
        return r.json();
      }).then(data=>{
        if(!Array.isArray(data.items))throw Error("Invalid challenge archive");
        status.textContent=de
          ?"Status: ungeprüfte KI-Einwände – keine bestätigten Widerlegungen"
          :"Status: unverified AI objections – no certified refutations";
        const when=data.updated_at?new Date(data.updated_at).toLocaleString(de?"de-DE":"en-GB"):
          (de?"nicht dokumentiert":"not recorded");
        meta.textContent=(de?"Datenstand: ":"Archive updated: ")+when+" · "+
          data.items.length+(de?" Fälle":" cases")+
          " · "+(data.agents_enabled?(de?"Archiv enthält KI-Entwürfe":"Archive contains AI drafts"):
            (de?"Keine KI-Ergebnisse ausgewiesen":"No AI results reported"));
        if(!data.items.length){
          cards.append(text("p",de
            ?"Das öffentliche Archiv enthält derzeit keine Prüfentwürfe."
            :"The public archive currently contains no review drafts."));
        }
        for(const item of data.items.slice(0,40)){
          const article=document.createElement("article");
          article.className="attack-card";
          article.append(text("p",de?"UNGEPRÜFTER ENTWURF":"UNVERIFIED DRAFT","attack-tag"));
          article.append(text("h3",item.heading||item.id||"Claim"));
          const src=String(item.source||"");
          const link=document.createElement("a");
          if(/^docs\/[\w./-]+\.md$/.test(src) && !src.includes("..")){
            const revision=String(item.source_commit||"");
            const pinned=/^[0-9a-f]{40}$/i.test(revision);
            link.href="https://github.com/AlexanderR1991/Wirklich/blob/"+(pinned?revision:"main")+"/"+src;
            link.target="_blank"; link.rel="noopener noreferrer";
            link.textContent=pinned
              ? (de?"Untersuchte Textfassung ↗":"Examined text version ↗")
              : (de?"Aktueller Text (ursprüngliche Fassung nicht belegt) ↗":"Current text (original version unrecorded) ↗");
            article.append(link);
            article.append(text("p",pinned
              ? (de?"Textfassung: ":"Source revision: ")+revision.slice(0,12)
              : (de?"Dieser Entwurf ist keiner belegten Textfassung zugeordnet.":"This draft is not linked to a recorded text version.")));
          }
          if(item.excerpt)article.append(text("p",item.excerpt,"attack-excerpt"));
          for(const [key,heading,fields] of sections){
            const section=item[key];
            if(!section||typeof section!=="object")continue;
            article.append(text("h4",heading));
            for(const [field,label] of fields){
              const val=section[field];
              if(typeof val!=="string"||!val)continue;
              const p=document.createElement("p");
              p.append(text("strong",label+": "));
              p.append(document.createTextNode(
                field==="disposition"?(statusLabels[val]||val):val));
              article.append(p);
            }
          }
          cards.append(article);
        }
      }).catch(()=>{
        status.textContent=de
          ?"Das öffentliche Prüfarchiv ist derzeit nicht abrufbar."
          :"The public challenge archive is currently unavailable.";
        meta.textContent="";
      });
    })();
  </script>
</Layout>
<style is:global>
  .attack-hero{padding-block:6rem 4rem}
  .attack-hero h1{font-size:clamp(2.6rem,7vw,5.8rem);line-height:1.08;max-width:20ch}
  .attack-intro{max-width:48rem;font-size:clamp(1.15rem,2.1vw,1.5rem)}
  .attack-motto{font-size:.9rem;letter-spacing:.12em;margin-top:2rem;border-top:1px solid currentColor;padding-top:1.25rem}
  .attack-links{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:1.5rem}
  #attack-meta{font-size:.9rem;opacity:.75;margin:1.2rem 0 2rem}
  .attack-cards{display:grid;gap:1.5rem}
  .attack-card{border:1px solid rgba(130,116,92,.35);padding:clamp(1rem,3vw,2rem)}
  .attack-card h3{font-size:clamp(1.25rem,2.5vw,1.75rem);overflow-wrap:anywhere}
  .attack-card h4{font-size:.9rem;letter-spacing:.12em;margin:1.5rem 0 .6rem}
  .attack-card p{line-height:1.6;overflow-wrap:anywhere}
  .attack-tag{font-size:.75rem;letter-spacing:.1em}
  .attack-excerpt{white-space:pre-line;opacity:.85;margin-top:1rem}
  .attack-card a{display:inline-block;margin:.35rem 0}
</style>
