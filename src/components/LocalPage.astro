---
import Layout from "../layouts/SiteLayout.astro";
import HorizonTeaser from "./HorizonTeaser.astro";
import LoveTeaser from "./LoveTeaser.astro";
import PolicyTeaser from "./PolicyTeaser.astro";
import {getPage} from "../lib/pages.mjs";
const {lang,slug}=Astro.props;
const content=getPage(lang,slug);

// Shared editorial placements apply to both languages.
// They avoid duplicating a different teaser in every translated HTML file.
const anchors={
  horizon:{
    index:['<section class="section section--paper" id="felder">',"first"],
    atlas:['<section class="section"><div class="narrow text-center">',"last"],
    bibliothek:['<section class="section section--paper">',"last"],
    methode:['<section class="section section--paper">',"last"]
  },
  love:{
    index:['<section class="closing">',"last"],
    atlas:['<section class="section"><div class="narrow text-center">',"last"],
    bibliothek:['<section class="section"><div class="container"><div class="section-heading">',"first"],
    pruefstand:['<section class="section"><div class="narrow text-center">',"last"]
  },
  politics:{
    index:['<section class="closing">',"last"],
    atlas:['<section class="section"><div class="narrow text-center">',"last"],
    bibliothek:['<section class="section section--paper">',"last"],
    pruefstand:['<section class="section"><div class="narrow text-center">',"last"]
  }
};
const insertions=[];
const priority={horizon:0,love:1,politics:2};
for(const kind of ["horizon","love","politics"]){
 const config=anchors[kind][slug];
 if(!config)continue;
 const [marker,position]=config;
 const at=position==="last"?content.lastIndexOf(marker):content.indexOf(marker);
 if(at<0)throw Error("Missing editorial placement for "+kind+" on "+slug);
 insertions.push({kind,at});
}
insertions.sort((a,b)=>a.at-b.at||priority[a.kind]-priority[b.kind]);
const segments=[];let position=0;
for(const insertion of insertions){
 segments.push({kind:"html",body:content.slice(position,insertion.at)});
 segments.push({kind:insertion.kind});
 position=insertion.at;
}
segments.push({kind:"html",body:content.slice(position)});
---
<Layout lang={lang} slug={slug}>
{segments.map(part=>
 part.kind==="html"?<Fragment set:html={part.body}/>:
 part.kind==="horizon"?<HorizonTeaser lang={lang} from={slug}/>:
 part.kind==="love"?<LoveTeaser lang={lang} from={slug}/>:
 <PolicyTeaser lang={lang} from={slug}/>
)}
</Layout>