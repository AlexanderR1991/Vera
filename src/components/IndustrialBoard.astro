---
import {base,pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import BoardArtwork from "./BoardArtwork.astro";
import artWorks from "../../public/knowledge/art-works.v1.json";
const {lang="de"}=Astro.props;
const de=lang==="de";
const wave=artWorks.works.find(work=>work.id==="art-01");
const cards=[
  {
    id:"nutrition", art:"nutrition", route:"ernaehrung-und-verantwortung",
    category:{de:"Ernährung",en:"Nutrition"},
    title:{de:"Was heißt gut essen?",en:"What does it mean to eat well?"},
    description:{de:"Was dein Körper braucht, was du dir leisten kannst und was dir wichtig ist.",en:"What your body needs, what you can afford, and what matters to you."},
    keywords:"essen lebensmittel tierwohl gesundheit kosten food animal welfare health budget"
  },
  {
    id:"politics", art:"politics", route:"politik-die-dem-menschen-dient",
    category:{de:"Politik",en:"Politics"},
    title:{de:"Wem dient eine politische Entscheidung?",en:"Who does a political decision serve?"},
    description:{de:"Schau darauf, wer mitentscheidet und wer die Folgen trägt.",en:"Look at who gets a say and who lives with the consequences."},
    keywords:"gesellschaft demokratie mitbestimmung rechte staat democracy rights government participation"
  },
  {id:"conversation",route:"schnittmengen",anchor:{de:"sprachprobe",en:"sprachprobe"},category:{de:"Am Küchentisch",en:"At the kitchen table"},title:{de:"Teilen wir die Miete durch zwei?",en:"Should we split the rent in half?"},description:{de:"Ein Gehalt ist doppelt so hoch wie das andere. Ihr wollt beide fair teilen. Was bedeutet das für jeden von euch?",en:"One of you earns twice as much as the other. You both want to be fair. What does that mean to each of you?"},action:{de:"Gespräch zu zweit ausprobieren",en:"Try the conversation together"},keywords:"gespräch streit konflikt zuhören miete fairness mediation conversation rent disagreement listening"},
  {id:"first-step",route:"index",anchor:{de:"erkenntnis",en:"insight"},category:{de:"Erkenntnis · Ausprobieren",en:"Insight · Try it"},title:{de:"Wie entscheidet Vera?",en:"How does Vera decide?"},description:{de:"Eine neue Seite soll online gehen. Welchen Test würdest du zuerst machen? Vergleiche deine Wahl mit Veras Modell.",en:"A new page is about to go live. What would you check first? Compare your choice with Vera’s model."},action:{de:"Modell ausprobieren",en:"Try the model"},keywords:"einstieg start erkenntnis entscheidung belege insight decision evidence"},
  {id:"everyday",route:"forum",anchor:{de:"alltagsfragen",en:"alltagsfragen"},category:{de:"Aus dem Alltag",en:"Everyday life"},title:{de:"Was beschäftigt dich?",en:"What’s on your mind?"},description:{de:"Muss ich bleiben, wenn ich jemanden liebe? Hier findest du einen ersten Gedanken dazu und einen guten Grund, weiterzufragen.",en:"Do I have to stay if I love someone? Read one possible answer and a question that might change how you see it."},action:{de:"Alltagsfragen lesen",en:"Read everyday questions"},keywords:"liebe arbeit ernährung food work love beziehung"},
  {id:"art",route:"kunst-und-erkenntnis",anchor:{de:"sammlung",en:"sammlung"},category:{de:"Liber Artis · Kunst",en:"Liber Artis · Art"},title:{de:"Wohin schaust du zuerst?",en:"Where does your eye go first?"},description:{de:"Unter Hokusais großer Welle ducken sich Menschen in ihren Booten. Schau einen Moment lang nur auf sie. Wie wirkt die Welle jetzt?",en:"Beneath Hokusai’s great wave, people crouch in their boats. Look just at them for a moment. How does the wave feel now?"},action:{de:"Zur Kunstsammlung",en:"Explore the art collection"},keywords:"kunst art kunstwerk werk malerei musik literatur architektur painting music literature architecture"},
  {id:"military",route:"militaer-und-verantwortung",category:{de:"Liber Custodiae · Frieden",en:"Liber Custodiae · Peace"},title:{de:"Wer lebt neben dem Ziel?",en:"Who lives next to the target?"},description:{de:"Eine Armee soll Menschen schützen. In der Nähe ihres Ziels leben Familien. Was schuldet sie ihnen?",en:"An army has a duty to protect people. Families live near its target. What does it owe them?"},action:{de:"Zum Kapitel",en:"Read the chapter"},keywords:"militär military defence verteidigung frieden peace verantwortung schutz"},
  {id:"society",route:"politik-die-dem-menschen-dient",anchor:{de:"garten",en:"garten"},category:{de:"Gesellschaft",en:"Society"},title:{de:"Wem gehört der Garten?",en:"Whose garden is it?"},description:{de:"Ein Kind will Fußball spielen, eines Blumen pflanzen, eines lesen. Wie finden sie eine Regel für den Platz, den alle teilen?",en:"One child wants to play football, another to plant flowers, another to read. How can they decide what to do with the space they share?"},keywords:"politik rechte moral demokratie"},
  {id:"bridge",route:"die-bruecke",category:{de:"Die Brücke / M-02",en:"The Bridge / M-02"},title:{de:"Habe ich dich richtig verstanden?",en:"Have I understood you?"},description:{de:"Du kannst die Antwort eines Freundes genau vorhersagen und selbst anders denken. In diesem Modell kannst du beides ausprobieren.",en:"You might know exactly what a friend would say and still disagree. Try those two things side by side in the model."},keywords:"mathematik konsens beziehung dialog"},
  {id:"atlas",route:"atlas",category:{de:"Wissensatlas",en:"Knowledge atlas"},title:{de:"Wo fängt deine Frage an?",en:"Where does your question begin?"},description:{de:"Beim Körper, bei einem Gefühl, bei den Regeln, nach denen wir leben? Sechs Felder laden zum Weiterdenken ein.",en:"With your body, a feeling, or the rules we live by? Explore six ways into a question."},keywords:"wissensbaum erkenntnis felder thema knowledge map"},
  {id:"counterexample",route:"gegenprobe-01",category:{de:"Offene Gegenprobe",en:"Open challenge"},title:{de:"Entscheidest du das für mich?",en:"Would you decide for me?"},description:{de:"Ein Freund bittet dich darum. Wann wäre es fürsorglich, Ja zu sagen? An dieser Frage kannst du unsere Regel über Hilfe prüfen.",en:"A friend asks you to make a choice for them. When would saying yes be an act of care? Try our rule about helping against that case."},action:{de:"Gegenprobe öffnen",en:"Open the challenge"},keywords:"widerspruch einwand hilfe freiheit objection freedom"},
  {
    id:"medicine", art:"medicine", route:"medizin",
    category:{de:"Medizin",en:"Medicine"},
    title:{de:"Was sagt ein besserer Messwert aus?",en:"What does a better reading tell us?"},
    description:{de:"Prüfe an einem Fall, ob ein Messwert zeigt, dass es Menschen besser geht.",en:"Use a real case to ask whether a reading shows people are doing better."},
    keywords:"gesundheit studie evidenz behandlung health study evidence treatment"
  },
  {
    id:"religions", art:"religions", route:"bruecken-zwischen-den-religionen",
    category:{de:"Religionen",en:"Religions"},
    title:{de:"Was teilen wir, obwohl wir anders glauben?",en:"What do we share across different beliefs?"},
    description:{de:"Erkunde Gemeinsamkeiten und Unterschiede zwischen Weltanschauungen.",en:"Explore common ground and differences between worldviews."},
    keywords:"glaube religion ethik weltanschauung faith belief ethics worldview"
  },
  {
    id:"symbols", art:"symbols", route:"esoterik-katalog",
    category:{de:"Esoterik",en:"Esotericism"},
    title:{de:"Was bedeutet ein Zeichen für dich?",en:"What does a sign mean to you?"},
    description:{de:"Unterscheide persönliche Deutung und überprüfbare Vorhersage.",en:"Separate personal meaning from a prediction you can test."},
    keywords:"symbol tarot astrologie deutung symbol astrology interpretation"
  },
  {
    id:"dialogue", art:"dialogue", route:"schnittmengen", anchor:{de:"vermittlung",en:"vermittlung"},
    category:{de:"Vermittlung",en:"Mediation"},
    title:{de:"Was könnte unser Gespräch wieder öffnen?",en:"What could get us talking again?"},
    description:{de:"Probiert zu zweit, welche Änderung für euch einen Unterschied machen würde.",en:"Try together to find a change that would make a difference for both of you."},
    keywords:"streit konflikt gespräch zuhören disagreement conflict dialogue listening"
  },
  {
    id:"rules", art:"rules", route:"philosophischer-motor",
    category:{de:"Philosophischer Motor",en:"Philosophical engine"},
    title:{de:"Welche Gründe tragen deine Entscheidung?",en:"What reasons support your decision?"},
    description:{de:"Schau dir an, wie Vera Aussagen, Werte und Einwände auseinanderhält.",en:"See how Vera distinguishes claims, values and objections."},
    keywords:"regeln methode mathematik entscheidung models mathematics method rules"
  },
] as const;
const word=(v)=>v[lang];
---
<section class="industrial-board" id={de?"leben":"life"} aria-labelledby="board-title">
  <div class="container">
    <div class="board-heading">
      <div>
        <h2 id="board-title">{de?"Pinnwand":"Pinboard"}</h2>
        <p>{de?"Vielleicht kommt dir eine dieser Fragen bekannt vor. Fang dort an.":"Maybe one of these questions sounds familiar. Start there."}</p>
        <a class="home-link board-own" href={de?"#frag-mich":"#ask-me"}>
          {de?"Mich beschäftigt etwas anderes":"Something else is on my mind"} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="board-filter" data-board-filter-wrap>
        <label for="board-filter-input">{de?"Pinnwand durchsuchen":"Search the pinboard"}</label>
        <div class="board-filter__field">
          <svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <circle cx="8.6" cy="8.6" r="4.9" /><path d="m12.2 12.2 3.7 3.7" />
          </svg>
          <input id="board-filter-input" type="search" placeholder={de?"Ernährung, Politik, Kunst …":"Nutrition, politics, art …"} autocomplete="off" data-board-filter />
        </div>
        <span class="board-counter" data-board-counter aria-live="polite">{cards.length} {de?"Zugänge":"entries"}</span>
      </div>
    </div>
    <div class="board-grid" data-board-grid>
      {cards.map(card=><a class:list={["board-tile", "board-tile--"+card.id]}
        href={card.route==="index"?"#"+card.anchor[lang]:pathFor(lang,card.route,"anchor" in card?card.anchor[lang]:undefined)}
        aria-labelledby={"board-title-"+card.id} aria-describedby={"board-description-"+card.id}
        data-board-card={card.id}
        data-board-keywords={[word(card.category),word(card.title),word(card.description),"action" in card?word(card.action):"",card.keywords].join(" ")}>
        {"art" in card&&<BoardArtwork id={card.art}/>}
        {card.id==="conversation"&&
          <svg class="board-tile__art" data-board-art="table" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" stroke-linejoin="round">
              <path d="M42 28v-7a5 5 0 0 1 5-5h22a5 5 0 0 1 5 5v7M118 84v7a5 5 0 0 0 5 5h22a5 5 0 0 0 5-5v-7" opacity=".58"/>
              <rect x="21" y="28" width="150" height="56" rx="8" fill="currentColor" fill-opacity=".05"/>
              <g transform="rotate(-8 96 56)" opacity=".65">
                <rect x="85" y="42" width="22" height="28" rx="1"/>
                <path d="M90 49h12m-12 5h8m-8 7h12"/>
              </g>
              <g stroke-width="1.8" class="board-tile__ink">
                <circle cx="58" cy="47" r="10"/><path d="M48.5 44H46a3 3 0 0 0 0 6h2.5"/>
                <circle cx="133" cy="64" r="8"/><path d="M140.5 61H143a3 3 0 0 1 0 6h-2.5"/>
              </g>
              <circle cx="58" cy="47" r="7" opacity=".5"/><circle cx="133" cy="64" r="5" opacity=".5"/>
            </g>
          </svg>}
        {card.id==="first-step"&&
          <svg class="board-tile__art" data-board-art="graph" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M24 19H168M24 35H168M24 51H168M24 67H168M24 99H168M32 19V99M48 19V99M64 19V99M80 19V99M112 19V99M128 19V99M144 19V99M160 19V99" opacity=".18"/>
              <path d="M20 83H173M96 102V14" opacity=".55"/>
              <path class="board-tile__ink" d="M32 19Q96 147 160 19" stroke-width="1.6"/>
            </g>
            <circle cx="96" cy="83" r="2.5" fill="currentColor"/>
            <text x="116" y="98" fill="currentColor" font-family="monospace" font-size="7">y = x² / 4</text>
          </svg>}
        {card.id==="art"&&
          <img class="board-tile__art board-tile__art--image" data-board-art="wave" src={base+wave.image.path}
            width={wave.image.width} height={wave.image.height} alt={wave.image.alt[lang]} loading="lazy" decoding="async"/>}
        {card.id==="atlas"&&
          <svg class="board-tile__art" data-board-art="atlas" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" opacity=".48">
              <circle cx="96" cy="56" r="48"/><circle cx="96" cy="56" r="36"/><circle cx="96" cy="56" r="24"/>
              <path d="M32 56H160M96 6V106M58 18L134 94M134 18L58 94" stroke-dasharray="2 4"/>
            </g>
            <g fill="currentColor">
              <circle cx="96" cy="56" r="3"/><circle cx="96" cy="20" r="2.5"/><circle cx="132" cy="56" r="2.5"/>
              <circle cx="72" cy="56" r="2.5"/><circle cx="130" cy="90" r="2.5"/><circle cx="62" cy="22" r="2.5"/>
            </g>
          </svg>}
        {card.id==="bridge"&&
          <svg class="board-tile__art" data-board-art="bridge" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M14 83H178M45 30V91M147 30V91" opacity=".55"/>
              <path class="board-tile__ink" d="M14 44H33L45 37Q96 99 147 37L159 44H178" stroke-width="1.6"/>
              <path d="M62 54V83M79 64V83M96 68V83M113 64V83M130 54V83M14 92H178" opacity=".6"/>
            </g>
            <g fill="currentColor"><circle cx="45" cy="37" r="2.5"/><circle cx="147" cy="37" r="2.5"/></g>
          </svg>}
        {card.id==="military"&&
          <svg class="board-tile__art" data-board-art="custodiae" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M27 28V20H39M153 20H165V28M165 84V92H153M39 92H27V84M27 56H165M96 11V101" opacity=".36"/>
              <path class="board-tile__ink" d="M96 13 139 56 96 99 53 56Z" stroke-width="1.6"/>
              <path d="M96 19 133 56 96 93 59 56Z" opacity=".5"/>
              <path d="M96 35 111 41 110 58Q108 69 96 76Q84 69 82 58L81 41Z" stroke-width="1.4"/>
              <path d="m89 55 5 6 10-12" stroke-width="1.5"/>
            </g>
          </svg>}
        <div class="board-tile__caption">
          <div class="board-tile__top">
            <span>{word(card.category)}</span>
            <span class="board-tile__arrow" aria-hidden="true">{card.route==="index"?"↓":"↗"}</span>
          </div>
          <h3 id={"board-title-"+card.id}>{word(card.title)}</h3>
          <p id={"board-description-"+card.id}>{word(card.description)}</p>
        </div>
      </a>)}
    </div>
    <p class="board-empty" data-board-empty hidden>{de?"Keine passende Kachel. Bitte einen anderen Begriff versuchen.":"No matching tile. Try another term."}</p>
    <div class="board-source">
      <p>{de?"Hast du etwas gesucht und nicht gefunden? Sag mir, was dir hier fehlt.":"Were you looking for something you couldn’t find? Tell me what’s missing."}</p>
      <a class="home-link" href={pathFor(lang,"mitwirken","rueckmeldung")}>{ui[lang].feedbackInvitation} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
