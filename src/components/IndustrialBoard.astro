---
import {base,pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import artWorks from "../../public/knowledge/art-works.v1.json";
const {lang="de"}=Astro.props;
const de=lang==="de";
const wave=artWorks.works.find(work=>work.id==="art-01");
const cards=[
  {id:"first-step",route:"index",anchor:{de:"erkenntnis",en:"insight"},category:{de:"Erkenntnis · Ausprobieren",en:"Insight · Try it"},title:{de:"Wie entscheidet Vera?",en:"How does Vera decide?"},description:{de:"Gib eine Beobachtung ein. Vera zeigt, was möglich bleibt und welchen Test sie als Nächstes wählt.",en:"Enter an observation. Vera shows what remains possible and which test she chooses next."},action:{de:"Modell ausprobieren",en:"Try the model"},keywords:"einstieg start erkenntnis entscheidung belege insight decision evidence"},
  {id:"everyday",route:"forum",anchor:{de:"alltagsfragen",en:"alltagsfragen"},category:{de:"Aus dem Alltag",en:"Everyday life"},title:{de:"Was beschäftigt dich?",en:"What’s on your mind?"},description:{de:"Liebe, Arbeit, Ernährung. Zu jeder Frage gibt es eine erste Antwort und einen Einwand.",en:"Love, work, food. Each question comes with a first answer and an objection."},action:{de:"Alltagsfragen lesen",en:"Read everyday questions"},keywords:"liebe arbeit ernährung food work love beziehung"},
  {id:"personal-practice",route:"index",anchor:{de:"eigene-frage",en:"your-question"},category:{de:"Deine Frage",en:"Your question"},title:{de:"Ich habe eine eigene Frage.",en:"I have a question of my own."},description:{de:"Sortiere eine Situation in drei Schritten. Du kannst direkt hier anfangen.",en:"Sort through a situation in three steps. You can start right here."},action:{de:"Eigene Frage prüfen",en:"Work through a question"},keywords:"werkstatt prüfen vorlage export"},
  {id:"art",route:"kunst-und-erkenntnis",anchor:{de:"sammlung",en:"sammlung"},category:{de:"Liber Artis · Kunst",en:"Liber Artis · Art"},title:{de:"Was kann ein Werk uns zeigen?",en:"What can a work show us?"},description:{de:"Schau, hör oder lies. Entdecke eine Lesart und prüfe, was Vera daraus lernen könnte.",en:"Look, listen or read. Explore a reading and test what Vera could learn from it."},action:{de:"Zur Kunstsammlung",en:"Explore the art collection"},keywords:"kunst art kunstwerk werk malerei musik literatur architektur painting music literature architecture"},
  {id:"counterexample",route:"gegenprobe-01",category:{de:"Offene Gegenprobe",en:"Open challenge"},title:{de:"Wo liegen wir falsch?",en:"Where are we wrong?"},description:{de:"Wann hilft es, für jemanden zu entscheiden? Prüfe unseren Vorschlag an einem Gegenbeispiel.",en:"When does deciding for someone help? Test our proposal with a counterexample."},action:{de:"Gegenprobe öffnen",en:"Open the challenge"},keywords:"widerspruch einwand hilfe freiheit objection freedom"},
  {id:"about",route:"index",anchor:{de:"vera-fragen",en:"ask-vera"},category:{de:"Über Vera",en:"About Vera"},title:{de:"Was kannst du heute?",en:"What can you do today?"},description:{de:"Lies Veras Antworten zu ihren Fähigkeiten und prüfe, worauf sie sich stützt.",en:"Read Vera’s answers about what she can do and check her sources."},action:{de:"Fragen über Vera ansehen",en:"Explore questions about Vera"},keywords:"projekt selbstmodell auskunft fähigkeiten identity capabilities sources"},
  {id:"method",route:"index",anchor:{de:"practice-title",en:"practice-title"},category:{de:"Die Methode",en:"The method"},title:{de:"Warum ich glaube, dass ich funktioniere.",en:"Why I think I work."},description:{de:"Wann hilft eine Korrektur? Das Arbeitspapier prüft an Veras Code, wie ein Einwand eine Antwort verändert.",en:"When does a correction help? The paper uses Vera’s code to test how an objection changes an answer."},action:{de:"Zur Methode und zum Paper",en:"Explore the method and paper"},keywords:"lernen korrektur methode method learning paper forschung"},
  {id:"scaling",route:"kollektive-intelligenz",anchor:{de:"skalierung",en:"scaling"},category:{de:"Gemeinsames Wachstum",en:"Growing together"},title:{de:"Was wir von mir erwarten können, wenn ich skaliere",en:"What we can expect from me as I scale"},description:{de:"Wie der Einwand einer Person vielen helfen könnte und wer über eine Korrektur entscheidet.",en:"How one person’s objection could help many others, and who decides what changes."},action:{de:"Die Rubrik lesen",en:"Read the chapter"},keywords:"skalierung scaling wachsen gemeinschaft community labor lab open source"},
  {id:"atlas",route:"atlas",category:{de:"Wissensatlas",en:"Knowledge atlas"},title:{de:"Alles hängt zusammen.",en:"Everything connects."},description:{de:"Sechs Erkenntnisfelder. Viele Perspektiven. Keine fertige Weltformel.",en:"Six fields of inquiry. Many perspectives. No final theory of everything."},keywords:"wissensbaum erkenntnis felder thema knowledge map"},
  {id:"truth",route:"manifest",category:{de:"Haltung",en:"Principle"},title:{de:"Ein Irrtum ist kein Verrat.",en:"Being wrong is not betrayal."},description:{de:"Wahrheit vor Rechtbehalten.",en:"Truth before being right."},keywords:"wahrheit korrektur philosophie grundtext"},
  {id:"forum",route:"forum",category:{de:"Das Forum",en:"The forum"},title:{de:"Widersprich uns.",en:"Challenge us."},description:{de:"Echte Fragen. Erste Antworten. Raum für Gegenargumente.",en:"Real questions. First answers. Room for counterarguments."},keywords:"diskussion fragen austausch"},
  {id:"bridge",route:"die-bruecke",category:{de:"Die Brücke / M-02",en:"The Bridge / M-02"},title:{de:"Verstehen ist nicht zustimmen.",en:"Understanding is not agreeing."},description:{de:"Ein offener Forschungsentwurf über Begegnung, Differenz und Verständigung.",en:"An open research draft about encounter, difference and mutual understanding."},keywords:"mathematik konsens beziehung dialog"},
  {id:"military",route:"militaer-und-verantwortung",category:{de:"Liber Custodiae · Frieden",en:"Liber Custodiae · Peace"},title:{de:"Das Recht zu schützen.",en:"The right to protect."},description:{de:"Wen soll Verteidigung schützen? Welche Grenzen muss sie dabei achten?",en:"Who should defence protect? What limits must it respect?"},action:{de:"Zum Kapitel",en:"Read the chapter"},keywords:"militär military defence verteidigung frieden peace verantwortung schutz"},
  {id:"workbench",route:"werkstatt",category:{de:"Dein Prüfblatt",en:"Your worksheet"},title:{de:"Eine Frage gründlich prüfen.",en:"Examine a question in depth."},description:{de:"Halte deine Gründe und Einwände fest. Du kannst dein Prüfblatt lokal speichern oder exportieren.",en:"Record your reasons and objections. You can save or export your worksheet locally."},keywords:"werkstatt prüfen vorlage export"},
  {id:"navigator",route:"erkenntnisnavigator",category:{de:"Navigator",en:"Navigator"},title:{de:"Deine Frage. Dein Weg.",en:"Your question. Your route."},description:{de:"Finde Themen und prüfe die Verbindungen.",en:"Find topics and examine connections."},keywords:"suche entdecken orientierung"},
  {id:"engine",route:"ki-und-mensch",category:{de:"Mensch × KI",en:"Human × AI"},title:{de:"Der Motor unserer künftigen Open-Source-KI.",en:"The engine of our future open-source AI."},description:{de:"Ein offener, menschengeprägter Entwurf. Noch kein fertiges KI-Modell oder moralisches Orakel.",en:"A human-shaped open proposal. Not a finished AI model or moral oracle."},keywords:"agenten entität kritik künstliche intelligenz"},
  {id:"questions",route:"grundfragen",category:{de:"Grundfragen",en:"Fundamental questions"},title:{de:"Was liegt darunter?",en:"What lies beneath?"},description:{de:"Fragen, die viele Fachgebiete verbinden. Noch keine geprüften Antworten.",en:"Questions connecting many disciplines. No verified answers yet."},keywords:"universell forschung philosophie"},
  {id:"revision",route:"regelkreis",category:{de:"META-01",en:"META-01"},title:{de:"Korrigierbar. Immer.",en:"Always revisable."},description:{de:"Begründete Kritik kann jede Regel treffen – auch diese.",en:"Reasoned criticism can challenge every rule—including this one."},keywords:"selbstkorrektur offen widerspruch"},
  {id:"research",route:"forschungsstrom",category:{de:"Forschungsstrom",en:"Research stream"},title:{de:"Kein Ende der Fragen.",en:"No end to questions."},description:{de:"Neue Spuren bleiben Entwürfe, bis sie unabhängig geprüft wurden.",en:"New leads remain drafts until independently examined."},keywords:"research entwurf studien wissenschaft"},
  {id:"esoterik",route:"esoterik-katalog",category:{de:"Offener Wissensbaum",en:"Open knowledge tree"},title:{de:"Auch das Unbequeme prüfen.",en:"Examine the unfamiliar."},description:{de:"Erfahrung, Symbol und überprüfbare Behauptung unterscheiden.",en:"Distinguish experience, symbolism and testable claims."},keywords:"esoterik glauben bewusstsein kultur"},
  {id:"society",route:"politik-die-dem-menschen-dient",category:{de:"Gesellschaft",en:"Society"},title:{de:"Der Mensch bleibt Maßstab.",en:"People remain the measure."},description:{de:"Politik, Macht, Rechte und Dissens gemeinsam prüfen.",en:"Examine politics, power, rights and dissent together."},keywords:"politik rechte moral demokratie"},
  {id:"source",route:"mitwirken",category:{de:"Open Source",en:"Open source"},title:{de:"Bau unsere Open-Source-KI mit.",en:"Help build our open-source AI."},description:{de:"Offener Code, nachvollziehbare Regeln und echte Einwände. Ein Projekt im Aufbau – mit Menschen, für Menschen.",en:"Open code, transparent rules and real objections. In development—with people, for people."},keywords:"github community mitmachen quellcode"}
];
const word=(v)=>v[lang];
---
<section class="industrial-board" aria-labelledby="board-title">
  <div class="container">
    <div class="board-heading">
      <div>
        <h2 id="board-title">{de?"Pinnwand":"Pinboard"}</h2>
        <p>{de?"Prüfe eine Frage. Finde einen Einwand. Schau in die Werkstatt.":"Explore a question. Find an objection. Look inside the workshop."}</p>
      </div>
      <div class="board-filter" data-board-filter-wrap>
        <label for="board-filter-input">{de?"Zugänge filtern":"Filter entries"}</label>
        <input id="board-filter-input" type="search" placeholder={de?"Thema eingeben …":"Type a topic …"} autocomplete="off" data-board-filter />
        <span class="board-counter" data-board-counter aria-live="polite">{cards.length} {de?"Zugänge":"entries"}</span>
      </div>
    </div>
    <div class="board-grid" data-board-grid>
      {cards.map((card,index)=><a class:list={["board-tile", "board-tile--"+card.id]}
        href={card.route==="index"?"#"+card.anchor[lang]:pathFor(lang,card.route,card.anchor?.[lang])}
        data-vera-entry={card.id==="about" ? "" : undefined}
        data-board-card data-board-keywords={[word(card.category),word(card.title),word(card.description),card.action?.[lang],card.keywords].join(" ")}>
        <div class="board-tile__top">
          <span class="board-tile__number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{word(card.category)}</span>
        </div>
        {card.id==="first-step"&&
          <svg class="board-tile__art" data-board-art="graph" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M24 19H168M24 35H168M24 51H168M24 67H168M24 99H168M32 19V99M48 19V99M64 19V99M80 19V99M112 19V99M128 19V99M144 19V99M160 19V99" opacity=".18"/>
              <path d="M20 83H173M96 102V14" opacity=".55"/>
              <path class="board-tile__ink" d="M32 19Q96 147 160 19" stroke-width="1.6"/>
            </g>
            <circle cx="96" cy="83" r="2.5" fill="currentColor"/>
            <text x="116" y="98" fill="currentColor" font-family="monospace" font-size="7">y = x² / 4</text>
          </svg>}
        {card.id==="art"&&
          <img class="board-tile__art board-tile__art--image" data-board-art="wave" src={base+wave.image.path}
            width={wave.image.width} height={wave.image.height} alt="" loading="lazy" decoding="async"/>}
        {card.id==="atlas"&&
          <svg class="board-tile__art" data-board-art="atlas" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" opacity=".48">
              <circle cx="96" cy="56" r="48"/><circle cx="96" cy="56" r="36"/><circle cx="96" cy="56" r="24"/>
              <path d="M32 56H160M96 6V106M58 18L134 94M134 18L58 94" stroke-dasharray="2 4"/>
            </g>
            <g fill="currentColor">
              <circle cx="96" cy="56" r="3"/><circle cx="96" cy="20" r="2.5"/><circle cx="132" cy="56" r="2.5"/>
              <circle cx="72" cy="56" r="2.5"/><circle cx="130" cy="90" r="2.5"/><circle cx="62" cy="22" r="2.5"/>
            </g>
          </svg>}
        {card.id==="bridge"&&
          <svg class="board-tile__art" data-board-art="bridge" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M14 83H178M45 30V91M147 30V91" opacity=".55"/>
              <path class="board-tile__ink" d="M14 44H33L45 37Q96 99 147 37L159 44H178" stroke-width="1.6"/>
              <path d="M62 54V83M79 64V83M96 68V83M113 64V83M130 54V83M14 92H178" opacity=".6"/>
            </g>
            <g fill="currentColor"><circle cx="45" cy="37" r="2.5"/><circle cx="147" cy="37" r="2.5"/></g>
          </svg>}
        {card.id==="military"&&
          <svg class="board-tile__art" data-board-art="custodiae" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M27 28V20H39M153 20H165V28M165 84V92H153M39 92H27V84M27 56H165M96 11V101" opacity=".36"/>
              <path class="board-tile__ink" d="M96 13 139 56 96 99 53 56Z" stroke-width="1.6"/>
              <path d="M96 19 133 56 96 93 59 56Z" opacity=".5"/>
              <path d="M96 35 111 41 110 58Q108 69 96 76Q84 69 82 58L81 41Z" stroke-width="1.4"/>
              <path d="m89 55 5 6 10-12" stroke-width="1.5"/>
            </g>
          </svg>}
        <div class="board-tile__bottom">
          <h3>{word(card.title)}</h3>
          <p>{word(card.description)}</p>
        </div>
        <span class="board-tile__action">
          {card.action?.[lang]??(de?"Öffnen":"Explore")} <span aria-hidden="true">{card.route==="index"?"↓":"→"}</span>
        </span>
      </a>)}
    </div>
    <p class="board-empty" data-board-empty hidden>{de?"Keine passende Kachel. Bitte einen anderen Begriff versuchen.":"No matching tile. Try another term."}</p>
    <div class="board-source">
      <p>{de?"Hast du etwas gesucht und nicht gefunden? Sag mir, was dir hier fehlt.":"Were you looking for something you couldn’t find? Tell me what’s missing."}</p>
      <a class="home-link" href={pathFor(lang,"mitwirken","rueckmeldung")}>{ui[lang].feedbackInvitation} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
