---
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const de=lang==="de";
const cards=[
  {id:"atlas",type:"stone",cols:2,rows:18,route:"atlas",number:"01",category:{de:"Wissensatlas",en:"Knowledge atlas"},title:{de:"Alles hängt zusammen.",en:"Everything connects."},description:{de:"Sechs Erkenntnisfelder. Viele Perspektiven. Keine fertige Weltformel.",en:"Six fields of inquiry. Many perspectives. No final theory of everything."},keywords:"wissensbaum erkenntnis felder thema knowledge map"},
  {id:"truth",type:"ink",cols:1,rows:15,route:"manifest",number:"02",category:{de:"Haltung",en:"Principle"},title:{de:"Ein Irrtum ist kein Verrat.",en:"Being wrong is not betrayal."},description:{de:"Wahrheit vor Rechtbehalten.",en:"Truth before being right."},keywords:"wahrheit korrektur philosophie grundtext"},
  {id:"forum",type:"paper",cols:1,rows:18,route:"forum",number:"03",category:{de:"Das Forum",en:"The forum"},title:{de:"Widersprich uns.",en:"Challenge us."},description:{de:"Echte Fragen. Erste Antworten. Raum für Gegenargumente.",en:"Real questions. First answers. Room for counterarguments."},keywords:"diskussion fragen austausch"},
  {id:"bridge",type:"porcelain",cols:2,rows:21,route:"die-bruecke",number:"04",category:{de:"Die Brücke / M-02",en:"The Bridge / M-02"},title:{de:"Verstehen ist nicht zustimmen.",en:"Understanding is not agreeing."},description:{de:"Ein offener Forschungsentwurf über Begegnung, Differenz und Verständigung.",en:"An open research draft about encounter, difference and mutual understanding."},keywords:"mathematik konsens beziehung dialog"},
  {id:"navigator",type:"paper",cols:1,rows:15,route:"erkenntnisnavigator",number:"05",category:{de:"Navigator",en:"Navigator"},title:{de:"Deine Frage. Dein Weg.",en:"Your question. Your route."},description:{de:"Finde Themen und prüfe die Verbindungen.",en:"Find topics and examine connections."},keywords:"suche entdecken orientierung"},
  {id:"engine",type:"ink",cols:2,rows:17,route:"ki-und-mensch",number:"06",category:{de:"Mensch × KI",en:"Human × AI"},title:{de:"Der Motor unserer künftigen Open-Source-KI.",en:"The engine of our future open-source AI."},description:{de:"Ein offener, menschengeprägter Entwurf. Noch kein fertiges KI-Modell oder moralisches Orakel.",en:"A human-shaped open proposal. Not a finished AI model or moral oracle."},keywords:"agenten entität kritik künstliche intelligenz"},
  {id:"workbench",type:"stone",cols:1,rows:16,route:"werkstatt",number:"07",category:{de:"Dein Prüfblatt",en:"Your worksheet"},title:{de:"Denken wird konkret.",en:"Make thinking tangible."},description:{de:"Frage, These, Beleg, Einwand, Revision. Lokal und exportierbar.",en:"Question, claim, evidence, objection, revision. Local and exportable."},keywords:"werkstatt prüfen vorlage export"},
  {id:"questions",type:"porcelain",cols:1,rows:16,route:"grundfragen",number:"08",category:{de:"Grundfragen",en:"Fundamental questions"},title:{de:"Was liegt darunter?",en:"What lies beneath?"},description:{de:"Fragen, die viele Fachgebiete verbinden. Noch keine geprüften Antworten.",en:"Questions connecting many disciplines. No verified answers yet."},keywords:"universell forschung philosophie"},
  {id:"revision",type:"paper",cols:1,rows:14,route:"regelkreis",number:"09",category:{de:"META-01",en:"META-01"},title:{de:"Korrigierbar. Immer.",en:"Always revisable."},description:{de:"Begründete Kritik kann jede Regel treffen – auch diese.",en:"Reasoned criticism can challenge every rule—including this one."},keywords:"selbstkorrektur offen widerspruch"},
  {id:"research",type:"ink",cols:2,rows:15,route:"forschungsstrom",number:"10",category:{de:"Forschungsstrom",en:"Research stream"},title:{de:"Kein Ende der Fragen.",en:"No end to questions."},description:{de:"Neue Spuren bleiben Entwürfe, bis sie unabhängig geprüft wurden.",en:"New leads remain drafts until independently examined."},keywords:"research entwurf studien wissenschaft"},
  {id:"esoterik",type:"stone",cols:1,rows:16,route:"esoterik-katalog",number:"11",category:{de:"Offener Wissensbaum",en:"Open knowledge tree"},title:{de:"Auch das Unbequeme prüfen.",en:"Examine the unfamiliar."},description:{de:"Erfahrung, Symbol und überprüfbare Behauptung unterscheiden.",en:"Distinguish experience, symbolism and testable claims."},keywords:"esoterik glauben bewusstsein kultur"},
  {id:"society",type:"porcelain",cols:1,rows:15,route:"politik-die-dem-menschen-dient",number:"12",category:{de:"Gesellschaft",en:"Society"},title:{de:"Der Mensch bleibt Maßstab.",en:"People remain the measure."},description:{de:"Politik, Macht, Rechte und Dissens gemeinsam prüfen.",en:"Examine politics, power, rights and dissent together."},keywords:"politik rechte moral demokratie"},
  {id:"source",type:"paper",cols:2,rows:12,route:"mitwirken",number:"13",category:{de:"Open Source",en:"Open source"},title:{de:"Bau unsere Open-Source-KI mit.",en:"Help build our open-source AI."},description:{de:"Offener Code, nachvollziehbare Regeln und echte Einwände. Ein Projekt im Aufbau – mit Menschen, für Menschen.",en:"Open code, transparent rules and real objections. In development—with people, for people."},keywords:"github community mitmachen quellcode"}
];
const word=(v)=>v[lang];
---
<section class="industrial-board" aria-labelledby="board-title">
  <div class="container">
    <div class="board-heading">
      <div>
        <p class="board-kicker">{de?"ATLAS DER MÖGLICHKEITEN / EDITION 01":"ATLAS OF POSSIBILITIES / EDITION 01"}</p>
        <h2 id="board-title">{de?"Eine Idee. Viele Eingänge.":"One idea. Many ways in."}</h2>
        <p>{de?"Jede Kachel ist eine Tür – zu einer Frage, einem Einwand oder einem Werkzeug.":"Every tile is a doorway—to a question, an objection, or a tool."}</p>
      </div>
      <div class="board-filter" data-board-filter-wrap>
        <label for="board-filter-input">{de?"Kacheln filtern":"Filter these tiles"}</label>
        <input id="board-filter-input" type="search" placeholder={de?"Thema eingeben …":"Type a topic …"} autocomplete="off" data-board-filter />
        <span class="board-counter" data-board-counter aria-live="polite">{cards.length} {de?"Zugänge":"entries"}</span>
      </div>
    </div>
    <div class="board-grid" data-board-grid>
      {cards.map(card=><a class:list={["board-tile","board-tile--"+card.type,"board-tile--"+card.id]} style={"--cols:"+card.cols+";--rows:"+card.rows} href={pathFor(lang,card.route)} data-board-card data-board-keywords={[word(card.category),word(card.title),word(card.description),card.keywords].join(" ")}>
        <div class="board-tile__top"><span>{card.number} / {word(card.category)}</span><span aria-hidden="true">↗</span></div>
        {card.id==="atlas"&&<svg class="tile-visual tile-visual--atlas" viewBox="0 0 410 240" fill="none" aria-hidden="true">
          <circle cx="206" cy="122" r="100" stroke="currentColor" opacity=".35"/><circle cx="206" cy="122" r="76" stroke="currentColor" opacity=".45"/><circle cx="206" cy="122" r="52" stroke="currentColor" opacity=".55"/><circle cx="206" cy="122" r="27" stroke="currentColor"/><circle cx="206" cy="122" r="5" fill="currentColor"/>
          <path d="M72 122H340M206 5V238M112 54L296 187M295 52L112 189" stroke="currentColor" opacity=".27" stroke-dasharray="2 6"/><circle cx="130" cy="56" r="8" fill="currentColor"/><circle cx="281" cy="185" r="7" fill="currentColor"/><circle cx="300" cy="64" r="5" fill="currentColor"/><circle cx="110" cy="183" r="6" fill="currentColor"/><circle cx="306" cy="122" r="5" fill="currentColor"/><circle cx="206" cy="46" r="6" fill="currentColor"/>
        </svg>}
        {card.id==="bridge"&&<svg class="tile-visual tile-visual--bridge" viewBox="0 0 520 210" fill="none" aria-hidden="true">
          <path d="M20 170H500M100 60V191M420 60V191" stroke="currentColor" stroke-width="3"/><path d="M18 72C145 72 148 159 260 159S381 72 502 72" stroke="currentColor" stroke-width="3"/><path d="M61 72V170M102 88V170M143 115V170M184 140V170M225 155V170M260 159V170M295 155V170M336 139V170M377 113V170M418 88V170M459 72V170" stroke="currentColor" stroke-width="1.3"/><path d="M5 193H515" stroke="currentColor" opacity=".3" stroke-dasharray="3 6"/><circle cx="20" cy="170" r="6" fill="currentColor"/><circle cx="500" cy="170" r="6" fill="currentColor"/>
        </svg>}
        {card.id==="engine"&&<div class="tile-engine" aria-hidden="true"><div class="tile-engine__core">?</div><span class="node node--a"></span><span class="node node--b"></span><span class="node node--c"></span><span class="node node--d"></span><span class="node node--e"></span><span class="node node--f"></span><i></i><i></i><i></i></div>}
        {card.id==="workbench"&&<div class="tile-steps" aria-hidden="true"><span>01</span><span>02</span><span>03</span><span>04</span><span>05</span></div>}
        {card.id==="revision"&&<div class="tile-revision" aria-hidden="true">↺</div>}
        {card.id==="questions"&&<div class="tile-question-mark" aria-hidden="true">?</div>}
        {card.id==="esoterik"&&<div class="tile-glyph" aria-hidden="true">◇</div>}
        {card.id==="research"&&<div class="tile-research-mark" aria-hidden="true">∴</div>}
        {card.id==="source"&&<div class="tile-source-mark" aria-hidden="true">{"{ }"}</div>}
        <div class="board-tile__bottom">
          <h3>{word(card.title)}</h3>
          <p>{word(card.description)}</p>
          <span class="board-tile__action">{de?"ÖFFNEN":"EXPLORE"} <span aria-hidden="true">↗</span></span>
        </div>
      </a>)}
    </div>
    <p class="board-empty" data-board-empty hidden>{de?"Keine passende Kachel. Bitte einen anderen Begriff versuchen.":"No matching tile. Try another term."}</p>
    <p class="board-disclaimer">{de?"Die Kacheln sind Zugänge zu Arbeit und offenen Fragen – keine Rangliste und kein wissenschaftlicher Konsens.":"These tiles are entry points to ongoing work and open questions—not a ranking or scientific consensus."}</p>
  </div>
</section>