---
import {base,pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import artWorks from "../../public/knowledge/art-works.v1.json";
const {lang="de"}=Astro.props;
const de=lang==="de";
const wave=artWorks.works.find(work=>work.id==="art-01");
const cards=[
  {id:"conversation",route:"schnittmengen",anchor:{de:"sprachprobe",en:"sprachprobe"},category:{de:"Am Küchentisch",en:"At the kitchen table"},title:{de:"Teilen wir die Miete durch zwei?",en:"Should we split the rent in half?"},description:{de:"Ein Gehalt ist doppelt so hoch wie das andere. Ihr wollt beide fair teilen. Was bedeutet das für jeden von euch?",en:"One of you earns twice as much as the other. You both want to be fair. What does that mean to each of you?"},action:{de:"Gespräch zu zweit ausprobieren",en:"Try the conversation together"},keywords:"gespräch streit konflikt zuhören miete fairness mediation conversation rent disagreement listening"},
  {id:"first-step",route:"index",anchor:{de:"erkenntnis",en:"insight"},category:{de:"Erkenntnis · Ausprobieren",en:"Insight · Try it"},title:{de:"Wie entscheidet Vera?",en:"How does Vera decide?"},description:{de:"Eine neue Seite soll online gehen. Welchen Test würdest du zuerst machen? Vergleiche deine Wahl mit Veras Modell.",en:"A new page is about to go live. What would you check first? Compare your choice with Vera’s model."},action:{de:"Modell ausprobieren",en:"Try the model"},keywords:"einstieg start erkenntnis entscheidung belege insight decision evidence"},
  {id:"everyday",route:"forum",anchor:{de:"alltagsfragen",en:"alltagsfragen"},category:{de:"Aus dem Alltag",en:"Everyday life"},title:{de:"Was beschäftigt dich?",en:"What’s on your mind?"},description:{de:"Muss ich bleiben, wenn ich jemanden liebe? Hier findest du einen ersten Gedanken dazu und einen guten Grund, weiterzufragen.",en:"Do I have to stay if I love someone? Read one possible answer and a question that might change how you see it."},action:{de:"Alltagsfragen lesen",en:"Read everyday questions"},keywords:"liebe arbeit ernährung food work love beziehung"},
  {id:"personal-practice",route:"index",anchor:{de:"eigene-frage",en:"your-question"},category:{de:"Deine Frage",en:"Your question"},title:{de:"Mir geht ein Gespräch nach.",en:"I keep replaying a conversation."},description:{de:"Was hat die andere Person gesagt? Was vermutest du? Drei Fragen helfen dir, deine Gedanken zu sortieren.",en:"What did they say? What do you think they meant? Three questions give you room to sort through your thoughts."},action:{de:"Eigene Frage prüfen",en:"Work through a question"},keywords:"werkstatt prüfen vorlage export"},
  {id:"art",route:"kunst-und-erkenntnis",anchor:{de:"sammlung",en:"sammlung"},category:{de:"Liber Artis · Kunst",en:"Liber Artis · Art"},title:{de:"Wohin schaust du zuerst?",en:"Where does your eye go first?"},description:{de:"Unter Hokusais großer Welle ducken sich Menschen in ihren Booten. Schau einen Moment lang nur auf sie. Wie wirkt die Welle jetzt?",en:"Beneath Hokusai’s great wave, people crouch in their boats. Look just at them for a moment. How does the wave feel now?"},action:{de:"Zur Kunstsammlung",en:"Explore the art collection"},keywords:"kunst art kunstwerk werk malerei musik literatur architektur painting music literature architecture"},
  {id:"counterexample",route:"gegenprobe-01",category:{de:"Offene Gegenprobe",en:"Open challenge"},title:{de:"Entscheidest du das für mich?",en:"Would you decide for me?"},description:{de:"Ein Freund bittet dich darum. Wann wäre es fürsorglich, Ja zu sagen? An dieser Frage kannst du unsere Regel über Hilfe prüfen.",en:"A friend asks you to make a choice for them. When would saying yes be an act of care? Try our rule about helping against that case."},action:{de:"Gegenprobe öffnen",en:"Open the challenge"},keywords:"widerspruch einwand hilfe freiheit objection freedom"},
  {id:"about",route:"index",anchor:{de:"vera-fragen",en:"ask-vera"},category:{de:"Über Vera",en:"About Vera"},title:{de:"Vera, was kannst du heute?",en:"Vera, what can you do today?"},description:{de:"Frag mich, was du hier ausprobieren kannst und woran noch gearbeitet wird. Zu jeder Antwort findest du die Quelle.",en:"Ask me what you can try today and what’s still in the works. Each answer comes with its source."},action:{de:"Fragen über Vera ansehen",en:"Explore questions about Vera"},keywords:"projekt selbstmodell auskunft fähigkeiten identity capabilities sources"},
  {id:"method",route:"index",anchor:{de:"practice-title",en:"practice-title"},category:{de:"Die Methode",en:"The method"},title:{de:"Warum ich glaube, dass ich funktioniere.",en:"Why I think I work."},description:{de:"Stell dir vor, du widersprichst mir. Was müsste sich an meiner Antwort ändern? Das Arbeitspapier spielt es am Code durch.",en:"Suppose you challenge one of my answers. What ought to change? The working paper follows a case through the code."},action:{de:"Zur Methode und zum Paper",en:"Explore the method and paper"},keywords:"lernen korrektur methode method learning paper forschung"},
  {id:"scaling",route:"kollektive-intelligenz",anchor:{de:"skalierung",en:"scaling"},category:{de:"Gemeinsames Wachstum",en:"Growing together"},title:{de:"Was wir von mir erwarten können, wenn ich skaliere",en:"What we can expect from me as I scale"},description:{de:"Du bemerkst etwas, das bisher allen entgangen ist. Wie könnte dein Einwand der nächsten Person helfen?",en:"You spot something everyone else has missed. How could speaking up help the next person?"},action:{de:"Die Rubrik lesen",en:"Read the chapter"},keywords:"skalierung scaling wachsen gemeinschaft community labor lab open source"},
  {id:"atlas",route:"atlas",category:{de:"Wissensatlas",en:"Knowledge atlas"},title:{de:"Wo fängt deine Frage an?",en:"Where does your question begin?"},description:{de:"Beim Körper, bei einem Gefühl, bei den Regeln, nach denen wir leben? Sechs Felder laden zum Weiterdenken ein.",en:"With your body, a feeling, or the rules we live by? Explore six ways into a question."},keywords:"wissensbaum erkenntnis felder thema knowledge map"},
  {id:"truth",route:"manifest",category:{de:"Haltung",en:"Principle"},title:{de:"Ich habe meine Meinung geändert.",en:"I’ve changed my mind."},description:{de:"Vielleicht hat dir jemand etwas erzählt, das du vorher nicht wusstest. Im Manifest hat genau dieser Moment einen Platz.",en:"Maybe someone told you something you didn’t know. Our manifesto makes room for changing your mind when that happens."},keywords:"wahrheit korrektur philosophie grundtext"},
  {id:"forum",route:"forum",category:{de:"Das Forum",en:"The forum"},title:{de:"Hier sehe ich das anders.",en:"I see it differently."},description:{de:"Lies eine Frage, die jemand auch am Abendbrottisch stellen könnte. Welche Erfahrung würdest du der ersten Antwort entgegenhalten?",en:"Read a question you might hear over dinner. What has your own experience taught you that the first answer misses?"},keywords:"diskussion fragen austausch"},
  {id:"bridge",route:"die-bruecke",category:{de:"Die Brücke / M-02",en:"The Bridge / M-02"},title:{de:"Habe ich dich richtig verstanden?",en:"Have I understood you?"},description:{de:"Du kannst die Antwort eines Freundes genau vorhersagen und selbst anders denken. In diesem Modell kannst du beides ausprobieren.",en:"You might know exactly what a friend would say and still disagree. Try those two things side by side in the model."},keywords:"mathematik konsens beziehung dialog"},
  {id:"military",route:"militaer-und-verantwortung",category:{de:"Liber Custodiae · Frieden",en:"Liber Custodiae · Peace"},title:{de:"Wer lebt neben dem Ziel?",en:"Who lives next to the target?"},description:{de:"Eine Armee soll Menschen schützen. In der Nähe ihres Ziels leben Familien. Was schuldet sie ihnen?",en:"An army has a duty to protect people. Families live near its target. What does it owe them?"},action:{de:"Zum Kapitel",en:"Read the chapter"},keywords:"militär military defence verteidigung frieden peace verantwortung schutz"},
  {id:"workbench",route:"werkstatt",category:{de:"Dein Prüfblatt",en:"Your worksheet"},title:{de:"Das möchte ich in Ruhe durchdenken.",en:"I need time to think this through."},description:{de:"Schreib auf, was für deine Sicht spricht und wo du zweifelst. Das Prüfblatt kannst du für später aufheben.",en:"Write down why you see it this way and where your doubts begin. You can keep the worksheet and come back to it."},keywords:"werkstatt prüfen vorlage export"},
  {id:"navigator",route:"erkenntnisnavigator",category:{de:"Navigator",en:"Navigator"},title:{de:"Wo kann ich weiterlesen?",en:"Where can I read more?"},description:{de:"Gib eine Frage in deinen eigenen Worten ein. Der Navigator zeigt dir, wo du im Projekt weiterlesen kannst.",en:"Write your question in your own words. The navigator suggests places in the project where you can read on."},keywords:"suche entdecken orientierung"},
  {id:"engine",route:"ki-und-mensch",category:{de:"Mensch × KI",en:"Human × AI"},title:{de:"Wer bringt einer KI Fürsorge bei?",en:"Who teaches an AI to care?"},description:{de:"Im Entwurf für unsere Open-Source-KI kannst du nachlesen, welche Regeln Menschen ihr mitgeben und wo du ihnen widersprechen kannst.",en:"Read the proposed rules for our open-source AI. Which would you want it to follow, and which would you challenge?"},keywords:"agenten entität kritik künstliche intelligenz"},
  {id:"questions",route:"grundfragen",category:{de:"Grundfragen",en:"Fundamental questions"},title:{de:"Was liegt unter der ersten Frage?",en:"What’s behind the first question?"},description:{de:"Manchmal führt ein Streit über eine Entscheidung zu einer Frage über Freiheit. Im Atlas kannst du solchen offenen Fragen nachgehen.",en:"Sometimes a disagreement over a decision becomes a question about freedom. Follow open questions like these across the atlas."},keywords:"universell forschung philosophie"},
  {id:"revision",route:"regelkreis",category:{de:"META-01",en:"META-01"},title:{de:"Was wird aus deinem Einwand?",en:"What happens to your objection?"},description:{de:"Jemand weist auf einen Fehler hin. Hier kannst du nachlesen, wer die Regel prüft und wo der Widerspruch stehen bleibt.",en:"Someone points out a mistake. See who reviews the rule and how a disagreement stays on the record."},keywords:"selbstkorrektur offen widerspruch"},
  {id:"research",route:"forschungsstrom",category:{de:"Forschungsstrom",en:"Research stream"},title:{de:"Woran wird gerade gezweifelt?",en:"What’s being questioned?"},description:{de:"Lies einen Forschungsentwurf und überlege, welche Beobachtung nötig wäre, damit du ihm vertraust.",en:"Read a research draft. What would you want to see before you put your trust in it?"},keywords:"research entwurf studien wissenschaft"},
  {id:"esoterik",route:"esoterik-katalog",category:{de:"Offener Wissensbaum",en:"Open knowledge tree"},title:{de:"Ein Symbol bedeutet dir etwas.",en:"A symbol means something to you."},description:{de:"Was hast du erlebt? Welche Deutung gibst du dem Erlebnis? Der Katalog lässt dir Platz für beide Fragen.",en:"What did you experience? How do you make sense of it? The catalogue leaves room for both questions."},keywords:"esoterik glauben bewusstsein kultur"},
  {id:"society",route:"politik-die-dem-menschen-dient",category:{de:"Gesellschaft",en:"Society"},title:{de:"Wem gehört der Garten?",en:"Whose garden is it?"},description:{de:"Ein Kind will Fußball spielen, eines Blumen pflanzen, eines lesen. Wie finden sie eine Regel für den Platz, den alle teilen?",en:"One child wants to play football, another to plant flowers, another to read. How can they decide what to do with the space they share?"},keywords:"politik rechte moral demokratie"},
  {id:"source",route:"mitwirken",category:{de:"Open Source",en:"Open source"},title:{de:"Bau unsere Open-Source-KI mit.",en:"Help build our open-source AI."},description:{de:"Vielleicht stolperst du über einen Satz, den wir alle überlesen haben. Zeig uns die Stelle. Auch so kannst du mitbauen.",en:"Maybe you stumble over a sentence the rest of us have read past. Show us where. That’s one way to help build Vera."},keywords:"github community mitmachen quellcode"}
];
const word=(v)=>v[lang];
---
<section class="industrial-board" aria-labelledby="board-title">
  <div class="container">
    <div class="board-heading">
      <div>
        <h2 id="board-title">{de?"Pinnwand":"Pinboard"}</h2>
        <p>{de?"Vielleicht kommt dir eine dieser Fragen bekannt vor. Fang dort an.":"Maybe one of these questions sounds familiar. Start there."}</p>
        <slot />
      </div>
      <div class="board-filter" data-board-filter-wrap>
        <label for="board-filter-input">{de?"Zugänge filtern":"Filter entries"}</label>
        <input id="board-filter-input" type="search" placeholder={de?"Thema eingeben …":"Type a topic …"} autocomplete="off" data-board-filter />
        <span class="board-counter" data-board-counter aria-live="polite">{cards.length} {de?"Zugänge":"entries"}</span>
      </div>
    </div>
    <div class="board-grid" data-board-grid>
      {cards.map((card,index)=><a class:list={["board-tile", "board-tile--"+card.id]}
        href={card.route==="index"?"#"+card.anchor[lang]:pathFor(lang,card.route,card.anchor?.[lang])}
        data-vera-entry={card.id==="about" ? "" : undefined}
        data-board-card data-board-keywords={[word(card.category),word(card.title),word(card.description),card.action?.[lang],card.keywords].join(" ")}>
        <div class="board-tile__top">
          <span class="board-tile__number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{word(card.category)}</span>
        </div>
        {card.id==="conversation"&&
          <svg class="board-tile__art" data-board-art="table" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" stroke-linejoin="round">
              <path d="M42 28v-7a5 5 0 0 1 5-5h22a5 5 0 0 1 5 5v7M118 84v7a5 5 0 0 0 5 5h22a5 5 0 0 0 5-5v-7" opacity=".58"/>
              <rect x="21" y="28" width="150" height="56" rx="8" fill="currentColor" fill-opacity=".05"/>
              <g transform="rotate(-8 96 56)" opacity=".65">
                <rect x="85" y="42" width="22" height="28" rx="1"/>
                <path d="M90 49h12m-12 5h8m-8 7h12"/>
              </g>
              <g stroke-width="1.8" class="board-tile__ink">
                <circle cx="58" cy="47" r="10"/><path d="M48.5 44H46a3 3 0 0 0 0 6h2.5"/>
                <circle cx="133" cy="64" r="8"/><path d="M140.5 61H143a3 3 0 0 1 0 6h-2.5"/>
              </g>
              <circle cx="58" cy="47" r="7" opacity=".5"/><circle cx="133" cy="64" r="5" opacity=".5"/>
            </g>
          </svg>}
        {card.id==="first-step"&&
          <svg class="board-tile__art" data-board-art="graph" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M24 19H168M24 35H168M24 51H168M24 67H168M24 99H168M32 19V99M48 19V99M64 19V99M80 19V99M112 19V99M128 19V99M144 19V99M160 19V99" opacity=".18"/>
              <path d="M20 83H173M96 102V14" opacity=".55"/>
              <path class="board-tile__ink" d="M32 19Q96 147 160 19" stroke-width="1.6"/>
            </g>
            <circle cx="96" cy="83" r="2.5" fill="currentColor"/>
            <text x="116" y="98" fill="currentColor" font-family="monospace" font-size="7">y = x² / 4</text>
          </svg>}
        {card.id==="art"&&
          <img class="board-tile__art board-tile__art--image" data-board-art="wave" src={base+wave.image.path}
            width={wave.image.width} height={wave.image.height} alt={wave.image.alt[lang]} loading="lazy" decoding="async"/>}
        {card.id==="atlas"&&
          <svg class="board-tile__art" data-board-art="atlas" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" opacity=".48">
              <circle cx="96" cy="56" r="48"/><circle cx="96" cy="56" r="36"/><circle cx="96" cy="56" r="24"/>
              <path d="M32 56H160M96 6V106M58 18L134 94M134 18L58 94" stroke-dasharray="2 4"/>
            </g>
            <g fill="currentColor">
              <circle cx="96" cy="56" r="3"/><circle cx="96" cy="20" r="2.5"/><circle cx="132" cy="56" r="2.5"/>
              <circle cx="72" cy="56" r="2.5"/><circle cx="130" cy="90" r="2.5"/><circle cx="62" cy="22" r="2.5"/>
            </g>
          </svg>}
        {card.id==="bridge"&&
          <svg class="board-tile__art" data-board-art="bridge" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M14 83H178M45 30V91M147 30V91" opacity=".55"/>
              <path class="board-tile__ink" d="M14 44H33L45 37Q96 99 147 37L159 44H178" stroke-width="1.6"/>
              <path d="M62 54V83M79 64V83M96 68V83M113 64V83M130 54V83M14 92H178" opacity=".6"/>
            </g>
            <g fill="currentColor"><circle cx="45" cy="37" r="2.5"/><circle cx="147" cy="37" r="2.5"/></g>
          </svg>}
        {card.id==="military"&&
          <svg class="board-tile__art" data-board-art="custodiae" viewBox="0 0 192 112" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor">
              <path d="M27 28V20H39M153 20H165V28M165 84V92H153M39 92H27V84M27 56H165M96 11V101" opacity=".36"/>
              <path class="board-tile__ink" d="M96 13 139 56 96 99 53 56Z" stroke-width="1.6"/>
              <path d="M96 19 133 56 96 93 59 56Z" opacity=".5"/>
              <path d="M96 35 111 41 110 58Q108 69 96 76Q84 69 82 58L81 41Z" stroke-width="1.4"/>
              <path d="m89 55 5 6 10-12" stroke-width="1.5"/>
            </g>
          </svg>}
        <div class="board-tile__bottom">
          <h3>{word(card.title)}</h3>
          <p>{word(card.description)}</p>
        </div>
        <span class="board-tile__action">
          {card.action?.[lang]??(de?"Öffnen":"Explore")} <span aria-hidden="true">{card.route==="index"?"↓":"→"}</span>
        </span>
      </a>)}
    </div>
    <p class="board-empty" data-board-empty hidden>{de?"Keine passende Kachel. Bitte einen anderen Begriff versuchen.":"No matching tile. Try another term."}</p>
    <div class="board-source">
      <p>{de?"Hast du etwas gesucht und nicht gefunden? Sag mir, was dir hier fehlt.":"Were you looking for something you couldn’t find? Tell me what’s missing."}</p>
      <a class="home-link" href={pathFor(lang,"mitwirken","rueckmeldung")}>{ui[lang].feedbackInvitation} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
