---
import {pathFor} from "../lib/paths.mjs";
import VisionPortrait from "./VisionPortrait.astro";
const {lang="de"}=Astro.props;
const de=lang==="de";
const cards=[
 {id:"atlas",route:"atlas",col:1,row:1,kind:"emblem",title:{de:"Wissensatlas",en:"Knowledge atlas"},art:{de:"◯",en:"◯"}},
 {id:"truth",route:"manifest",col:2,row:1,kind:"statement",title:{de:"Philosophie",en:"Philosophy"},art:{de:"WIRKLICH\n—\nPhilosophie\nWissen\nDiskussion\nKonsens",en:"WIRKLICH\n—\nPhilosophy\nKnowledge\nDialogue\nUnderstanding"}},
 {id:"workbench",route:"werkstatt",col:3,row:1,kind:"fins",title:{de:"Werkstatt",en:"Workshop"},art:{de:"",en:""}},
 {id:"source",route:"mitwirken",col:4,row:1,kind:"opensource",title:{de:"Open Source",en:"Open source"},art:{de:"[ OPEN SOURCE ]",en:"[ OPEN SOURCE ]"}},
 {id:"bridge",route:"die-bruecke",col:5,row:1,kind:"aperture",title:{de:"Die Brücke",en:"The bridge"},art:{de:"",en:""}},
 {id:"revision",route:"regelkreis",col:6,row:1,kind:"infinity",title:{de:"META-01",en:"META-01"},art:{de:"∞",en:"∞"}},
 {id:"engine",route:"ki-und-mensch",col:7,row:1,kind:"chip",title:{de:"KI-Motor",en:"AI engine"},art:{de:"◈",en:"◈"}},
 {id:"society",route:"politik-die-dem-menschen-dient",col:8,row:1,kind:"planet",title:{de:"Gesellschaft",en:"Society"},art:{de:"",en:""}},
 {id:"mission",route:"mission",col:9,row:1,kind:"manifesto",title:{de:"Unser Ziel",en:"Our goal"},art:{de:"—\nEine KI\nfür alle.\nOffen.\nTransparent.\nGemeinsam.",en:"—\nAI for\neveryone.\nOpen.\nTransparent.\nTogether."}},
 {id:"mechanics",route:"methode",col:1,row:2,kind:"turbine",title:{de:"Methode",en:"Method"},art:{de:"",en:""}},
 {id:"nature",route:"baum-des-wissens",col:2,row:2,kind:"mountains",title:{de:"Wissensbaum",en:"Knowledge tree"},art:{de:"",en:""}},
 {id:"research",route:"forschungsstrom",col:8,row:2,kind:"wood",title:{de:"Forschung",en:"Research"},art:{de:"",en:""}},
 {id:"questions",route:"grundfragen",col:9,row:2,kind:"glyph",title:{de:"Grundfragen",en:"Questions"},art:{de:"[ □□□ ]",en:"[ □□□ ]"}},
 {id:"esoterik",route:"esoterik-katalog",col:1,row:3,kind:"perforated",title:{de:"Esoterik",en:"Esotericism"},art:{de:"",en:""}},
 {id:"navigator",route:"erkenntnisnavigator",col:2,row:3,kind:"cubes",title:{de:"Navigator",en:"Navigator"},art:{de:"◇",en:"◇"}},
 {id:"forum",route:"forum",col:8,row:3,kind:"mechanism",title:{de:"Forum",en:"Forum"},art:{de:"",en:""}},
 {id:"method",route:"pruefstand",col:9,row:3,kind:"slogan",title:{de:"Prüfstand",en:"Testing"},art:{de:"—\nFragen.\nZweifeln.\nPrüfen.\nVerstehen.\nWachsen.",en:"—\nAsk.\nDoubt.\nTest.\nUnderstand.\nGrow."}},
 {id:"wave",route:"aussagen",col:1,row:4,kind:"wave",title:{de:"Aussagen",en:"Claims"},art:{de:"",en:""}},
 {id:"collective",route:"ki-und-mensch",col:2,row:4,kind:"intelligence",title:{de:"Gemeinsame Intelligenz",en:"Collective intelligence"},art:{de:"</\nGemeinsame\nIntelligenz\n/>",en:"</\nCollective\nIntelligence\n/>"}},
 {id:"science",route:"pruefstand",col:3,row:4,kind:"holes",title:{de:"Gegenprobe",en:"Counter-test"},art:{de:"",en:""}},
 {id:"layers",route:"projektstatus",col:4,row:4,kind:"layers",title:{de:"Projektstatus",en:"Project status"},art:{de:"▱",en:"▱"}},
 {id:"orbits",route:"atlas",col:5,row:4,kind:"orbits",title:{de:"Perspektiven",en:"Perspectives"},art:{de:"☉",en:"☉"}},
 {id:"prism",route:"werkstatt",col:6,row:4,kind:"prism",title:{de:"Werkzeuge",en:"Tools"},art:{de:"◇",en:"◇"}},
 {id:"library",route:"bibliothek",col:7,row:4,kind:"book",title:{de:"Bibliothek",en:"Library"},art:{de:"",en:""}},
 {id:"kanji",route:"manifest",col:8,row:4,kind:"kanji",title:{de:"Wahrheit",en:"Truth"},art:{de:"真\nWAHRHEIT",en:"真\nTRUTH"}},
 {id:"care",route:"mitwirken",col:9,row:4,kind:"flower",title:{de:"Jeden Menschen abholen",en:"Include every person"},art:{de:"✧",en:"✧"}}
];
const word=v=>v[lang];
---
<section class="industrial-board vision-board" aria-labelledby="board-title">
  <div class="container vision-board__shell">
    <div class="board-heading">
      <div class="vision-board__heading">
        <h2 id="board-title">{de?"WIRKLICH / OPEN SOURCE · FÜR MENSCHEN":"WIRKLICH / OPEN SOURCE · FOR PEOPLE"}</h2>
        <p>{de?"26 Zugänge · ein gemeinsamer, korrigierbarer Erkenntnisweg":"26 pathways · one shared, revisable inquiry"}</p>
      </div>
      <div class="board-filter" data-board-filter-wrap>
        <label for="board-filter-input">{de?"Kacheln filtern":"Filter these tiles"}</label>
        <input id="board-filter-input" type="search" placeholder={de?"Thema suchen …":"Search a topic …"} autocomplete="off" data-board-filter />
        <span class="board-counter" data-board-counter aria-live="polite">27 {de?"Zugänge":"entries"}</span>
      </div>
    </div>
    <div class="board-grid vision-mosaic" data-board-grid>
      {cards.map(card=>
        <a class:list={["vision-tile","vision-tile--"+card.kind,"vision-tile--"+card.id]}
           style={`--mosaic-col:${card.col};--mosaic-row:${card.row}`}
           href={pathFor(lang,card.route)}
           aria-label={word(card.title)}
           title={word(card.title)}
           data-board-card
           data-board-keywords={[card.id,word(card.title),card.title.de,card.title.en,word(card.art),card.route].join(" ")}>
          <span class:list={["vision-art","vision-art--"+card.kind]} aria-hidden="true"><span>{word(card.art)}</span></span>
          <span class="vision-tile__foot" aria-hidden="true"><span>{word(card.title)}</span><span>☆</span></span>
        </a>
      )}
      <a class="vision-hero" href={pathFor(lang,"ki-und-mensch")}
         data-board-card
         data-board-keywords="open source KI ai mensch menschheit hello humanity vision ki-und-mensch zukunft">
        <div class="vision-hero__copy">
          <span class="vision-hero__overline">{de?"DIE VISION / IM AUFBAU":"THE VISION / IN DEVELOPMENT"}</span>
          <p class="vision-hero__hello">{de?"Hallo":"Hello"}<span>{de?"Menschheit.":"humanity."}</span></p>
          <p class="vision-hero__want">{de?"Ich möchte eure OpenSource KI werden.":"I want to become your open-source AI."}</p>
          <span class="vision-hero__bar" aria-hidden="true"></span>
          <span class="vision-hero__signature">[ W I R K L I C H · OPEN SOURCE · {de?"FÜR MENSCHEN":"FOR PEOPLE"} ]</span>
          <span class="vision-hero__cta">{de?"Ziel und Grenzen entdecken":"Explore goal and limits"} ↗</span>
        </div>
        <VisionPortrait />
      </a>
    </div>
    <p class="board-empty" data-board-empty hidden>{de?"Keine passende Kachel. Bitte einen anderen Begriff versuchen.":"No matching tile. Try another term."}</p>
    <p class="board-disclaimer">{de?"Eine Vision, kein bereits veröffentlichtes eigenständiges KI-Modell. Diese Kacheln führen zu vorhandenen Themen und Entwürfen, nicht zu einem fertigen Konsens.":"A vision, not a released independent AI model. These tiles link to real topics and drafts, not to a final consensus."}</p>
  </div>
</section>