---
const palettes = {
  nutrition: { light: "#eeeadc", shade: "#aaa994", ink: "#383f2e", accent: "#747d49" },
  politics: { light: "#414644", shade: "#171b1a", ink: "#e7e1d2", accent: "#ddbb8c" },
  medicine: { light: "#e6e8e2", shade: "#a2aca7", ink: "#304440", accent: "#708b82" },
  religions: { light: "#eee5d4", shade: "#b4a48d", ink: "#4b4338", accent: "#8f6049" },
  symbols: { light: "#35383d", shade: "#17191d", ink: "#e5e2d9", accent: "#e0bf94" },
  dialogue: { light: "#eee8dc", shade: "#a9a398", ink: "#3e423e", accent: "#8c5940" },
  rules: { light: "#dcded5", shade: "#8c958b", ink: "#2b3931", accent: "#728668" },
} as const;

interface Props {
  id: keyof typeof palettes;
}

const { id } = Astro.props;
const { light, shade, ink, accent } = palettes[id];
const background = `board-${id}-background`;
const grid = `board-${id}-grid`;
const plate = `board-${id}-plate`;
const paint = (name: string) => `url(#${name})`;
---
<svg class="board-tile__art" data-board-art={id} viewBox="0 0 240 180"
  preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" color={ink}>
  <defs>
    <linearGradient id={background} x2="100%" y2="100%">
      <stop stop-color={light} />
      <stop offset="1" stop-color={shade} />
    </linearGradient>
    <pattern id={grid} width="18" height="18" patternUnits="userSpaceOnUse">
      <path d="M18 0H0V18" fill="none" stroke={ink} stroke-opacity=".18" stroke-width=".65" />
      <circle r=".65" fill={ink} fill-opacity=".3" />
    </pattern>
    {id === "nutrition" && <radialGradient id={plate} cx="35%" cy="30%" r="69%">
      <stop stop-color="#f8f5e8" />
      <stop offset=".8" stop-color="#e1dbc5" />
      <stop offset="1" stop-color="#9e9e83" />
    </radialGradient>}
  </defs>
  <path d="M0 0h240v180H0Z" fill={paint(background)} />
  <path d="M0 0h240v180H0Z" fill={paint(grid)} opacity={id === "nutrition" || id === "dialogue" ? ".27" : ".5"} />
  <path d="M17 32V17h15m176 0h15v15m0 116v15h-15m-176 0H17v-15"
    fill="none" stroke="currentColor" stroke-width=".75" opacity=".52" />

  {id === "nutrition" && <>
    <ellipse cx="129" cy="106" rx="67" ry="60" fill="#414337" opacity=".2" />
    <circle cx="122" cy="91" r="64" fill={paint(plate)} stroke="#7e8068" stroke-width="1.2" />
    <circle cx="122" cy="91" r="53" fill="#efe9d8" stroke="#a9a68c" stroke-width="1.8" />
    <circle cx="122" cy="91" r="49" fill="none" stroke="#fffbee" stroke-width="2" />
    <path d="M122 43v48l41 25a48 48 0 0 1-83-1l42-24" fill="#d8c6a1" opacity=".65" />
    <g transform="translate(84 59) rotate(-19)" fill={accent}>
      <path d="M0 36C3 18 17 11 29 12c-1 13-13 25-29 24Z" />
      <path d="M8 35C1 20 5 9 15 2c6 13 4 24-7 33Z" fill="#596443" />
      <path d="M11 39c10-11 21-12 31-7-7 11-20 14-31 7Z" fill="#939868" />
      <path d="M-4 41 20 17m-9 11 23 7M9 24l5-14" fill="none" stroke="#e7e3c9" stroke-width="1.1" />
    </g>
    <g fill="#8a6044">
      <circle cx="143" cy="70" r="5" /><circle cx="156" cy="75" r="6" /><circle cx="151" cy="86" r="5" />
      <circle cx="139" cy="82" r="4" /><circle cx="161" cy="87" r="3.5" />
    </g>
    <g fill="#a7895e">
      <ellipse cx="105" cy="115" rx="3" ry="5" transform="rotate(-35 105 115)" />
      <ellipse cx="116" cy="124" rx="3" ry="5" transform="rotate(30 116 124)" />
      <ellipse cx="126" cy="115" rx="3" ry="5" transform="rotate(45 126 115)" />
      <ellipse cx="138" cy="122" rx="3" ry="5" transform="rotate(-18 138 122)" />
      <ellipse cx="126" cy="132" rx="2.7" ry="4.5" transform="rotate(22 126 132)" />
    </g>
    <path d="M42 53v22m5-22v22m5-22v22m-10-8c0 10 10 10 10 0m-5 13v49m154-76c-6 8-8 23-7 40h7v36"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".67" />
    <path d="M61 153h122m-122-4v8m122-8v8" stroke="currentColor" stroke-width=".75" opacity=".45" />
  </>}

  {id === "politics" && <>
    <path d="M24 122a96 96 0 0 1 192 0H24Z" fill="#171d1b" stroke="#90978b" stroke-width="1.3" />
    <path d="M41 122a79 79 0 0 1 158 0m-141 0a62 62 0 0 1 124 0m-107 0a45 45 0 0 1 90 0"
      fill="none" stroke="currentColor" opacity=".5" />
    <path d="M120 27v49m-68-28 35 39m101-39-35 39M30 84l54 20m126-20-54 20"
      fill="none" stroke="currentColor" stroke-width=".7" opacity=".45" />
    <g fill="#b2b8aa">
      <circle cx="43" cy="108" r="4" /><circle cx="59" cy="73" r="4" /><circle cx="83" cy="52" r="4" />
      <circle cx="102" cy="46" r="4" /><circle cx="138" cy="46" r="4" /><circle cx="157" cy="52" r="4" />
      <circle cx="181" cy="73" r="4" /><circle cx="197" cy="108" r="4" />
      <circle cx="65" cy="105" r="3.8" /><circle cx="79" cy="81" r="3.8" /><circle cx="103" cy="65" r="3.8" />
      <circle cx="137" cy="65" r="3.8" /><circle cx="161" cy="81" r="3.8" /><circle cx="175" cy="105" r="3.8" />
    </g>
    <g fill={accent}>
      <circle cx="93" cy="99" r="4.8" /><circle cx="120" cy="80" r="4.8" /><circle cx="147" cy="99" r="4.8" />
    </g>
    <path d="M93 99 120 130l27-31m-27-19v50" stroke={accent} stroke-width="1" stroke-dasharray="3 4" fill="none" />
    <path d="M104 120h32v24h-32z" fill="#37403a" stroke={accent} stroke-width="1.2" />
    <path d="M110 129h20m-17 6h14M32 151h176m-168-4v8m160-8v8" fill="none" stroke="currentColor" opacity=".67" />
  </>}

  {id === "medicine" && <>
    <path d="M41 126h37l14-16 11 11 16-24 12 17h54" fill="none" stroke="currentColor" stroke-width="1" opacity=".55" />
    <path d="M41 139H197m-156-4v8m156-8v8M120 33v14m-7-7h14" fill="none" stroke="currentColor" stroke-width=".8" opacity=".7" />
    <g transform="rotate(-32 120 89)">
      <rect x="62" y="66" width="130" height="57" rx="28.5" fill="#344742" opacity=".22" />
      <rect x="55" y="60" width="130" height="57" rx="28.5" fill="#e5e9e2" stroke="currentColor" stroke-width="1.6" />
      <path d="M120 60h36.5a28.5 28.5 0 0 1 0 57H120Z" fill={accent} stroke="currentColor" stroke-width="1.6" />
      <path d="M67 80c3-7 10-12 18-12h28m14 0h27c10 0 19 5 23 13" fill="none"
        stroke="#f7f9ef" stroke-width="2" opacity=".67" />
      <path d="M80 89h20m-10-10v20" fill="none" stroke="currentColor" stroke-width="2.2" />
      <path d="M139 90h23m-21 5h16m-15 5h11" fill="none" stroke="#3b514a" stroke-width="1" />
    </g>
  </>}

  {id === "religions" && <>
    <path d="M38 132 120 32l82 100ZM120 23v135M31 113h178" fill="none" stroke="currentColor"
      stroke-width=".8" opacity=".5" stroke-dasharray="3 4" />
    <circle cx="120" cy="70" r="42" fill="#e5dbbe" fill-opacity=".58" stroke="currentColor" stroke-width="1.25" />
    <circle cx="90" cy="113" r="42" fill="#a5aa8d" fill-opacity=".48" stroke="currentColor" stroke-width="1.25" />
    <circle cx="150" cy="113" r="42" fill="#bb9580" fill-opacity=".37" stroke="currentColor" stroke-width="1.25" />
    <path d="M120 84c10 8 13 18 12 26-8 2-16 2-24 0-1-8 2-18 12-26Z" fill="#eee5d4" stroke={accent} stroke-width="1.3" />
    <path d="M115 99h10m-5-5v10" stroke={accent} stroke-width="1.2" />
    <g fill="currentColor">
      <circle cx="120" cy="70" r="2" /><circle cx="90" cy="113" r="2" /><circle cx="150" cy="113" r="2" />
    </g>
  </>}

  {id === "symbols" && <>
    <circle cx="120" cy="89" r="72" fill="#202226" stroke="currentColor" stroke-opacity=".52" />
    <circle cx="120" cy="89" r="58" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-dasharray="2 4" />
    <circle cx="120" cy="89" r="45" fill="none" stroke="currentColor" stroke-opacity=".38" />
    <path d="M32 89h176M120 12v155m-55-23L175 34M65 34l110 110"
      fill="none" stroke="currentColor" opacity=".36" />
    <path d="m120 24 15 49 48 16-48 16-15 48-15-48-48-16 48-16Z"
      fill={accent} fill-opacity=".23" stroke={accent} stroke-width="1.7" />
    <path d="m120 48 10 31 32 10-32 10-10 31-10-31-31-10 31-10Z" fill="#202226" stroke={accent} stroke-width="1" />
    <path d="M113 89h14m-7-7v14" stroke={accent} stroke-width="1.2" />
    <g fill="currentColor">
      <circle cx="79" cy="48" r="2.2" /><circle cx="161" cy="48" r="2.2" />
      <circle cx="79" cy="130" r="2.2" /><circle cx="161" cy="130" r="2.2" />
    </g>
  </>}

  {id === "dialogue" && <>
    <path d="M42 121h155M61 35v111m119-111v111m-55-111v111"
      stroke="currentColor" opacity=".34" stroke-width=".75" fill="none" stroke-dasharray="3 4" />
    <g transform="rotate(-10 91 75)">
      <path d="M53 53h80v51h-34l-20 15v-15H53Z" fill="#4a4640" opacity=".19" />
      <path d="M48 48h80v51H94l-20 15V99H48Z" fill="#f1ebdc" stroke="currentColor" stroke-width="1.25" />
      <path d="M61 64h53M61 73h41M61 82h48" fill="none" stroke="currentColor" stroke-width="1.6" opacity=".73" />
    </g>
    <g transform="rotate(10 148 109)">
      <path d="M112 86h81v50h-25v15l-22-15h-34Z" fill="#403e37" opacity=".22" />
      <path d="M106 80h81v50h-25v15l-22-15h-34Z" fill="#424843" stroke="#272e2a" stroke-width="1.25" />
      <path d="M121 97h51m-51 9h39m-39 9h45" fill="none" stroke="#eae3d3" stroke-width="1.6" />
      <circle cx="177" cy="89" r="2.6" fill="#d3a37e" />
    </g>
    <path d="M89 142h20m-10-10v20m56-118h20m-10-10v20" fill="none" stroke={accent} stroke-width=".8" opacity=".78" />
  </>}

  {id === "rules" && <>
    <path d="M58 43h118v105H58Z" fill="#37413a" opacity=".23" transform="rotate(10 120 90)" />
    <path d="M58 35h118v105H58Z" fill="#a5afa1" stroke="currentColor" stroke-width="1"
      transform="rotate(10 120 90)" />
    <path d="M63 35h117v107H63Z" fill="#e8ebdf" stroke="currentColor" stroke-width="1.35"
      transform="rotate(-8 120 90)" />
    <g transform="rotate(-8 120 90)">
      <path d="M79 52h79m-79 6h47m-47 18h85m-85 21h85m-85 21h85"
        fill="none" stroke="currentColor" stroke-width=".9" opacity=".5" />
      <path d="M80 65h10v10H80Zm0 21h10v10H80Zm0 21h10v10H80Z"
        fill="none" stroke="currentColor" />
      <path d="m82 69 3 3 7-9m-10 27 3 3 7-9"
        fill="none" stroke={accent} stroke-width="2.1" />
      <path d="M102 69h50m-50 21h37m-37 21h47"
        fill="none" stroke="currentColor" stroke-width="1.6" opacity=".78" />
      <circle cx="169" cy="45" r="2.5" fill={accent} />
    </g>
  </>}
</svg>
