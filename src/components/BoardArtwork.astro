---
interface Props {
  id: "religions" | "symbols" | "rules";
}

const { id } = Astro.props;
const dark = id === "symbols";
const paper = dark ? "#242824" : "#edeae0";
const ink = dark ? "#e8e3d7" : "#292d28";
const accent = "#a76045";
---
<svg class="board-tile__art board-tile__art--drafting" data-board-art={id} viewBox="0 0 240 180"
  preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" color={ink}>
  <rect width="240" height="180" fill={paper} />

  {id === "religions" && <>
    <!-- An illustrative intersection of three sets, with each contour still visible. -->
    <rect x="108" y="73" width="27" height="27" fill={accent} />
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="56" y="46" width="96" height="54" />
      <rect x="108" y="35" width="27" height="102" />
      <rect x="84" y="73" width="100" height="51" />
    </g>
    <g fill="currentColor" font-family="monospace" font-size="10">
      <text x="63" y="60">A</text>
      <text x="115" y="133">B</text>
      <text x="171" y="117">C</text>
      <text x="120" y="156" text-anchor="middle">A ∩ B ∩ C</text>
    </g>
  </>}

  {id === "symbols" && <>
    <!-- The same form seen directly and constructed by reflection. -->
    <path d="M80 54h80M80 101h80M120 40v81" fill="none" stroke="currentColor"
      stroke-width=".8" stroke-dasharray="2 4" opacity=".48" />
    <path d="M80 101 103 54v47Z" fill="currentColor" />
    <path d="M160 101 137 54v47Z" fill={paper} stroke="currentColor" stroke-width="1.4" />
    <rect x="135" y="52" width="4" height="4" fill={accent} />
    <text x="120" y="145" fill="currentColor" font-family="monospace" font-size="11"
      text-anchor="middle">x ↦ −x</text>
  </>}

  {id === "rules" && <>
    <!-- Distinct inputs feed a common check. An objection remains visible in the trace. -->
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="60" y="49" width="14" height="14" />
      <rect x="60" y="83" width="14" height="14" />
      <rect x="60" y="117" width="14" height="14" />
      <path d="M74 56h25v68H74m0-34h40m-5-4 5 4-5 4" />
      <rect x="117" y="78" width="24" height="24" />
      <path d="M141 90h25m-5-4 5 4-5 4" />
      <rect x="170" y="83" width="14" height="14" />
      <path d="M125 90h8m-69 0h6" />
    </g>
    <rect x="65" y="54" width="4" height="4" fill="currentColor" />
    <path d="m64 127 6-6" fill="none" stroke={accent} stroke-width="1.4" />
  </>}
</svg>
