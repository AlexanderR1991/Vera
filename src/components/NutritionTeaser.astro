---
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const en=lang==="en";
---
<section class="section nutrition-teaser" aria-label={en?"Nutrition and responsibility":"Ernährung und Verantwortung"}>
<div class="container nutrition-teaser__inner">
<p class="section-kicker">{en?"LIBER ALIMENTI · NUTRITION AND ETHICS":"LIBER ALIMENTI · ERNÄHRUNG UND ETHIK"}</p>
<h2>{en?"WHAT":"WAS UNS"}<br/><em>{en?"NOURISHES US.":"NÄHRT."}</em></h2>
<p>{en?"Food becomes energy, health, culture and consequence. Can we examine what nourishes us without turning nutrition into dogma?":"Nahrung wird Energie, Gesundheit, Kultur und Konsequenz. Können wir prüfen, was uns nährt, ohne Ernährung zum Dogma zu machen?"}</p>
<a class="button button--ghost" href={pathFor(lang,"ernaehrung-und-verantwortung")}>{en?"Explore nutrition ↗":"Ernährung untersuchen ↗"}</a>
</div></section>
<style>
.nutrition-teaser{background:radial-gradient(ellipse at 25% 25%,#8a704033,transparent 66%),#0d1715;text-align:center}
.nutrition-teaser__inner{max-width:1050px}
.nutrition-teaser h2{font:clamp(43px,6vw,83px)/1.08 var(--serif);letter-spacing:-.045em;margin:23px auto 26px}
.nutrition-teaser h2 em{color:var(--gold-bright);font-weight:400}
.nutrition-teaser p:not(.section-kicker){font:clamp(17px,2vw,23px)/1.7 var(--serif);max-width:760px;margin:0 auto 33px;color:#d8ccba}
@media(max-width:620px){.nutrition-teaser h2{font-size:clamp(38px,10vw,58px)}}
</style>