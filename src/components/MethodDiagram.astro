---
import { pathFor } from "../lib/paths.mjs";

const { lang } = Astro.props;
const t = (de, en) => lang === "de" ? de : en;
const steps = [
  [t("Stimmen hören", "Hear from people"), t("Wer erlebt das Problem? Wessen Blick fehlt?", "Who experiences the problem? Whose perspective is missing?")],
  [t("Die Frage klären", "Frame the question"), t("Welche Frage meinen wir? Würden Betroffene sie anders stellen?", "What are we asking? Would the people affected put it differently?")],
  [t("Die Aussage fassen", "State the claim"), t("Was genau behaupten wir? Für welchen Fall soll das gelten?", "What exactly are we claiming? Where should it apply?")],
  [t("Gründe prüfen", "Examine the reasons"), t("Was trägt die Aussage? Ein Beweis, eine Beobachtung, ein begründeter Wert? Was spricht dagegen?", "What supports the claim? A proof, an observation, a reason to uphold a value? What counts against it?")],
  [t("Den Stand festhalten", "Record where we stand"), t("Was trägt unter welchen Bedingungen? Worauf einigen wir uns? Welcher Einwand bleibt offen?", "What holds, and under which conditions? Where do we agree? Which objection remains open?")],
  [t("Anwenden und beobachten", "Act and observe"), t("Welchen Schritt wählen wir? Was erwarten wir, und was geschieht tatsächlich?", "What step do we choose? What do we expect, and what actually happens?")]
];
---
<section class="section motor" id="erkenntnismotor" aria-labelledby="motor-title">
  <div class="container">
    <p class="section-kicker">{t("DIE WERKSTATT IM ÜBERBLICK", "THE WORKSHOP AT A GLANCE")}</p>
    <h2 id="motor-title">{t("Der Weg einer Frage", "The path of a question")}</h2>
    <figure>
      <ol>{steps.map(([title, text], i) => <li>
        <span class="number" aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{text}</p>
        {i === 0 && <span class="return-tip" aria-hidden="true">▸</span>}
        {i < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
      </li>)}</ol>
      <figcaption><span aria-hidden="true">↺</span> {t("Zurück zur Frage. Ein neuer Einwand oder eine unerwartete Folge kann die nächste Prüfung auslösen.", "Back to the question. A new objection or an unexpected outcome can set the next review in motion.")}</figcaption>
    </figure>
    <div class="evidence-decision" id="beleglage-und-entscheidung">
      <h3>{t("Was ist belegt, wer stimmt zu, was entscheiden wir?", "What is supported, who agrees, what do we decide?")}</h3>
      <p>{t("Diese drei Fragen brauchen getrennte Antworten. Eine Abstimmung belegt keine Wirkung. Ein wissenschaftlich gestützter Befund legt allein noch keine gemeinsame Verpflichtung fest.", "These three questions need separate answers. A vote does not establish an effect. A scientifically supported finding alone does not establish a collective obligation.")}</p>
      <p><strong>{t("Beleglage.", "Evidence.")}</strong> {t("Welche Daten und Gegenbefunde liegen vor? Passen Messung, Auswertung und Geltungsbereich zur Behauptung? Ein Einzelner kann einen tragfähigen Befund vorlegen oder ein geprüftes Ergebnis vermitteln.", "What data and counterevidence are available? Do measurement, analysis and scope fit the claim? One person can present a sound finding or communicate an examined result.")}</p>
      <p><strong>{t("Zustimmung.", "Agreement.")}</strong> {t("Wer trägt genau diese Fassung mit? Ein Nein, eine offene Antwort und fehlende Betroffene bleiben sichtbar. Zustimmung macht einen Befund nicht wahrer.", "Who supports this exact version? Refusals, unanswered questions and missing affected groups stay visible. Agreement does not make a finding truer.")}</p>
      <p><strong>{t("Entscheidung.", "Decision.")}</strong> {t("Welche Handlung wählen die Verantwortlichen angesichts der Befunde, Werte, Rechte und Alternativen? Eine freiwillige Vereinbarung und ein politischer Mehrheitsbeschluss folgen unterschiedlichen Regeln. Verbleibende Unsicherheit muss auch nach einer Entscheidung sichtbar bleiben.", "What action do those responsible choose given the findings, values, rights and alternatives? A voluntary agreement and a political majority decision follow different rules. Remaining uncertainty must stay visible after a decision.")}</p>
      <p>{t("Gedankenbeispiel: Auch eine Million Ja-Stimmen belegt keine ungeprüfte Wirkung. Ein nachgewiesener Auswertungsfehler einer einzelnen Person kann dagegen eine neue Prüfung verlangen. Öffentliche Diskussion kann solche Gründe erschließen; ihre Stimmenzahl ersetzt sie nicht.", "Thought experiment: even a million yes votes do not establish an unexamined effect. One person's demonstration of an analysis error can require renewed examination. Public discussion can uncover such reasons; its headcount cannot replace them.")}</p>
      <a class="subtle-link" href={pathFor(lang,"philosophischer-motor","befund-zustimmung-entscheidung")}>{t("Die Trennung mathematisch nachvollziehen", "Explore the mathematical separation")} →</a>
    </div>
    <details><summary>{t("Was übernehmen Werkzeuge und KI, was entscheiden Menschen?", "Where do tools and AI help, and who makes decisions?")}</summary>
      <ul>
        <li><a href={pathFor(lang, "erkenntnisnavigator")}>{t("Erkenntnisnavigator", "Knowledge navigator")}</a> · {t("Redaktionelle Musterkarten verbinden Fragen aus verschiedenen Themen. Du prüfst selbst, ob die Voraussetzungen im eigenen Fall gelten.", "Editorial pattern cards connect questions across subjects. You check whether their conditions hold in your case.")}</li>
        <li><a href={pathFor(lang, "werkstatt")}>{t("Persönliches Prüfblatt", "Personal worksheet")}</a> · {t("Dein Entwurf bleibt im Browser. Einen Beitrag zur öffentlichen Prüfung reichst du selbst auf GitHub ein.", "Your draft stays in your browser. To request public review, you submit a contribution on GitHub yourself.")}</li>
        <li><a href={pathFor(lang, "forschungsstrom")}>{t("Forschungsstrom", "Research stream")}</a> · {t("Die Suche sammelt Quellenhinweise. Über Änderungen am veröffentlichten Text entscheidet der Maintainer und dokumentiert die Gründe.", "The search gathers leads to sources. The maintainer decides on changes to published text and records the reasons.")}</li>
        <li><a href={pathFor(lang, "gegenprobe-01")}>{t("Gegenprobe 01 mit der eigenen KI", "Challenge 01 with your own AI")}</a> · {t("Lass einen Einwand zu G-005 entwerfen. Du prüfst ihn und kannst ihn öffentlich einreichen.", "Ask for an objection to G-005. You examine it and can submit it publicly.")}</li>
      </ul>
    </details>
    <a class="subtle-link" href="#g-005">{t("Am Beispiel G-005 sehen, wie ein Einwand den Text verändert hat", "See how an objection changed the wording of G-005")} ↓</a>
    <p><a class="subtle-link" href={pathFor(lang,"regelkreis")}>{t("Warum der gesamte Regelkreis selbst anfechtbar bleiben muss","Why the correction loop must itself remain challengeable")} →</a></p>
  </div>
</section>
<style>
  .motor { border-bottom: 1px solid var(--line); }
  figure { margin: 2rem 0 1.5rem; }
  ol { --gap: 2.3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); padding: 0 0 0 1rem; list-style: none; }
  li { position: relative; }
  ol li { background: var(--ink2); border-top: 1px solid var(--gold); padding: 1rem 1.15rem; }
  ol li:nth-child(4) { grid-area: 2 / 3; }
  ol li:nth-child(5) { grid-area: 2 / 2; }
  ol li:nth-child(6) { grid-area: 2 / 1; }
  ol li:first-child::before, ol li:last-child::before { content: ""; position: absolute; right: 100%; width: 1rem; height: calc(50% + var(--gap) / 2 + 1px); border-left: 1px dashed var(--gold); }
  ol li:first-child::before { top: 50%; border-top: 1px dashed var(--gold); }
  ol li:last-child::before { bottom: 50%; border-bottom: 1px dashed var(--gold); }
  .return-tip { position: absolute; right: 100%; top: 50%; transform: translateY(-50%); color: var(--gold-bright); line-height: 1; }
  .number { color: var(--gold-bright); font-variant-numeric: tabular-nums; }
  h3 { font-size: 1.4rem; line-height: 1.25; margin: .35rem 0; }
  li p { line-height: 1.5; margin: 0; }
  .arrow { position: absolute; display: grid; place-items: center; width: var(--gap); left: 100%; top: 50%; transform: translateY(-50%); color: var(--gold-bright); }
  li:nth-child(3) .arrow { left: 50%; top: 100%; height: var(--gap); transform: translateX(-50%) rotate(90deg); }
  li:nth-child(4) .arrow, li:nth-child(5) .arrow { left: auto; right: 100%; transform: translateY(-50%) rotate(180deg); }
  figcaption { color: var(--gold-bright); }
  figcaption span { font-size: 1.35em; }
  details { margin: 1rem 0; }
  summary { cursor: pointer; color: var(--text); width: fit-content; }
  details ul { max-width: 72ch; padding-inline-start: 1.25rem; }
  details li + li { margin-top: .65rem; }
  details a { color: var(--gold-bright); text-decoration: underline; }
  .evidence-decision { max-width: 72ch; margin-block: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); scroll-margin-top: 7rem; }
  .evidence-decision h3 { font-size: clamp(1.4rem, 3vw, 2rem); }
  @media (max-width: 48rem) {
    ol { --gap: 1.75rem; grid-template-columns: minmax(0, 1fr); }
    ol li:nth-child(n) { grid-area: auto; }
    ol li:not(:first-child):not(:last-child)::before { content: ""; position: absolute; left: -1rem; top: calc(var(--gap) / -2 - 1px); height: calc(100% + var(--gap) + 2px); border-left: 1px dashed var(--gold); }
    ol li:nth-child(n) .arrow { left: 50%; right: auto; top: 100%; height: var(--gap); transform: translateX(-50%) rotate(90deg); }
  }
</style>
