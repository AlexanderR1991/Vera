---
import {pathFor} from "../lib/paths.mjs";
const {lang="de",from="index"}=Astro.props;
const en=lang==="en";
const labels={
  index:["V · DIE GRENZEN UNSERES WISSENS","V · THE LIMITS OF KNOWLEDGE"],
  atlas:["DEN RAND DES WISSENS ERKUNDEN","EXPLORE THE EDGE OF KNOWLEDGE"],
  bibliothek:["NEUES LESSTÜCK · ERKENNTNISTHEORIE","NEW ESSAY · EPISTEMOLOGY"],
  methode:["VON DER FRAGE ZUR ERKENNTNIS","FROM QUESTION TO KNOWLEDGE"]
};
const headline=en?["Where does our","knowledge end?"]:["Wo endet unser","Wissen?"];
const descriptions={
 index:["Ein Bild von M, a und b: Was können wir heute erkennen, und was liegt jenseits unseres Horizonts? Eine Einladung, das Unbekannte zu erforschen, ohne Vermutungen als Tatsachen auszugeben.","M, a and b as a model: what can we understand today, and what lies beyond our current horizon? An invitation to explore without confusing possibilities with facts."],
 atlas:["Die Landkarte des Wissens ist nicht das ganze Gelände. Dieses Denkmodell unterscheidet gegenwärtiges Wissen von offenen Hypothesen und zeigt einen möglichen Weg zur Prüfung.","Our map of knowledge is not the whole territory. This model distinguishes established understanding from open hypotheses and sketches a possible path toward testing."],
 bibliothek:["Ein neues zweisprachiges Kapitel mit einer eigenständigen Zeichnung nach einer Ideenskizze, wissenschaftstheoretischen Grenzen und einem Weg von der Frage zur Prüfung.","A new bilingual chapter with an original diagram based on a concept sketch, careful epistemological distinctions, and a path from questioning to testing."],
 methode:["Von der Idee über Hypothese, Messung und Gegenbeleg bis zur Selbstkorrektur: Unser Horizontmodell macht den Forschungsprozess anschaulich.","From an idea to hypothesis, observation, counterevidence, and correction: our horizon model makes the process of inquiry tangible."]
};
const link=en?"Explore the horizon ↗":"Zum Horizontmodell ↗";
const subtitle=labels[from]||labels.index;
const summary=descriptions[from]||descriptions.index;
---
<section class="section horizon-teaser" aria-label={subtitle[en?1:0]}>
<div class="container horizon-teaser__grid">
<div>
<p class="section-kicker">{subtitle[en?1:0]}</p>
<h2>{headline[0]}<br/><em>{headline[1]}</em></h2>
<p>{summary[en?1:0]}</p>
<a class="button button--ghost" href={pathFor(lang,"erkenntnishorizont")}>{link}</a>
</div>
<div class="horizon-teaser__drawing" aria-hidden="true">
<svg viewBox="0 0 340 300" focusable="false">
<circle cx="140" cy="148" r="118" fill="none" stroke="#c7a77c" opacity=".5"/>
<circle cx="140" cy="148" r="46" fill="none" stroke="#c7a77c" stroke-dasharray="3 7"/>
<circle cx="140" cy="148" r="5" fill="#e0c699"/>
<path d="M145 117 193 91 245 110 279 68 319 44" fill="none" stroke="#c7a77c" stroke-dasharray="6 8"/>
<g fill="#111719" stroke="#c7a77c"><circle cx="193" cy="91" r="4"/><circle cx="245" cy="110" r="4"/><circle cx="279" cy="68" r="4"/><circle cx="319" cy="44" r="6" stroke-dasharray="2 3"/></g>
<g fill="#d6c3a4" font-family="Georgia,serif" font-size="16"><text x="121" y="177">M</text><text x="184" y="142">a</text><text x="265" y="153">b</text><text x="298" y="25">x?</text></g>
</svg>
</div>
</div></section>