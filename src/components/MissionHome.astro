---
import Layout from "../layouts/SiteLayout.astro";
import IndustrialBoard from "./IndustrialBoard.astro";
import FirstAnswer from "./FirstAnswer.astro";
import VeraEntity from "./VeraEntity.astro";
import VeraErkenntnis from "./VeraErkenntnis.astro";
import VeraFirstStep from "./VeraFirstStep.astro";
import VeraPractice from "./VeraPractice.astro";
import copy from "../lib/mission-copy.json";
import {base, pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import project from "../../public/project.json" with {type:"json"};
import protocol from "../../public/protocol/self-correction.v1.json";

const {lang="de",root=false}=Astro.props;
const t=copy[lang];
const de=lang==="de";
const name=ui[lang].name;
const greeting=`${t.opening.greetingLead} ${name}.`;
const paperUrl=base+"papers/warum-ich-glaube-dass-ich-funktioniere/paper.html";
// Stagger the loops so the field looks active on arrival and wraps continuously.
const paperWind = Array.from({length:72}, (_, index) => {
  const edge = index < 32;
  const margin = index % 2 === 0 ? 2 : 82;
  const x = edge ? margin + (index * 7 % 19) / 2 : 13 + index * 29 % 69;
  const y = 21 + index * 31 % 76;
  const size = 4 + index * 3 % 4;
  const rise = 56 + index * 17 % 86;
  const duration = 9 + index * 11 % 9;
  const phase = (-duration * (index * .618034 % 1)).toFixed(2);
  const opacity = (.14 + index % 4 * .018).toFixed(3);
  return {edge,x,y,size,rise,duration,phase,opacity};
});
---
<Layout lang={lang} slug="index" root={root} pageTitle={greeting} description={t.metaDescription}>
  <section class="home-opening" aria-labelledby="home-heading">
    <div class="home-opening__wind" aria-hidden="true">
      {paperWind.map(({edge,x,y,size,rise,duration,phase,opacity}) =>
        <span class="home-opening__particle" data-wide={edge?undefined:""}
          style={`--x:${x}%;--y:${y}%;--size:${size}px;--rise:${rise}px;--duration:${duration}s;--phase:${phase}s;--opacity:${opacity}`}></span>
      )}
    </div>
    <div class="container home-opening__frame">
      <svg class="home-opening__mark" viewBox="12 12 176 176" aria-hidden="true" focusable="false">
        <!-- A full turn is 360 units. The 14° opening is centered on the upper-right diagonal. -->
        <circle cx="100" cy="100" r="80" pathLength="360" fill="none" stroke="currentColor"
          stroke-width="1.4" stroke-linecap="butt" stroke-dasharray="346 14" transform="rotate(-38 100 100)" />
      </svg>
      <div class="home-opening__copy">
        <h1 id="home-heading" class="home-opening__title">{t.opening.greetingLead} <span class="home-opening__name">{name}</span>.</h1>
        <p class="home-opening__mission">{t.opening.ambition}</p>
        <div class="home-opening__links">
          <a class="home-link" href={pathFor(lang,"methode","erkenntnismotor")}>
            {t.opening.rules} <span aria-hidden="true">↗</span>
          </a>
          <a class="home-link" href={paperUrl} hreflang="de">
            <span>{t.opening.paper}&nbsp;<span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </div>
    <button class="home-opening__wind-toggle" type="button" hidden aria-pressed="false"
      aria-label={de?"Animationen der Startseite pausieren":"Pause opening animations"}
      title={de?"Animationen der Startseite":"Opening animations"}>
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
        stroke-width="1.4" aria-hidden="true" focusable="false">
        <path class="wind-icon-pause" d="M6 3.5v9m4-9v9" />
        <path class="wind-icon-play" d="m6 3.5 6.5 4.5L6 12.5Z" />
      </svg>
    </button>
  </section>

  <IndustrialBoard lang={lang}/>

  <div class="home-question container">
    <FirstAnswer lang={lang}/>
  </div>

  <VeraPractice lang={lang}/>

  <section class="home-workshop container" aria-labelledby="practice-title">
    <h2 id="practice-title" tabindex="-1">{t.life.workshop}</h2>
    <blockquote class="home-meta-rule">{protocol.motto[lang]}</blockquote>
    <nav aria-label={t.life.workshop}>
      <a class="home-link" href={de?"#vera-fragen":"#ask-vera"} data-vera-entry>
        {t.life.about} <span aria-hidden="true">↓</span>
      </a>
      <a class="home-link" href={pathFor(lang,"schnittmengen","vermittlung")}>
        {t.life.together} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"methode","g-005")}>{t.realExampleLink} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={paperUrl} hreflang="de">
        {t.life.paper} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"fragen-und-ki-prompt","prompt")}>{t.aiLink} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={pathFor(lang,"fragen-und-ki-prompt","gastprobe")}>
        {de?"Mit deiner KI eine Quelle gegenprüfen":"Check a source with your AI"} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"erkenntnisnavigator")}>
        {de?"Im Wissensnavigator weiterlesen":"Explore the knowledge navigator"} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"spiel")}>{t.play} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={project.repository+"/issues/new?template=frage.yml"}>
        {de?"Eine Frage öffentlich vorschlagen (GitHub)":"Suggest a question publicly (GitHub)"} <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <details>
      <summary>{t.life.models}</summary>
      <VeraErkenntnis lang={lang}/>
      <VeraFirstStep lang={lang}/>
    </details>
  </section>

  <VeraEntity lang={lang}/>

  <aside class="home-status container">
    <span data-project-version={project.version}>{ui[lang].name} / {project.version}</span>
    <p>{t.status}</p>
    <a class="home-link" href={pathFor(lang,"projektstatus")}>{t.statusLink} <span aria-hidden="true">↗</span></a>
  </aside>
</Layout>

<script>
  const hero = document.querySelector(".home-opening");
  const toggle = hero?.querySelector<HTMLButtonElement>(".home-opening__wind-toggle");

  if (hero && toggle) {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let paused = false;
    let inView = typeof IntersectionObserver === "undefined";

    const updateWind = () => {
      toggle.hidden = motion.matches;
      hero.toggleAttribute("data-wind-running", !motion.matches && !paused && inView && !document.hidden);
    };

    toggle.addEventListener("click", () => {
      paused = !paused;
      toggle.setAttribute("aria-pressed", String(paused));
      updateWind();
    });
    if (typeof IntersectionObserver !== "undefined") {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        updateWind();
      }).observe(hero);
    }
    motion.addEventListener?.("change", updateWind);
    document.addEventListener("visibilitychange", updateWind);
    hero.setAttribute("data-wind-ready", "");
    updateWind();
  }
</script>
