---
import ArtTeaser from "./ArtTeaser.astro";
import InquiryTeaser from "./InquiryTeaser.astro";
import TreeBridge from "./TreeBridge.astro";
import Layout from "../layouts/SiteLayout.astro";
import copy from "../lib/mission-copy.json";
import {pathFor} from "../lib/paths.mjs";
import project from "../../public/project.json";
import "../styles/mission.css";
import "../styles/workbench.css";
const {lang="de"}=Astro.props;
const t=copy[lang];
---
<Layout lang={lang} slug="index">
  <section class="mission-hero">
    <div class="container mission-hero__grid">
      <div>
        <p class="section-kicker">{t.kicker}</p>
        <h1>{t.headline}<br/><em>{t.headlineAccent}</em></h1>
        <p class="mission-lead">{t.lead}</p>
        <div class="button-row"><a class="button button--gold" href={pathFor(lang,"werkstatt")}>{lang==="de"?"Mit einer Frage beginnen ↗":"Start with a question ↗"}</a><a class="button button--ghost" href={pathFor(lang,"mission")}>{t.missionLink}</a></div>
        <p class="mission-premise">{t.premise}</p>
      </div>
      <aside class="mission-instrument" aria-label={t.shipLabel}>
        <p class="section-kicker">{t.shipLabel}</p>
        <svg viewBox="0 0 400 320" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor">
            <ellipse cx="200" cy="164" rx="149" ry="112" opacity=".25"/>
            <ellipse cx="200" cy="164" rx="106" ry="80" opacity=".45"/>
            <ellipse cx="200" cy="164" rx="58" ry="43" opacity=".25"/>
            <path d="M200 20v280M22 164h356" opacity=".2"/>
            <path d="M51 225Q165 237 203 157T350 46" stroke-dasharray="4 6"/>
            <path d="m200 121 14 54-14-10-14 10z" stroke-width="1.5"/>
            <path d="M324 46h26v26"/>
            <circle cx="95" cy="228" r="4"/><circle cx="268" cy="69" r="4"/>
          </g>
          <circle cx="200" cy="164" r="3" fill="currentColor"/>
        </svg>
        <h2>{t.shipTitle}</h2><p>{t.shipText}</p>
        <dl><div><dt>{t.compass}</dt><dd>{t.compassText}</dd></div><div><dt>{t.course}</dt><dd>{t.courseText}</dd></div></dl>
      </aside>
    </div>
    <div class="container mission-status"><span>WIRKLICH {project.version} · {t.status}</span><a href={pathFor(lang,"projektstatus")}>{lang==="de"?"Was 1.0 leistet und was offen ist ↗":"What 1.0 offers and what remains open ↗"}</a></div>
  </section>
  <section class="mission-origin" aria-labelledby="mission-origin-title"><div class="container mission-origin__inner">
    <p class="section-kicker">{lang==="de"?"UNSER URSPRUNG · VOM BUCH ZUR WERKSTATT":"OUR ORIGIN · FROM A BOOK TO A WORKSHOP"}</p>
    <h2 id="mission-origin-title">{lang==="de"?"Am Anfang stand ein Buch: Die Richtung.":"It began with a book: Die Richtung."}</h2>
    <p>{lang==="de"?"Aus der Arbeit an dem Buch „Die Richtung“ entstand die Idee zu WIRKLICH: Fragen nach Wahrheit und Orientierung nicht in einem abgeschlossenen Text zu belassen, sondern sie gemeinsam, nachvollziehbar und korrigierbar weiterzuverfolgen. Das Buch ist der gedankliche Ursprung, nicht der Beweis für unsere Aussagen.":"The idea for WIRKLICH grew out of work on the book “Die Richtung”: questions about truth and orientation should not end with a finished text, but become a shared, inspectable and revisable inquiry. The book is the intellectual origin, not evidence for our claims."}</p>
    <a class="subtle-link" href={pathFor(lang,"mission")+"#ursprung"}>{lang==="de"?"Die Entstehungsgeschichte lesen ↗":"Read about the project's origins ↗"}</a>
    <a class="subtle-link" href={pathFor(lang,"die-richtung")}>{lang==="de"?"Die Richtung · Buch frei lesen ↗":"Die Richtung · Read the open book ↗"}</a>
  </div></section>
  <section class="mission-trust" aria-labelledby="mission-trust-title"><div class="container">
    <p class="section-kicker">{lang==="de"?"UNSER MASSSTAB · VERTRAUEN DURCH PRÜFUNG":"OUR STANDARD · TRUST THROUGH SCRUTINY"}</p>
    <h2 id="mission-trust-title">{lang==="de"?"Etwas ist nicht wahr, weil es auf wirklich.org steht. Es soll dort stehen, weil es der Prüfung standhält.":"Something is not true because it appears on wirklich.org. It belongs there only if it withstands scrutiny."}</h2>
    <p>{lang==="de"?"Der Name soll eines Tages zu nachvollziehbaren Belegen, Gegenargumenten und Korrekturen führen — niemals selbst als Beweis gelten. Das ist unser Ziel, nicht der erreichte Prüfstatus unserer bisherigen Inhalte.":"One day, the name should lead people to inspectable evidence, counterarguments and corrections — never serve as proof in itself. This is our aspiration, not a claim that our existing content has passed independent review."}</p>
    <a class="subtle-link" href={pathFor(lang,"mission")+"#vertrauen"}>{lang==="de"?"Die Vertrauensregel lesen ↗":"Read the trust principle ↗"}</a>
  </div></section>
  <section class="workbench-entry" aria-labelledby="workbench-entry-title"><div class="container"><div><p class="section-kicker">{lang==="de"?"EIN WERKZEUG FÜR DEINE FRAGE":"A TOOL FOR YOUR QUESTION"}</p><h2 id="workbench-entry-title">{lang==="de"?"Nicht alles wissen. Sorgfältig weiterfragen.":"You can start before you know the answer."}</h2><p>{lang==="de"?"Ordne eine Aussage, ihre Gründe, den stärksten Einwand und deinen nächsten Schritt. Dein Prüfblatt bleibt bei dir und lässt sich als Text oder JSON mitnehmen.":"Organize a claim, its reasons, the strongest objection and your next step. Your worksheet stays with you and can be exported as text or JSON."}</p></div><a class="button button--gold" href={pathFor(lang,"werkstatt")}>{lang==="de"?"Prüfblatt öffnen ↗":"Open worksheet ↗"}</a></div></section>
  <InquiryTeaser lang={lang} />
  <TreeBridge lang={lang} />
  <section class="section mission-section" aria-labelledby="rooms-title"><div class="container">
    <div class="section-heading"><h2 id="rooms-title">{t.roomsTitle}</h2><p>{t.roomsIntro}</p></div>
    <div class="mission-rooms">{t.rooms.map(room=><article><span class="section-kicker">{room.number}</span><h3>{room.title}</h3><p>{room.text}</p><p class="mission-note">{room.note}</p><a class="subtle-link" href={pathFor(lang,room.slug)+(room.hash||"")}>{room.link}</a></article>)}</div>
  </div></section>
  <section class="section section--paper mission-section" aria-labelledby="fields-title"><div class="container">
    <div class="section-heading"><h2 id="fields-title">{t.fieldsTitle}</h2><p>{t.fieldsIntro}</p></div>
    <div class="mission-fields">{t.fields.map((field,i)=><a class:list={["mission-field",field.className]} href={pathFor(lang,field.slug)}><span class="section-kicker">0{i+1}</span><h3>{field.name}</h3><p>{field.question}</p><span aria-hidden="true">↗</span></a>)}</div>
  </div></section>
  <aside class="workshop-entry container" aria-label={lang==="de"?"Neue Werkzeuge":"New tools"}>
    <p>{lang==="de"?"Esoterik & Mathematik: Übersetze eine Idee in ein Modell, erkunde die 64 Linienmuster des I Ging und prüfe Vorhersagen gegen ein Zufallsmodell.":"Esotericism & mathematics: translate an idea into a model, explore 64 I Ching line patterns and examine predictions against a chance model."}</p>
    <a class="subtle-link" href={pathFor(lang,"esoterik-und-mathematik")}>{lang==="de"?"Werkstatt öffnen ↗":"Open the workshop ↗"}</a>
  </aside>
  <section class="section mission-section"><div class="container mission-split">
    <div><p class="section-kicker">{lang==="de"?"ERSTER FUNKTIONIERENDER PROTOTYP":"FIRST WORKING PROTOTYPE"}</p><h2>{t.pilotTitle}</h2><p>{t.pilotText}</p><a class="button button--gold" href={pathFor(lang,"aussagen")}>{t.registerLink}</a><p class="mission-note">{t.pilotNote}</p></div>
    <div class="mission-simple"><p class="section-kicker">{lang==="de"?"DIE EINFACHE FRAGE":"THE SIMPLE QUESTION"}</p><h3>{t.simpleTitle}</h3><p>{t.simpleText}</p><a class="subtle-link" href={pathFor(lang,"lesestueck-wahrheit")}>{t.simpleLink}</a></div>
  </div></section>
  <ArtTeaser lang={lang} />
  <section class="closing"><div class="container closing__inside"><p class="section-kicker">{lang==="de"?"DIE BESATZUNG":"THE CREW"}</p><h2>{t.crewTitle}</h2><p>{t.crewText}</p><div class="button-row mission-center"><a class="button button--gold" href={pathFor(lang,"mitwirken")}>{t.crewLink}</a><a class="button button--ghost" href={pathFor(lang,"angriffsschwarm")}>{t.challengeLink}</a></div></div></section>
</Layout>

<style>
.mission-origin{padding:42px 0 12px}
.mission-origin__inner{padding:30px 34px;border:1px solid var(--line)}
.mission-origin h2{font-size:clamp(24px,3.1vw,40px);line-height:1.2;max-width:900px;margin:10px 0 16px}
.mission-origin p:not(.section-kicker){max-width:800px}
.mission-origin .subtle-link{display:inline-block;margin-top:10px}
.mission-trust{padding:42px 0 48px}
.mission-trust .container{border-left:2px solid var(--gold);padding-left:26px}
.mission-trust h2{font-size:clamp(24px,3.2vw,42px);line-height:1.3;max-width:900px;margin:12px 0 18px}
.mission-trust p:not(.section-kicker){max-width:810px}
.workshop-entry{margin-block:36px;padding:24px;border:1px solid var(--line)}
.workshop-entry p{max-width:920px;margin:0}.workshop-entry .subtle-link{margin-top:16px}
</style>
