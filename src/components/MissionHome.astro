---
import Layout from "../layouts/SiteLayout.astro";
import IndustrialBoard from "./IndustrialBoard.astro";
import FirstAnswer from "./FirstAnswer.astro";
import VeraEntity from "./VeraEntity.astro";
import VeraErkenntnis from "./VeraErkenntnis.astro";
import VeraFirstStep from "./VeraFirstStep.astro";
import VeraPractice from "./VeraPractice.astro";
import copy from "../lib/mission-copy.json";
import {base, pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import project from "../../public/project.json" with {type:"json"};
import protocol from "../../public/protocol/self-correction.v1.json";

const {lang="de",root=false}=Astro.props;
const t=copy[lang];
const de=lang==="de";
---
<Layout lang={lang} slug="index" root={root} pageTitle={t.opening.greeting} description={t.metaDescription}>
  <section class="home-opening" aria-labelledby="home-heading">
    <div class="container home-opening__frame">
      <svg class="home-opening__mark" viewBox="12 12 176 176" aria-hidden="true" focusable="false">
        <!-- A full turn is 360 units. The 14° opening is centered on the upper-right diagonal. -->
        <circle cx="100" cy="100" r="80" pathLength="360" fill="none" stroke="currentColor"
          stroke-width="1.4" stroke-linecap="butt" stroke-dasharray="346 14" transform="rotate(-38 100 100)" />
      </svg>
      <div class="home-opening__copy">
        <h1 id="home-heading" class="home-opening__title">{t.opening.greeting}</h1>
        <p class="home-opening__mission">{t.opening.ambition}</p>
        <a class="home-link home-opening__rules" href={pathFor(lang,"methode","erkenntnismotor")}>
          {t.opening.rules} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-life" id={de?"leben":"life"} aria-labelledby="life-heading">
    <div class="container">
      <div class="home-life__feature">
        <div class="home-life__story">
          <h2 id="life-heading">{t.life.title}</h2>
          <p class="home-life__intro">{t.life.intro}</p>
          <blockquote>{t.life.seed}</blockquote>
          <a class="home-life__action" href={pathFor(lang,"schnittmengen","vermittlung")}>
            {t.life.together} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="home-life__garden" aria-hidden="true">
          <svg viewBox="0 0 240 230" focusable="false">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M47 176h146m-126 9h106m-82 9h58" opacity=".24"/>
              <path d="M119 176c3-30-3-58 9-85 7-15 18-24 29-29M120 143c-8-15-18-22-33-28" stroke-width="1.5"/>
              <path d="M125 100c-2-24 21-42 53-47-5 29-22 46-53 47Zm-8 38c-5-25-25-36-52-36 7 23 25 39 52 36Z" fill="currentColor" fill-opacity=".12" stroke-width="1.15"/>
              <path d="M119 177c-3 7-10 14-20 19m21-18c1 10 6 16 14 22m-17-16c-4 9-4 15-3 20" opacity=".4"/>
            </g>
            <circle cx="120" cy="176" r="2.6" fill="currentColor"/>
          </svg>
        </div>
      </div>

      <div class="home-life__tools">
        <div>
          <FirstAnswer lang={lang}/>
        </div>
        <div class="home-life__solo">
          <h3>{t.life.soloTitle}</h3>
          <p>{t.life.soloText}</p>
          <a class="home-link" href={de?"#eigene-frage":"#your-question"}>{t.life.solo} <span aria-hidden="true">↓</span></a>
          <a class="home-link" href={pathFor(lang,"kollektive-moral","was-ist-gut")}>{t.life.good} <span aria-hidden="true">↗</span></a>
          <a class="home-link" href={de?"#vera-fragen":"#ask-vera"} data-vera-entry>{t.life.about} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <VeraPractice lang={lang}/>

  <IndustrialBoard lang={lang}/>

  <section class="home-workshop container" aria-labelledby="practice-title">
    <h2 id="practice-title" tabindex="-1">{t.life.workshop}</h2>
    <blockquote class="home-meta-rule">{protocol.motto[lang]}</blockquote>
    <nav aria-label={t.life.workshop}>
      <a class="home-link" href={pathFor(lang,"methode","g-005")}>{t.realExampleLink} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={base+"papers/warum-ich-glaube-dass-ich-funktioniere/paper.html"} hreflang="de">
        {t.life.paper} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"fragen-und-ki-prompt","prompt")}>{t.aiLink} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={pathFor(lang,"fragen-und-ki-prompt","gastprobe")}>
        {de?"Mit deiner KI eine Quelle gegenprüfen":"Check a source with your AI"} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"erkenntnisnavigator")}>
        {de?"Im Wissensnavigator weiterlesen":"Explore the knowledge navigator"} <span aria-hidden="true">↗</span>
      </a>
      <a class="home-link" href={pathFor(lang,"spiel")}>{t.play} <span aria-hidden="true">↗</span></a>
      <a class="home-link" href={project.repository+"/issues/new?template=frage.yml"}>
        {de?"Eine Frage öffentlich vorschlagen (GitHub)":"Suggest a question publicly (GitHub)"} <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <details>
      <summary>{t.life.models}</summary>
      <VeraErkenntnis lang={lang}/>
      <VeraFirstStep lang={lang}/>
    </details>
  </section>

  <VeraEntity lang={lang}/>

  <aside class="home-status container">
    <span data-project-version={project.version}>{ui[lang].name} / {project.version}</span>
    <p>{t.status}</p>
    <a class="home-link" href={pathFor(lang,"projektstatus")}>{t.statusLink} <span aria-hidden="true">↗</span></a>
  </aside>
</Layout>
