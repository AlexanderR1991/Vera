---
import Layout from "../layouts/SiteLayout.astro";
import IndustrialBoard from "./IndustrialBoard.astro";
import VeraErkenntnis from "./VeraErkenntnis.astro";
import VeraFirstStep from "./VeraFirstStep.astro";
import VeraPractice from "./VeraPractice.astro";
import copy from "../lib/mission-copy.json";
import {pathFor} from "../lib/paths.mjs";
import {ui} from "../lib/ui.mjs";
import everydayQuestions from "../../public/knowledge/everyday-questions.json";
import project from "../../public/project.json" with {type:"json"};
import protocol from "../../public/protocol/self-correction.v1.json";

const {lang="de",root=false}=Astro.props;
const t=copy[lang];
const de=lang==="de";
const featuredQuestions=everydayQuestions.questions.slice(0,3);
---
<Layout lang={lang} slug="index" root={root} pageTitle={root?ui[lang].titles.index:undefined} description={t.metaDescription}>
  <section class="home-opening" aria-labelledby="home-heading">
    <svg class="home-opening__mark" viewBox="0 0 200 200" role="img"
      aria-label={de?"Vera. Ein Kreis mit einer kleinen Öffnung.":"Vera. A circle with a small opening."}
      focusable="false">
      <!-- A full turn is 360 units. The 14° opening is centered on the upper-right diagonal. -->
      <circle cx="100" cy="100" r="80" pathLength="360" fill="none" stroke="currentColor"
        stroke-width="2.5" stroke-linecap="butt" stroke-dasharray="346 14" transform="rotate(-38 100 100)" />
    </svg>
    <div class="home-opening__copy">
      <h1 id="home-heading" class="home-opening__title">{t.opening.greeting}</h1>
      <p class="home-opening__ambition">{t.opening.ambition}</p>
      <p class="home-opening__motto">{t.opening.motto}</p>
      <a class="home-link home-opening__entry" href={de?"#erkenntnis":"#insight"}>
        {de?"So entscheide ich":"See how I decide"} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <IndustrialBoard lang={lang}/>

  <VeraErkenntnis lang={lang}/>

  <VeraFirstStep lang={lang}/>

  <VeraPractice lang={lang}/>

  <section class="home-forum section-shell" aria-labelledby="home-forum-title">
    <div class="container">
      <div class="home-section-title">
        <div><p class="section-kicker">/ {de?"AUS DEM FORUM":"FROM THE FORUM"}</p><h2 id="home-forum-title">{t.forumTitle}</h2></div>
        <div><p>{t.forumIntro}</p><a class="home-link" href={pathFor(lang,"forum")}>{de?"Alle Diskussionen":"All discussions"} ↗</a></div>
      </div>
      <ul class="home-forum__questions" role="list">
        {featuredQuestions.map((question,index)=><li>
          <a href={pathFor(lang,"forum","alltag-"+question.id)}>
            <span class="home-forum__topic">{String(index+1).padStart(2,"0")} / {question.topic[lang]}</span>
            <span class="home-forum__question">{question.question[lang]}</span>
            <span class="home-forum__arrow" aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ul>
    </div>
  </section>

  <section class="home-method section-shell" aria-labelledby="practice-title">
    <div class="container">
      <div class="home-section-title"><div><p class="section-kicker">/ {de?"DIE METHODE":"THE METHOD"}</p><h2 id="practice-title" tabindex="-1">{de?"Warum ich glaube, dass ich funktioniere":"Why I think I work"}</h2></div>
      <p>{de?"Wenn du deine Beobachtung, deine Vermutung und deinen nächsten Schritt getrennt anschaust, wird sichtbar, wo ein Einwand etwas ändern kann. Ob das im Alltag hilft, lässt sich an konkreten Fällen prüfen.":"Looking at your observation, your guess and your next step separately shows where an objection might change something. Everyday cases let us test whether that helps."}</p></div>
      <ol class="home-method__steps">
        {t.practiceSteps.map(([title,text],i)=><li>
          <span class="home-method__number">0{i+1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>)}
      </ol>
      <blockquote class="home-meta-rule">{protocol.motto[lang]}</blockquote>
      <div class="home-method__links">
        <a class="home-link" href={pathFor(lang,"methode","erkenntnismotor")}>{de?"Den Regelweg verstehen":"See the examination process"} ↗</a>
        <a class="home-link" href={pathFor(lang,"werkstatt")}>{t.worksheet} ↗</a>
        <a class="home-link" href={pathFor(lang,"fragen-und-ki-prompt","prompt")}>{t.aiLink} ↗</a>
      </div>
    </div>
  </section>

  <section class="home-doorways container" aria-label={t.doorwaysLabel}>
    <article class="home-play">
      <div class="home-tile-top"><span>{t.playLabel}</span><span>01 / 02</span></div>
      <div class="home-play__symbol" aria-hidden="true">?</div>
      <h2>{t.playTitle}</h2>
      <p>{t.playIntro}</p>
      <blockquote class="home-play-scene">{t.gameScenario}</blockquote>
      <a class="home-link" href={pathFor(lang,"spiel")}>{t.play} ↗</a>
      <p class="home-note">{t.playNote}</p>
    </article>
    <article class="home-example" aria-labelledby="home-example-title">
      <div class="home-tile-top"><span>{t.exampleLabel}</span><span>{t.exampleId}</span></div>
      <span class="home-example__mark" aria-hidden="true">↺</span>
      <h2 id="home-example-title">{t.exampleTitle}</h2>
      <p class="example-body">{t.exampleText}</p>
      <details>
        <summary>{de?"Was wurde ergänzt?":"What was added?"}</summary>
        <blockquote>{de?"Auch dauerhafte Unterstützung ist wertvoll. Würde und Fürsorge dürfen nicht von erreichbarer Selbstständigkeit abhängen.":"Lasting support is valuable too. Dignity and care must not depend on attainable independence."}</blockquote>
      </details>
      <div class="home-example__links">
        <a class="home-link" href={pathFor(lang,"methode")+"#g-005"}>{t.exampleLink} ↗</a>
        <a class="home-link" href={pathFor(lang,"gegenprobe-01")}>{de?"Gegenbeispiel suchen":"Find a counterexample"} ↗</a>
      </div>
    </article>
  </section>

  <section class="home-explore section-shell" aria-labelledby="explore-title">
    <div class="container home-pair">
      <div class="home-explore__intro">
        <p class="section-kicker">/ {t.exploreLabel}</p>
        <h2 id="explore-title">{t.exploreTitle}</h2>
        <p>{t.consensusLimit}</p>
        <p>{t.exploreText}</p>
        <div class="home-explore__links">
          <a class="home-link" href={pathFor(lang,"baum-des-wissens")}>{t.treeLink} ↗</a>
          <a class="home-link" href={pathFor(lang,"schnittmengen","sprachprobe")}>{de?"Die Sprachprobe zu zweit":"The conversation exercise"} ↗</a>
          <a class="home-link" href={pathFor(lang,"mission")}>{t.missionLink} ↗</a>
        </div>
      </div>
      <div class="home-groups">
        <details open>
          <summary>{t.bringQuestion}</summary>
          <p>{t.privacy}</p>
          <ul>
            <li><a href={pathFor(lang,"erkenntnisnavigator")}>{t.ownQuestion} ↗</a></li>
            <li><a href={pathFor(lang,"werkstatt")}>{t.worksheet} ↗</a></li>
            <li><a href={project.repository+"/issues/new?template=frage.yml"}>{t.publicQuestion} ↗</a></li>
          </ul>
        </details>
        {t.groups.map(group=><details>
          <summary>{group.title}</summary>
          <p>{group.text}</p>
          <ul>{group.links.map(([label,slug])=><li><a href={pathFor(lang,slug)}>{label} ↗</a></li>)}</ul>
        </details>)}
      </div>
    </div>
  </section>

  <aside class="home-ai-identity container" aria-label={de?"Unsere Open-Source-KI-Vision":"Our open-source AI vision"}>
    <strong>{de?"Unser Ziel: Eine Open-Source-KI für Menschen bauen.":"Our goal: Build an open-source AI for people."}</strong>
    <p>{de?"Heute kannst du in der Werkstatt Fragen prüfen, Beispiele ausprobieren und die Regeln in deinem eigenen KI-Chat nutzen. Ein eigenständig veröffentlichtes Vera-Modell steht noch aus.":"Today you can examine questions, try examples and use the workshop rules in your own AI chat. An independently released Vera model is still to come."}</p>
    <a class="home-link" href={pathFor(lang,"ki-und-mensch")}>{de?"Idee und Projektstand prüfen":"Explore the goal and project status"} <span aria-hidden="true">↗</span></a>
  </aside>
  <aside class="home-status container">
    <span data-project-version={project.version}>{ui[lang].name} / {project.version}</span>
    <p>{t.status} {t.principle}</p>
    {!de&&<a class="home-link" href={pathFor(lang,"projektstatus","sprachfassungen")}>{ui[lang].status} <span aria-hidden="true">↗</span></a>}
    <a class="home-link" href={pathFor(lang,"projektstatus")}>{t.statusLink} ↗</a>
  </aside>
</Layout>