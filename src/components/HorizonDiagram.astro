---
const {lang="de"}=Astro.props;
const isEn=lang==="en";
---
<figure class="horizon-figure">
<svg class="horizon-diagram" viewBox="0 0 1060 580" role="img" aria-labelledby="horizon-svg-title horizon-svg-desc" xmlns="http://www.w3.org/2000/svg">
<title id="horizon-svg-title">{isEn?"The expanding horizon of inquiry":"Der wachsende Erkenntnishorizont"}</title>
<desc id="horizon-svg-desc">{isEn?"An observer M stands within an earlier dotted boundary a and the larger present boundary b. Three unconfirmed possibilities x1 to x3 lie beyond. A hypothetical dotted line extends toward x4. The drawing is metaphorical.":"Ein Mensch M befindet sich innerhalb des früheren, punktierten Horizonts a und des größeren heutigen Horizonts b. Drei unbestätigte Möglichkeiten x1 bis x3 liegen außerhalb. Ein hypothetischer Pfad führt zu x4. Die Darstellung ist metaphorisch."}</desc>
<defs>
<radialGradient id="horizon-fill" cx="41%" cy="52%" r="62%"><stop offset="0" stop-color="#bc9462" stop-opacity=".13"/><stop offset="1" stop-color="#bc9462" stop-opacity=".015"/></radialGradient>
<linearGradient id="horizon-path" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#be9a6e"/><stop offset="1" stop-color="#e0cfab"/></linearGradient>
<filter id="horizon-glow"><feGaussianBlur stdDeviation="3"/></filter>
</defs>
<g opacity=".28" stroke="#927b60" stroke-width=".65"><path d="M20 90H1040M20 200H1040M20 310H1040M20 420H1040M20 530H1040M90 20V560M220 20V560M350 20V560M480 20V560M610 20V560M740 20V560M870 20V560M1000 20V560"/></g>
<!-- Boundary b is deliberately irregular, not a literal geometric or scientific threshold -->
<path d="M111 294C107 206 157 109 235 75C322 37 451 66 504 144C553 214 558 322 514 415C465 516 344 536 241 510C142 486 99 394 111 294Z" fill="url(#horizon-fill)" stroke="#ba9b72" stroke-width="2"/>
<path d="M111 294C107 206 157 109 235 75C322 37 451 66 504 144C553 214 558 322 514 415C465 516 344 536 241 510C142 486 99 394 111 294Z" fill="none" stroke="#c4a57b" stroke-width="6" opacity=".11" filter="url(#horizon-glow)"/>
<circle cx="310" cy="299" r="101" stroke="#af8d62" stroke-width="1.8" stroke-dasharray="3 9" fill="#bf9d7430"/>
<g fill="#decba9" font-family="Georgia,serif" font-style="italic">
<text x="407" y="266" font-size="27">a</text><text x="542" y="274" font-size="29">b</text>
</g>
<circle cx="310" cy="299" r="8" fill="#e9d8bb"/><circle cx="310" cy="299" r="21" stroke="#ae8861" stroke-width="1" opacity=".55" fill="none"/>
<text x="285" y="337" fill="#eee2cc" font-family="Georgia,serif" font-size="25">M</text>
<!-- unverified outside candidates, deliberately not filled as verified objects -->
<g stroke="#b99b72" fill="#0c1113" stroke-width="1.7">
<circle cx="654" cy="133" r="7" stroke-dasharray="3 5"/>
<circle cx="650" cy="395" r="7" stroke-dasharray="3 5"/>
<circle cx="54" cy="195" r="7" stroke-dasharray="3 5"/>
<circle cx="990" cy="102" r="7" stroke-dasharray="3 5"/>
</g>
<g fill="#ddd0b9" font-family="Georgia,serif" font-size="24" font-style="italic">
<text x="669" y="118">x₁</text><text x="664" y="436">x₂</text><text x="34" y="171">x₃</text><text x="1004" y="90">x₄</text>
</g>
<!-- Possible, not verified path from the current boundary to a distant candidate -->
<path d="M374 244L427 198L497 180L565 210L620 162L685 195L756 145L816 173L883 130L954 116L990 102" fill="none" stroke="url(#horizon-path)" stroke-width="2.5" stroke-dasharray="9 10" opacity=".92"/>
<g fill="#101617" stroke="#e2c99d" stroke-width="2">
<circle cx="427" cy="198" r="5"/><circle cx="565" cy="210" r="5"/><circle cx="685" cy="195" r="5"/><circle cx="816" cy="173" r="5"/><circle cx="954" cy="116" r="5"/>
</g>
<path d="M310 197V165" fill="none" stroke="#d0b18b" opacity=".45"/>
<g font-family="Arial,sans-serif" font-size="11" letter-spacing="2.5" fill="#a69680">
<text x="165" y="558">{isEn?"EARLIER HORIZON (a)":"FRÜHERER HORIZONT (a)"}</text>
<text x="460" y="558">{isEn?"PRESENT HORIZON (b)":"HEUTIGER HORIZONT (b)"}</text>
<text x="810" y="558">{isEn?"POSSIBLE PATH":"MÖGLICHER PFAD"}</text>
</g>
<path d="M145 539H155M436 539H446M790 539H800" stroke="#bd9e78" stroke-width="1.5"/>
</svg>
<figcaption><slot /></figcaption>
</figure>