---
import {pathFor} from "../lib/paths.mjs";
const {lang="de",from="index"}=Astro.props;
const en=lang==="en";
const labels={
index:["NEUE FORSCHUNGSFRAGE · DIE LIEBE","NEW RESEARCH QUESTION · LOVE"],
atlas:["MENSCH · ETHIK · SOZIALE BEZIEHUNGEN","HUMANITY · ETHICS · RELATIONSHIPS"],
bibliothek:["LIBER AMORIS · OFFENES KAPITEL","LIBER AMORIS · OPEN CHAPTER"],
pruefstand:["FORSCHUNGSTHESEN L-A BIS L-D","RESEARCH HYPOTHESES L-A TO L-D"]
};
const description={
index:["Welche Wirkung haben Fürsorge und Bindung – und kann Liebe zu einer tragfähigen Kraft menschlichen Handelns werden? Wir nehmen auch die Gegenbeispiele ernst.","How do care and attachment affect us—and can love become a constructive motive for human action? We also take counterexamples seriously."],
atlas:["Von sozialer Nähe über Bindungsforschung bis zur Verantwortung: ein offenes Forschungsfeld zwischen Mensch und Ethik.","From social bonds and attachment research to responsibility: an open inquiry between human experience and ethics."],
bibliothek:["Ein neues zweisprachiges Kapitel mit Forschungsbefunden, vier prüfbaren Hypothesen und einer ehrlichen Untersuchung der Grenzen von Liebe.","A new bilingual chapter with research findings, four testable hypotheses, and a careful examination of love's limits."],
pruefstand:["Vier offene Hypothesen über Stress, Selbstbestimmung, Kooperation und Wahrhaftigkeit – ausdrücklich mit Gegenmodellen.","Four open hypotheses about stress, autonomy, cooperation, and honesty—each with countermodels."]
};
const subtitle=labels[from]||labels.index;
const detail=description[from]||description.index;
---
<section class="section love-teaser" aria-label={subtitle[en?1:0]}>
<div class="container love-teaser__grid">
<div><p class="section-kicker">{subtitle[en?1:0]}</p>
<h2>{en?"Why Love":"Warum Liebe"}<br/><em>{en?"Works.":"wirkt."}</em></h2>
<p>{detail[en?1:0]}</p>
<a href={pathFor(lang,"warum-liebe-wirkt")} class="button button--ghost">{en?"Explore the research ↗":"Forschungsbereich entdecken ↗"}</a></div>
<div class="love-teaser__art" aria-hidden="true">
<svg viewBox="0 0 360 290"><g fill="none" stroke="#b89b74" stroke-width="1.3">
<circle cx="141" cy="115" r="82"/><circle cx="223" cy="115" r="82"/><circle cx="182" cy="188" r="82"/>
<circle cx="182" cy="142" r="18" stroke-width="1.8"/><path d="M182 122 201 142 182 161 163 142Z"/></g><circle cx="182" cy="142" r="3" fill="#d6c094"/>
</svg>
</div></div></section>