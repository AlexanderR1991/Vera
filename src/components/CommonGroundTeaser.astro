---
import {pathFor} from "../lib/paths.mjs";
const {lang="de"}=Astro.props;
const en=lang==="en";
---
<section class="section common-teaser" aria-label={en?"Finding common ground":"Schnittmengen finden"}>
<div class="narrow">
<p class="section-kicker">{en?"LIBER PONTIUM · COMMON GROUND":"LIBER PONTIUM · SCHNITTMENGEN"}</p>
<h2>{en?"Even in deep conflict.":"Auch im tiefsten Streit."}</h2>
<p>{en?"You do not have to love one another to protect something together. We look for the smallest freely agreed next step. Disagreement, dignity and the right to say no remain.":"Ihr müsst euch nicht lieben, um gemeinsam etwas zu schützen. Wir suchen den kleinsten freiwillig vereinbarten nächsten Schritt. Widerspruch, Würde und das Recht auf ein Nein bleiben bestehen."}</p>
<a class="button button--ghost" href={pathFor(lang,"schnittmengen")}>{en?"Find common ground ↗":"Schnittmengen finden ↗"}</a>
</div></section>
<style>
.common-teaser{background:radial-gradient(ellipse at 75% 10%,#8d74412b,transparent 65%),#111719;text-align:center}
.common-teaser h2{font:400 clamp(37px,5.5vw,72px)/1.15 var(--serif);letter-spacing:-.04em;text-wrap:balance;margin:24px 0;color:var(--gold-bright)}
.common-teaser p:not(.section-kicker){font:clamp(18px,2vw,23px)/1.75 var(--serif);margin:0 0 30px;color:#ddd2c2}
</style>
