---
import {createHash} from "node:crypto";
import {readFileSync} from "node:fs";
import {ui,navigation} from "../lib/ui.mjs";
import SiteSearch from "../components/SiteSearch.astro";
import UniversalQuestionsContext from "../components/UniversalQuestionsContext.astro";
import {pathFor,absoluteFor,base} from "../lib/paths.mjs";
import project from "../../public/project.json" with {type: "json"};
import "../styles/vera-shell.css";
const {lang="de",slug="index",root=false}=Astro.props;
const t=ui[lang];
const de=lang==="de";
const home=slug==="index";
const primaryLabel=de?"Hauptnavigation":"Main navigation";
const primaryLinks = [
  { href: pathFor(lang,"methode","erkenntnismotor"), label: de?"WIRKLICH · Philosophischer Motor":"WIRKLICH · Philosophical engine" },
  ...navigation.map(([destination,i])=>({ href: pathFor(lang,destination), label: t.nav[i], current: slug===destination }))
];
const footerGroups = [
  { title: t.explore, routes: ["erkenntnisnavigator", "atlas", "baum-des-wissens", "esoterik-katalog", "bibliothek", "aussagen", "forum", "pruefstand", "die-bruecke", "philosophischer-motor", "grundfragen", "forschungsstrom"] },
  { title: t.project, routes: ["mission", "kollektive-intelligenz", "regelkreis", "entitaet", "methode", "ki-und-mensch", "kollektive-moral", "projektstatus", "projektobservatorium", "mitwirken"] }
];
const description = Astro.props.description ?? t.description;
const title = Astro.props.pageTitle ?? (root ? "Choose your language / Sprache wählen" : t.titles[slug]);
const siteRoot="https://alexanderr1991.github.io"+base;
const canonical=root?siteRoot:absoluteFor(lang,slug);
// Content-derived stamps avoid stale shared assets after a Pages deployment.
const assetRevision=file=>createHash("sha256").update(readFileSync("public/assets/"+file)).digest("hex").slice(0,12);
const cssRevision=assetRevision("style.css");
const jsRevision=assetRevision("site.js");
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b0d0e" />
<meta name="color-scheme" content="dark" />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title+" · "+t.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="application-name" content={t.name} />
<meta property="og:locale" content={lang==="de"?"de_DE":"en_GB"} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="de" href={absoluteFor("de",slug)} />
<link rel="alternate" hreflang="en" href={absoluteFor("en",slug)} />
<link rel="alternate" hreflang="x-default" href={siteRoot} />
<link rel="icon" type="image/svg+xml" href={base+"assets/signet.svg"} />
<link rel="stylesheet" href={base+"assets/style.css?v="+cssRevision} />
<title>{title} · {t.name}</title>
<script is:inline src={base+"assets/site.js?v="+jsRevision} defer></script>
</head>
<body class:list={["vera-site",home?"vera-site--home":"vera-site--inner"]}>
<a class="skip-link" href="#inhalt">{lang==="de"?"Zum Inhalt springen":"Skip to content"}</a>
<header class="vera-header">
  <div class="container vera-header__inner">
    <a class="vera-brand" href={pathFor(lang)} aria-label={de?"Vera – Startseite":"Vera – homepage"} aria-current={home&&!root?"page":undefined}>
      <span class="brand__name">{t.name}</span>
    </a>
    {[false,true].map(compact=>{
      const Navigation=compact?"details":"div";
      return <Navigation class={compact?"vera-menu":"vera-menu-wide"} name={compact?"vera-header-panel":undefined}>
        {compact&&<summary>{t.menu}<span class="vera-menu__symbol" aria-hidden="true"></span></summary>}
        <nav class="vera-primary" aria-label={primaryLabel}>
          {primaryLinks.map(link=><a href={link.href} aria-current={link.current?"page":undefined}>{link.label}</a>)}
        </nav>
      </Navigation>;
    })}
    <SiteSearch lang={lang}/>
    <nav class="vera-languages" aria-label={de?"Sprache":"Language"}>
      <a href={pathFor("de",slug)} lang="de" hreflang="de" aria-label="Deutsch" aria-current={de?"true":undefined}>DE</a>
      <a href={pathFor("en",slug)} lang="en" hreflang="en" aria-label="English" aria-current={!de?"true":undefined}>EN</a>
    </nav>
  </div>
</header>
{!home&&<div class="edition-line"><div class="container edition-line__inner">
  <a href={pathFor(lang,"projektstatus")} data-project-version={project.version}>{t.name} / VERSION {project.version} ↗</a>
  <p class="edition-line__descriptor">{t.subtitle}</p>
  <p class="edition-line__motto">{t.motto}</p>
</div></div>}
{!de&&!home&&<div class="translation-notice"><div class="container">
  <span class="translation-notice__label">{t.status}</span>
  <a href={pathFor(lang,"projektstatus","sprachfassungen")}>Translation review ↗</a>
  <a href={pathFor("de",slug)}>Deutsch →</a>
</div></div>}
<main id="inhalt" tabindex="-1"><slot /><UniversalQuestionsContext lang={lang} slug={slug}/></main>
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__identity">
      <p class="footer__name">{t.name}</p>
      <h2>{t.footerTitle}</h2>
      <p>{t.footerDescription}</p>
      <p><a class="subtle-link" href={pathFor(lang,"mitwirken","rueckmeldung")}>{t.feedbackInvitation} <span aria-hidden="true">→</span></a></p>
      <p class="footer__ai-goal">{de?"Unser Ziel: eine Open-Source-KI mit Menschen bauen · im Aufbau.":"Our goal: build open-source AI with people · in development."} <a href={pathFor(lang,"ki-und-mensch")}>{de?"Ziel und Grenzen prüfen":"Read the goal and its limits"} ↗</a></p>
    </div>
    <nav class="footer__links" aria-label={de?"Weitere Seiten":"More pages"}>
      {footerGroups.map(group=><div><strong>{group.title}</strong>
        {group.routes.map(route=><a href={pathFor(lang,route)}>{t.titles[route]}</a>)}
        {group.title===t.project&&<a href={project.repository}>{t.source} ↗</a>}
      </div>)}
    </nav>
  </div>
  <div class="container footer__bottom">
    <div class="footer__credits"><span>{t.copyright}</span><span>{t.disclosure}</span></div>
    <div class="footer__utility">
      <a class="footer__donate" href={pathFor(lang,"mitwirken","unterstuetzen")}>{de?"Spenden":"Donate"} <span aria-hidden="true">↗</span></a>
      <a href={pathFor(lang,"impressum")}>{de?"Impressum":"Legal notice"}</a>
      <a href={pathFor(lang,"datenschutz")}>{de?"Datenschutz":"Privacy"}</a>
      <a href={project.repository+"/blob/main/LICENSING.md"} target="_blank" rel="noopener noreferrer">{de?"Lizenzdetails & Ausnahmen ↗":"License details & exceptions ↗"}</a>
    </div>
  </div>
</footer>
</body></html>
